{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Type-aware ("strict") lint pass — run via `bun run lint:typecheck`
  // (`oxlint --type-aware -c .oxlintrc.strict.json .`), and as its own CI step.
  //
  // Kept SEPARATE from .oxlintrc.json on purpose. `--type-aware` activates every
  // type-aware rule that belongs to an enabled category, and the main config runs
  // all categories at error — so reusing it would turn on the whole tsgolint
  // surface (~15k hits, incl. the rules we deliberately reject). Here every
  // category is "off" and we opt IN to exactly the Flow-soundness set: strict
  // promise tracking + no `any`-typed values flowing across boundaries.
  //
  // Deliberately NOT enabled: no-unsafe-type-assertion (~thousands of idiomatic
  // `as`/DOM casts), strict-boolean-expressions (fights the lit-html
  // `cond && html` idiom), prefer-readonly-parameter-types, etc.
  "categories": {
    "correctness": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  // `vendor` is the pinned Electrobun SDK submodule. The type-aware pass reaches it in a way it
  // never reached the Hutch projection this replaced: oxlint honours `.gitignore`, `.hutch/` is
  // gitignored, and a submodule is tracked. So the SDK's ~120 no-unsafe-* hits in `proc/native.ts`
  // (bun:ffi is `any` by nature) became visible only once the same sources sat at a tracked path.
  // See .oxlintrc.json for the same entry and the fuller note.
  "ignorePatterns": ["dist", "**/*.map", ".claude", "examples", "vendor"],
  "overrides": [
    {
      // Tests and dev scripts stub external shapes with `any` by design
      // (no-explicit-any is off for them in .oxlintrc.json). Package bin/
      // codegen scripts sit outside the tsconfig project (tsc skips them), so
      // tsgolint sees error-types for their imports. The no-unsafe-* family is
      // therefore src-only; promise safety still applies everywhere.
      //
      // A file in no program at all gets the same waiver: tsconfig.json's
      // `include` starts at packages/ and extensions/, so EVERY expression in
      // such a file types as `error`. That is not a latent bug the rule is
      // catching — there is no annotation or rewrite that fixes it, because
      // the file has no program. The root `server.js` proved it: adding
      // `exampleRoutes()` in 7fb3669a turned three ordinary lines into three
      // errors and reddened main. It now lives at `scripts/dev.ts`, under the
      // scripts glob below, and needs no entry of its own.
      //
      // The waiver is for files with no program, NOT for root-level files:
      // `commitlint.config.ts` was once listed here and left this list by
      // joining tsconfig.json's `include`, not by being exempted. A root file
      // that can be typechecked should be, and then these rules apply to it.
      "files": ["**/tests/**/*.*", "**/*.test.*", "**/scripts/**/*.*", "**/bin/**/*.*"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off"
      }
    }
  ],
  "plugins": ["typescript"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error"
  }
}
