/- kdl-version 2
$schema "./project.schema.json"
project "Jx Suite"

url "https://jxsuite.com"

defaults layout="./layouts/base.json" lang=en

images {
    optimize #true
    widths 320 640 960 1280 1920 2560
    formats avif jpeg
    quality avif=65 jpeg=80
    sizes "(max-width: 768px) 100vw, 50vw"
    lazyLoad #true
}

$head {
    link rel=icon href="/favicon.svg"
    meta name=generator content="Jx Suite"
    meta name=viewport content="width=device-width, initial-scale=1"
}

$media {
    -- "1280px"
    --lg "(max-width: 1024px)"
    --md "(max-width: 768px)"
    --sm "(max-width: 640px)"
    --dark "(prefers-color-scheme: dark)"
}

style {
    "@font-face" {
        fontFamily "'Host Grotesk'"
        fontStyle normal
        fontWeight "400 700"
        fontDisplay swap
        src "url('/fonts/host-grotesk-latin.woff2') format('woff2')"
    }
    --color-bg-primary "#f7f7f9"
    --color-bg-secondary "#eeeef2"
    --color-bg-surface "#ffffff"
    --color-bg-surface-hover "#eeeef2"
    --color-border "#c9c9d2"
    --color-border-subtle "#e1e1e7"
    --color-text-primary "#1d1d22"
    --color-text-secondary "#45454f"
    --color-text-muted "#5e5e6c"
    --color-brand "#1a1a2e"
    --color-accent "#1d4ed8"
    --color-accent-hover "#1e40af"
    --color-accent-solid "#2563eb"
    --color-accent-solid-hover "#1d4ed8"
    --color-tonal "rgba(29, 29, 34, 0.07)"
    --color-tonal-hover "rgba(29, 29, 34, 0.12)"
    --color-inverse-bg "#111114"
    --color-inverse-surface "#1d1d22"
    --color-inverse-text "#eeeef2"
    --color-inverse-muted "#a2a2af"
    --color-backdrop "rgba(247, 247, 249, 0.88)"
    --color-backdrop-strong "rgba(247, 247, 249, 0.95)"
    --color-shadow "rgba(29, 29, 34, 0.12)"
    --color-shadow-strong "rgba(29, 29, 34, 0.2)"
    --color-success "#047857"
    --color-warning "#b45309"
    --color-highlight-bg "#ffffff"
    --color-highlight-text "#1d1d22"
    --color-highlight-border "#c9c9d2"
    --font-sans "'Host Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif"
    --font-mono "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    --display-weight "500"
    --display-tracking "-0.035em"
    --radius "8px"
    --radius-lg "12px"
    --max-width "1280px"
    --gutter "clamp(1.5rem, 5.5vw, 5rem)"
    --section-top "clamp(4.5rem, 9vw, 7.5rem)"
    --section-bottom "clamp(3.5rem, 6vw, 5rem)"
    @--dark {
        --color-bg-primary "#111114"
        --color-bg-secondary "#17171b"
        --color-bg-surface "#1d1d22"
        --color-bg-surface-hover "#26262c"
        --color-border "#45454f"
        --color-border-subtle "#2f2f36"
        --color-text-primary "#eeeef2"
        --color-text-secondary "#c9c9d2"
        --color-text-muted "#a2a2af"
        --color-brand "#eeeef2"
        --color-accent "#5f95f7"
        --color-accent-hover "#93b7fa"
        --color-accent-solid "#2563eb"
        --color-accent-solid-hover "#3b82f6"
        --color-tonal "rgba(238, 238, 242, 0.1)"
        --color-tonal-hover "rgba(238, 238, 242, 0.17)"
        --color-inverse-bg "#0b0b0d"
        --color-inverse-surface "#17171b"
        --color-inverse-text "#eeeef2"
        --color-inverse-muted "#a2a2af"
        --color-backdrop "rgba(17, 17, 20, 0.86)"
        --color-backdrop-strong "rgba(17, 17, 20, 0.94)"
        --color-shadow "rgba(0, 0, 0, 0.4)"
        --color-shadow-strong "rgba(0, 0, 0, 0.5)"
        --color-success "#34d399"
        --color-warning "#fbbf24"
        --color-highlight-bg "#1d1d22"
        --color-highlight-text "#eeeef2"
        --color-highlight-border "#45454f"
    }
    :focus-visible {
        outline "2px solid var(--color-accent)"
        outlineOffset "2px"
    }
    margin "0"
    maxWidth "100vw"
    overflowX clip
    padding "0"
    fontFamily "var(--font-sans)"
    backgroundColor "var(--color-bg-primary)"
    color "var(--color-text-primary)"
    a {
        color "var(--color-accent)"
        textUnderlineOffset "0.2em"
    }
    table {
        width "100%"
        borderCollapse collapse
        fontSize "1rem"
        textAlign left
        borderTop "1px solid var(--color-border)"
        thead {
            padding "1rem 1.25rem"
            fontSize "0.875rem"
            fontWeight "500"
            color "var(--color-text-muted)"
            borderBottom "1px solid var(--color-border)"
        }
        tbody {
            tr {
                borderBottom "1px solid var(--color-border-subtle)"
                :hover {
                    backgroundColor "var(--color-bg-surface)"
                }
            }
            td {
                padding "1rem 1.25rem"
                color "var(--color-text-secondary)"
                borderLeft "1px solid var(--color-border-subtle)"
                :first-child {
                    color "var(--color-text-primary)"
                    fontWeight "600"
                    borderLeft none
                }
            }
            th {
                padding "1rem 1.25rem"
                color "var(--color-text-secondary)"
                borderLeft "1px solid var(--color-border-subtle)"
                :first-child {
                    color "var(--color-text-primary)"
                    fontWeight "600"
                    borderLeft none
                }
            }
        }
    }
}

content {
    docs {
        source "../../docs"
        format Markdown
        $elements {
            - (ref)"./components/doc-note.json"
            - (ref)"./components/doc-warning.json"
            - (ref)"./components/doc-tip.json"
        }
        schema {
            type object
            properties {
                title type=string
                description type=string
                spec {
                    type array
                    items type=string
                }
                code {
                    type array
                    items type=string
                }
                generated type=boolean
                search {
                    type boolean
                    description "false keeps the page out of search-index.json and out of nothing else; only the boolean opts out."
                }
            }
            required {
                - title
            }
        }
    }
    docsNav source="../../docs/nav.json" format=json
}

search {
    output "/search-index.json"
    collections {
        docs {
            basePath "/docs/"
            boost title=4 heading=2
        }
    }
}

redirects {
    "/docs/get-studio" "/docs/start/install/"
    "/docs/getting-started" "/docs/start/first-project/"
    "/docs/manage" "/docs/studio/projects/browse/"
    "/docs/edit" "/docs/studio/editing/"
    "/docs/design" "/docs/studio/design/"
    "/docs/logic" "/docs/studio/logic/"
    "/docs/git-publish" "/docs/studio/publish/"
    "/docs/components" "/docs/framework/concepts/components/"
    "/docs/reactivity" "/docs/framework/concepts/reactivity/"
    "/docs/styling" "/docs/framework/concepts/styling/"
    "/docs/site-architecture" "/docs/framework/site/"
    "/docs/spec" "/docs/framework/"
}

copy {
    "../../packages/schema/schema.json" "schema/v1/index.json"
    "../../packages/schema/project-schema.json" "schema/project/v1/index.json"
    "../../packages/schema/class-schema.json" "schema/class/v1/index.json"
    "../../packages/schema/schemas/document.paths.schema.json" "schema/document/paths/v2/index.json"
}

build outDir="./dist" trailingSlash=always

extensions "@jxsuite/parser" "@jxsuite/search"
