{
  "tagName": "faq-item",
  "$description": "One question and its answer, as a native details element: it opens with no script.",
  "state": {
    "question": ""
  },
  "style": {
    "display": "block",
    "borderTop": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "details",
      "children": [
        {
          "tagName": "summary",
          "style": {
            "cursor": "pointer",
            "padding": "1.25rem 0",
            "fontSize": "1.25rem",
            "fontWeight": "500",
            "letterSpacing": "-0.015em",
            "lineHeight": "1.3",
            "color": "var(--color-text-primary)",
            ":hover": {
              "color": "var(--color-accent)"
            }
          },
          "textContent": "${state.question}"
        },
        {
          "tagName": "div",
          "style": {
            "padding": "0 0 1.5rem",
            "maxWidth": "62ch",
            "fontSize": "1rem",
            "lineHeight": "1.6",
            "color": "var(--color-text-secondary)",
            "& p": {
              "margin": "0 0 0.75rem"
            },
            "& a": {
              "color": "var(--color-accent)"
            }
          },
          "children": [
            {
              "tagName": "slot"
            }
          ]
        }
      ]
    }
  ]
}
