{
  "tagName": "site-toolbar",
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "100",
    "backgroundColor": "var(--color-bg-primary)",
    "borderBottom": "1px solid var(--color-border-subtle)",
    "padding": "0 var(--gutter)"
  },
  "children": [
    {
      "tagName": "nav",
      "attributes": {
        "aria-label": "Main"
      },
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "1fr auto 1fr",
        "alignItems": "center",
        "height": "4rem",
        "@--lg": {
          "gridTemplateColumns": "auto 1fr"
        }
      },
      "children": [
        {
          "tagName": "a",
          "attributes": {
            "href": "/",
            "aria-label": "Jx Suite home"
          },
          "style": {
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "fontWeight": "600",
            "fontSize": "1.0625rem",
            "letterSpacing": "-0.02em",
            "display": "inline-flex",
            "alignItems": "center",
            "gap": "0.5rem",
            "minHeight": "2.75rem",
            "justifySelf": "start"
          },
          "children": [
            {
              "tagName": "img",
              "attributes": {
                "src": "/favicon.svg",
                "alt": "",
                "width": "22",
                "height": "22"
              }
            },
            "Jx Suite"
          ]
        },
        {
          "$title": "Toolbar Words",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "clamp(1.25rem, 2.2vw, 2rem)",
            "@--lg": {
              "display": "none"
            }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": {
                "href": "/studio"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "color": "var(--color-text-secondary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "400",
                "textUnderlineOffset": "0.3em",
                "transition": "color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "textDecoration": "underline"
                }
              },
              "children": ["Studio"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/cloud"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "color": "var(--color-text-secondary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "400",
                "textUnderlineOffset": "0.3em",
                "transition": "color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "textDecoration": "underline"
                }
              },
              "children": ["Jx Cloud"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/framework"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "color": "var(--color-text-secondary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "400",
                "textUnderlineOffset": "0.3em",
                "transition": "color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "textDecoration": "underline"
                }
              },
              "children": ["Framework"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/templates"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "color": "var(--color-text-secondary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "400",
                "textUnderlineOffset": "0.3em",
                "transition": "color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "textDecoration": "underline"
                }
              },
              "children": ["Templates"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/docs/start/first-project"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "color": "var(--color-text-secondary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "400",
                "textUnderlineOffset": "0.3em",
                "transition": "color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "textDecoration": "underline"
                }
              },
              "children": ["Docs"]
            }
          ]
        },
        {
          "$title": "Toolbar End",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "justifySelf": "end",
            "gap": "clamp(0.5rem, 1.2vw, 1rem)"
          },
          "children": [
            {
              "tagName": "site-search"
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "@--lg": {
                  "display": "none"
                }
              },
              "children": [
                {
                  "tagName": "theme-toggle"
                }
              ]
            },
            {
              "$title": "Main Action",
              "tagName": "a",
              "attributes": {
                "href": "https://studio.jxsuite.com/"
              },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "minHeight": "2.75rem",
                "boxSizing": "border-box",
                "padding": "0 1.25rem",
                "backgroundColor": "var(--color-accent-solid)",
                "color": "#ffffff",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderRadius": "var(--radius)",
                "whiteSpace": "nowrap",
                "transition": "background-color 0.15s, transform 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-accent-solid-hover)",
                  "transform": "translateY(-1px)"
                },
                ":active": {
                  "transform": "translateY(1px)"
                },
                "@--sm": {
                  "display": "none"
                },
                "@(prefers-reduced-motion: reduce)": {
                  "transition": "none",
                  ":hover": {
                    "transform": "none"
                  },
                  ":active": {
                    "transform": "none"
                  }
                }
              },
              "children": ["Start a free trial"]
            },
            {
              "$title": "Hamburger Button",
              "tagName": "button",
              "attributes": {
                "popovertarget": "site-mobile-menu",
                "aria-label": "Open menu"
              },
              "style": {
                "display": "none",
                "flexDirection": "column",
                "justifyContent": "space-between",
                "width": "44px",
                "height": "44px",
                "background": "none",
                "border": "none",
                "cursor": "pointer",
                "padding": "12px 8px",
                "@--lg": {
                  "display": "flex"
                },
                "boxSizing": "border-box"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                },
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                },
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                }
              ]
            }
          ]
        },
        {
          "$title": "Mobile Menu Popover",
          "tagName": "nav",
          "id": "site-mobile-menu",
          "attributes": {
            "popover": "auto",
            "aria-label": "Site menu"
          },
          "style": {
            "inset": "0 0 0 auto",
            "width": "min(300px, 80vw)",
            "height": "100vh",
            "backgroundColor": "var(--color-bg-primary)",
            "borderLeft": "1px solid var(--color-border)",
            "border": "none",
            "margin": "0",
            "padding": "4.5rem 0 2rem",
            "boxShadow": "-8px 0 24px var(--color-shadow)",
            "flexDirection": "column",
            "transform": "translateX(100%)",
            "transition": "transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), display 0.3s allow-discrete, overlay 0.3s allow-discrete",
            ":popover-open": {
              "display": "flex",
              "transform": "translateX(0)"
            },
            "::backdrop": {
              "backgroundColor": "rgba(0, 0, 0, 0.5)",
              "opacity": "0",
              "transition": "opacity 0.3s ease, display 0.3s allow-discrete, overlay 0.3s allow-discrete"
            },
            "&:popover-open::backdrop": {
              "opacity": "1"
            },
            "@starting-style": {
              ":popover-open": {
                "transform": "translateX(100%)"
              },
              "&:popover-open::backdrop": {
                "opacity": "0"
              }
            },
            "@(prefers-reduced-motion: reduce)": {
              "transition": "none",
              "transform": "none",
              ":popover-open": {
                "transform": "none"
              },
              "::backdrop": {
                "transition": "none"
              }
            }
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "justifyContent": "flex-end",
                "padding": "0 1.25rem 0.5rem"
              },
              "children": [
                {
                  "tagName": "button",
                  "attributes": {
                    "popovertarget": "site-mobile-menu",
                    "popovertargetaction": "hide",
                    "aria-label": "Close menu"
                  },
                  "style": {
                    "background": "none",
                    "border": "none",
                    "cursor": "pointer",
                    "padding": "0.5rem",
                    "fontSize": "1.25rem",
                    "lineHeight": "1",
                    "color": "var(--color-text-secondary)"
                  },
                  "textContent": "✕"
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/studio"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Studio"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/cloud"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Jx Cloud"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/framework"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Framework"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/templates"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Templates"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/docs/start/first-project"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Docs"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/compare"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Compare"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "https://github.com/jxsuite/jx",
                "target": "_blank",
                "rel": "noopener noreferrer"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1.0625rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["GitHub"]
            },
            {
              "$title": "Mobile Scheme Row",
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "space-between",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": [
                "Color scheme",
                {
                  "tagName": "theme-toggle"
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "paddingTop": "0.5rem"
              },
              "children": [
                {
                  "tagName": "a",
                  "attributes": {
                    "href": "https://studio.jxsuite.com/"
                  },
                  "style": {
                    "display": "flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "minHeight": "2.75rem",
                    "margin": "0.75rem 1.5rem 0",
                    "padding": "0 1.5rem",
                    "backgroundColor": "var(--color-accent-solid)",
                    "color": "#ffffff",
                    "textDecoration": "none",
                    "fontSize": "1rem",
                    "fontWeight": "500",
                    "borderRadius": "var(--radius)"
                  },
                  "children": ["Start a free trial"]
                },
                {
                  "tagName": "a",
                  "attributes": {
                    "href": "/download"
                  },
                  "style": {
                    "display": "flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "minHeight": "2.75rem",
                    "margin": "0.75rem 1.5rem 0",
                    "padding": "0 1.5rem",
                    "backgroundColor": "var(--color-tonal)",
                    "color": "var(--color-text-primary)",
                    "textDecoration": "none",
                    "fontSize": "1rem",
                    "fontWeight": "500",
                    "borderRadius": "var(--radius)"
                  },
                  "children": ["Download Studio"]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
