{
  "tagName": "fact-item",
  "$description": "A short titled statement: the unit of every list and column on the marketing pages.",
  "state": {
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "borderTop": "1px solid var(--color-border)",
    "paddingTop": "1.25rem"
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontWeight": "var(--display-weight)",
        "letterSpacing": "-0.015em",
        "color": "var(--color-text-primary)",
        "margin": "0",
        "textWrap": "balance",
        "fontSize": "1.25rem",
        "lineHeight": "1.3"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0.5rem 0 0",
        "fontSize": "1rem",
        "lineHeight": "1.6",
        "color": "var(--color-text-secondary)",
        "maxWidth": "46ch"
      },
      "textContent": "${state.text}"
    },
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "flexWrap": "wrap",
        "gap": "0.75rem",
        "marginTop": "1.25rem",
        ":empty": {
          "display": "none"
        }
      },
      "children": [
        {
          "tagName": "slot"
        }
      ]
    }
  ]
}
