{
  "tagName": "mode-card",
  "$description": "One Studio workspace: its screenshot, its name and what you do there.",
  "state": {
    "name": "Mode",
    "description": "Description",
    "image": "",
    "imageAlt": ""
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "borderRadius": "var(--radius-lg)",
    "border": "1px solid var(--color-border-subtle)",
    "backgroundColor": "var(--color-bg-surface)",
    "overflow": "hidden"
  },
  "children": [
    {
      "tagName": "img",
      "attributes": {
        "src": "${state.image}",
        "alt": "${state.imageAlt}",
        "width": "3840",
        "height": "2000",
        "loading": "lazy",
        "decoding": "async"
      },
      "style": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "borderBottom": "1px solid var(--color-border-subtle)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "padding": "clamp(1.25rem, 2.5vw, 2rem)"
      },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontWeight": "var(--display-weight)",
            "letterSpacing": "-0.015em",
            "color": "var(--color-text-primary)",
            "margin": "0",
            "textWrap": "balance",
            "fontSize": "1.25rem",
            "lineHeight": "1.3"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0.5rem 0 0",
            "fontSize": "1rem",
            "lineHeight": "1.6",
            "color": "var(--color-text-secondary)"
          },
          "textContent": "${state.description}"
        }
      ]
    }
  ]
}
