.cache/
.devenv
.direnv
.DS_Store
.env
.npmrc
.obsidian/
*.local
codecov-debug.mjs
coverage/
dist/
tmp/
# The metafile lane's own output. It writes an UNSPLIT bundle, which used to land on dist/ and
# overwrite the release build's studio.js at the same path.
dist-metafile/
junit.xml
metafile.json
node_modules/
result

# Windows reserved device names (confuse git's directory walker)
nul

# Chromium profile (desktop chromium mode)
.jx/
packages/desktop/.jx/

# Perf-trace captures and their dumps — regenerate with `bun run perf:studio`
scripts/perf/out/

# Compiler-generated component sidecars — built into dist/, never committed to source
sites/*/components/*.js

# Starter templates are not installed projects — a stray `bun install` (e.g. opening one in Studio)
# drops a lockfile we don't track here. (node_modules/dist/.cache are already ignored above.)
packages/starters/sites/*/bun.lock

# Derived documentation pages — build outputs, never source. `bun run docs:generate` writes them
# (postinstall, the docs gates and the site build all run it); nothing reads them from git. They
# were committed once, and every spec release touched the same nine files, so any two open pull
# requests that released a spec conflicted on implementation-status.md and spec-changelog.md by
# construction. The generators are pure functions of the tree, so a checkout can always remake them.
docs/extending/reference/implementation-status.md
docs/extending/reference/spec-changelog.md
docs/extending/reference/standards.md
docs/extending/reference/studio-routes.md
docs/framework/reference/formulas.md
docs/framework/reference/operators.md
docs/studio/interface/commands.md
docs/studio/interface/shortcuts.md
docs/studio/projects/starters.md

# Scratch directories the test suites build beside their own test files (`_fixtures_*`, `_*_fixtures`,
# `__test-*__`, `__tmp_*__`, ...). A test writes one in `beforeAll` or at module top and removes it
# afterwards, so a run that dies in between (a crashed harness, a killed `bun test`) leaves it behind
# for a `git add -A` to pick up. That already happened once: `git-new-endpoints.test.ts` builds a git
# repository there, and the leftover was committed as a GITLINK with no `.gitmodules` entry, so every
# CI job's checkout cleanup warned "No url found for submodule path", and every local run of the
# server suite deleted a tracked path.
#
# The rule is the `_` prefix, not a list of names, so a new test that follows the convention is
# covered without anyone remembering to edit this file. Directories only (the trailing slash), which
# keeps the `_`-prefixed helper FILES beside them (`_fake-electron.ts`, `_rpc-server.ts`) trackable.
**/tests/_*/

# The one `_`-prefixed directory under `tests/` that is hand-authored input, not output: no test
# writes its project, pages or content. Any other committed fixture directory needs an exception
# here, because `git add -A` skips an ignored path without a word.
!packages/desktop/tests/_fixtures_content/
# What `content-collection.test.ts` generates inside it and removes in a `finally`.
packages/desktop/tests/_fixtures_content/*.schema.json

# Session plans a Claude Code run writes for itself. Program plans live in plans/ (plans/README.md),
# where `bun run plans:check` can see them; six of these were once committed and went stale unseen.
.claude/plans/

# Claude local settings (should be set per user, not committed).
.claude/settings.local.json

# The Nix app tree build-snap.yml stages for packages/desktop/snap/snapcraft.yaml, and its output.
packages/desktop/snap-stage/
packages/desktop/*.snap
packages/desktop/build-resources/embedded.provisionprofile

# A local checkout of a third-party tree (vendor/electrobun once landed on main as an orphan gitlink
# with no .gitmodules entry, and every actions/checkout cleanup then failed on it).
/vendor/
