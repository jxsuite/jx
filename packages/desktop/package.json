{
  "name": "@jxsuite/desktop",
  "version": "8.0.0",
  "description": "Jx Studio — standalone desktop application built with Electron",
  "license": "MIT",
  "author": "Avunu LLC <support@jxsuite.com> (https://jxsuite.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "scripts": {
    "electron": "bun run scripts/pre-build-rpc.ts && bun run scripts/run-electron-app.ts",
    "dev": "bun run electron",
    "stage": "bun run scripts/stage-app.ts",
    "package": "bun run scripts/package-app.ts",
    "smoke": "bun run scripts/smoke-backend.ts",
    "sign:cert": "bun run scripts/sign-cert.ts",
    "sign:trust": "powershell -ExecutionPolicy Bypass -File scripts/trust-cert.ps1",
    "upgrade": "bun update --latest && bun install",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jxsuite/compiler": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/server": "workspace:^",
    "@jxsuite/starters": "workspace:^",
    "@jxsuite/studio": "workspace:^",
    "env-paths": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@jxsuite/server": "workspace:^",
    "@jxsuite/test-support": "workspace:^",
    "@jxsuite/ui": "workspace:^",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11"
  }
}
