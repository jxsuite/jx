{
  "name": "@jxsuite/desktop",
  "version": "5.4.6",
  "description": "Jx Studio — standalone desktop application built with Electrobun",
  "license": "MIT",
  "author": "Avunu LLC <support@jxsuite.com> (https://jxsuite.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "scripts": {
    "build": "electrobun build",
    "build:msix": "electrobun build --env=stable && bun run scripts/build-msix.ts",
    "build:release": "electrobun build --env=canary",
    "build:stable": "electrobun build --env=stable && bun run scripts/build-msi.ts",
    "chromium": "bun run scripts/pre-build-rpc.ts && bun run src/chromium/index.ts",
    "dev": "electrobun dev",
    "sync": "electrobun prepare",
    "sign:cert": "bun run scripts/sign-cert.ts",
    "sign:trust": "powershell -ExecutionPolicy Bypass -File scripts/trust-cert.ps1",
    "upgrade": "bun update --latest && bun install",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jxsuite/auth": "workspace:^",
    "@jxsuite/compiler": "workspace:^",
    "@jxsuite/connector": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/feed": "workspace:^",
    "@jxsuite/parser": "workspace:^",
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/search": "workspace:^",
    "@jxsuite/server": "workspace:^",
    "@jxsuite/starters": "workspace:^",
    "@jxsuite/studio": "workspace:^",
    "dbus-ts": "^0.0.7",
    "env-paths": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@jxsuite/server": "workspace:^",
    "@jxsuite/ui": "workspace:^",
    "electrobun": "2.0.2",
    "rcedit": "^5.0.2"
  }
}
