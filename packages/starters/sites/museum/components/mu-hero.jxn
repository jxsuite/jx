/- kdl-version 2

mu-hero {
    state {
        kicker ""
        title ""
        standfirst ""
        primaryLabel ""
        primaryHref "/visit/"
        secondaryLabel ""
        secondaryHref "/exhibitions/"
        noteLabel ""
        note ""
    }
    style {
        display block
        backgroundColor "var(--color-card)"
        paddingBlock "clamp(2.75rem, 7vw, 5.5rem)"
        paddingInline "var(--gutter)"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            marginInline auto
            display grid
            gridTemplateColumns "minmax(0, 1.4fr) minmax(0, 0.85fr)"
            columnGap "clamp(2rem, 5vw, 4.5rem)"
            alignItems center
            @--md gridTemplateColumns="minmax(0, 1fr)" rowGap="2.75rem"
        }
        div {
            p "${state.kicker}" {
                style {
                    margin "0 0 1.4rem"
                    fontFamily "var(--font-label)"
                    fontSize "0.68rem"
                    letterSpacing "var(--label-tracking)"
                    textTransform "var(--label-case)"
                    color "var(--color-pigment)"
                }
            }
            h1 "${state.title}" {
                style {
                    margin "0"
                    fontFamily "var(--font-display)"
                    fontSize "clamp(2.7rem, 7vw, 5.2rem)"
                    fontWeight "700"
                    lineHeight "calc(0.95 * var(--leading-scale))"
                    letterSpacing "var(--display-tracking)"
                    maxWidth "14ch"
                }
            }
            p "${state.standfirst}" {
                style {
                    margin "1.6rem 0 0"
                    fontSize "1.16rem"
                    lineHeight "1.65"
                    color "var(--color-muted)"
                    maxWidth "46ch"
                }
            }
            div {
                style {
                    display flex
                    flexWrap wrap
                    gap "0.9rem"
                    marginBlockStart "2.25rem"
                    fontFamily "var(--font-label)"
                    fontSize "0.72rem"
                    letterSpacing "var(--label-tracking)"
                    textTransform "var(--label-case)"
                }
                a href="${state.primaryHref}" "${state.primaryLabel}" {
                    style {
                        display inline-block
                        padding "0.95rem 1.7rem"
                        border "2px solid var(--color-ink)"
                        backgroundColor "var(--color-ink)"
                        color "var(--color-chalk)"
                        textDecoration none
                        transition "background-color 0.15s, border-color 0.15s"
                        :hover {
                            backgroundColor "var(--color-pigment)"
                            borderColor "var(--color-pigment)"
                        }
                    }
                }
                a href="${state.secondaryHref}" "${state.secondaryLabel}" {
                    style {
                        display inline-block
                        padding "0.95rem 1.7rem"
                        border "2px solid var(--color-ink)"
                        backgroundColor transparent
                        color "var(--color-ink)"
                        textDecoration none
                        transition "background-color 0.15s, color 0.15s"
                        :hover backgroundColor="var(--color-ink)" color="var(--color-chalk)"
                    }
                }
            }
            p {
                style {
                    display "${state.note ? 'flex' : 'none'}"
                    flexWrap wrap
                    gap "0.75rem"
                    margin "2.25rem 0 0"
                    paddingBlockStart "1.1rem"
                    borderBlockStart "1px solid var(--color-hairline)"
                    fontFamily "var(--font-label)"
                    fontSize "0.68rem"
                    letterSpacing "var(--label-tracking)"
                    textTransform "var(--label-case)"
                    color "var(--color-muted)"
                }
                span "${state.noteLabel}" {
                    style color="var(--color-pigment)"
                }
                span "${state.note}"
            }
        }
        div aria-hidden="true" {
            style {
                border "2px solid var(--color-ink)"
                backgroundColor "var(--color-chalk)"
                padding "clamp(0.9rem, 2.5vw, 1.75rem)"
                display grid
                gap "clamp(0.7rem, 2vw, 1.1rem)"
                maxWidth "23rem"
                marginInline auto
                width "100%"
                boxSizing border-box
            }
            div {
                style {
                    aspectRatio "1"
                    borderRadius "50%"
                    display grid
                    placeItems center
                    background "conic-gradient(from -90deg, var(--color-pigment) 0 25%, var(--color-pigment-deep) 25% 50%, var(--color-chalk-deep) 50% 75%, var(--color-card) 75% 100%)"
                }
                div {
                    style {
                        width "38%"
                        aspectRatio "1"
                        borderRadius "50%"
                        backgroundColor "var(--color-card)"
                        border "2px solid var(--color-ink)"
                    }
                }
            }
            div {
                style display=grid gap="0.4rem"
                div {
                    style height="3px" backgroundColor="var(--color-ink)"
                }
                div {
                    style height="1px" backgroundColor="var(--color-hairline)"
                }
                div {
                    style height="1px" width="62%" backgroundColor="var(--color-hairline)"
                }
            }
        }
    }
}
