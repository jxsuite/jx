/- kdl-version 2

shp-footer {
    state {
        brand "Cadence Cycles"
        tagline "Bikes, gear, and expert service for every rider on your street. On the corner of Spoke & 4th since 2009."
        address "412 Spoke Avenue, Riverbend"
        phone "(555) 042-7100"
    }
    style {
        display block
        backgroundColor "var(--color-bg-dark)"
        color "var(--color-text-white)"
        padding "clamp(3rem, 6vw, 4.5rem) 1.5rem 2rem"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "1.6fr 1fr 1fr 1fr"
            gap "2.5rem"
            @--md gridTemplateColumns="1fr 1fr"
            @--sm gridTemplateColumns="1fr"
        }
        div {
            a href="/" {
                style {
                    display inline-flex
                    alignItems center
                    gap "0.6rem"
                    textDecoration none
                    marginBottom "1rem"
                }
                span ◎ {
                    style {
                        display inline-flex
                        alignItems center
                        justifyContent center
                        width "2rem"
                        height "2rem"
                        borderRadius "0.55rem"
                        background "linear-gradient(150deg, var(--color-brand-bright), var(--color-primary))"
                        color "var(--color-text-white)"
                        fontSize "1.1rem"
                        fontWeight "800"
                    }
                }
                span "${state.brand}" {
                    style {
                        fontFamily "var(--font-heading)"
                        fontSize "1.3rem"
                        fontWeight "800"
                        letterSpacing "-0.02em"
                        color "var(--color-text-white)"
                    }
                }
            }
            p "${state.tagline}" {
                style {
                    margin "0 0 1.25rem"
                    color "rgba(255,255,255,0.62)"
                    maxWidth "34ch"
                    lineHeight "1.6"
                }
            }
            div {
                style display=flex gap="0.5rem"
                span 📷 {
                    style {
                        display inline-flex
                        alignItems center
                        justifyContent center
                        width "2.1rem"
                        height "2.1rem"
                        borderRadius "999px"
                        backgroundColor "rgba(255,255,255,0.08)"
                        fontSize "0.95rem"
                    }
                }
                span 🐦 {
                    style {
                        display inline-flex
                        alignItems center
                        justifyContent center
                        width "2.1rem"
                        height "2.1rem"
                        borderRadius "999px"
                        backgroundColor "rgba(255,255,255,0.08)"
                        fontSize "0.95rem"
                    }
                }
                span ▶ {
                    style {
                        display inline-flex
                        alignItems center
                        justifyContent center
                        width "2.1rem"
                        height "2.1rem"
                        borderRadius "999px"
                        backgroundColor "rgba(255,255,255,0.08)"
                        fontSize "0.95rem"
                    }
                }
            }
        }
        div {
            div Shop {
                style {
                    textTransform uppercase
                    letterSpacing "0.1em"
                    fontSize "0.72rem"
                    fontWeight "700"
                    color "rgba(255,255,255,0.5)"
                    marginBottom "0.9rem"
                }
            }
            a href="/products/" "Road bikes" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/products/" "Mountain bikes" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/products/" "Gravel & adventure" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/products/" "Kids' bikes" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/products/" "Gear & accessories" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
        }
        div {
            div Help {
                style {
                    textTransform uppercase
                    letterSpacing "0.1em"
                    fontSize "0.72rem"
                    fontWeight "700"
                    color "rgba(255,255,255,0.5)"
                    marginBottom "0.9rem"
                }
            }
            a href="/about/" "Our story" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/contact/" "Book a service" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/contact/" "Shipping & returns" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    marginBottom "0.55rem"
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
            a href="/contact/" "Contact us" {
                style {
                    display block
                    color "rgba(255,255,255,0.82)"
                    textDecoration none
                    transition "color 0.15s"
                    :hover color="var(--color-brand-bright)"
                }
            }
        }
        div {
            div Visit {
                style {
                    textTransform uppercase
                    letterSpacing "0.1em"
                    fontSize "0.72rem"
                    fontWeight "700"
                    color "rgba(255,255,255,0.5)"
                    marginBottom "0.9rem"
                }
            }
            p "${state.address}" {
                style margin="0 0 0.4rem" color="rgba(255,255,255,0.82)" lineHeight="1.5"
            }
            a href=tel:+15550427100 "${state.phone}" {
                style {
                    display block
                    color "var(--color-brand-bright)"
                    textDecoration none
                    fontWeight "700"
                    marginBottom "0.75rem"
                    fontVariantNumeric tabular-nums
                }
            }
            p "Mon–Fri 9–6:30 · Sat 9–5 · Sun 10–4" {
                style margin="0" color="rgba(255,255,255,0.6)" fontSize="0.9rem" lineHeight="1.5"
            }
        }
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "2.5rem auto 0"
            paddingTop "1.5rem"
            borderTop "1px solid rgba(255,255,255,0.12)"
            display flex
            alignItems center
            justifyContent space-between
            gap "1rem"
            flexWrap wrap
        }
        p "© 2026 Cadence Cycles. Built with Jx." {
            style margin="0" fontSize="0.85rem" color="rgba(255,255,255,0.5)"
        }
        div {
            style display=flex gap="0.5rem" flexWrap=wrap
            span VISA {
                style {
                    padding "0.3rem 0.7rem"
                    borderRadius "0.4rem"
                    backgroundColor "rgba(255,255,255,0.08)"
                    fontSize "0.72rem"
                    fontWeight "700"
                    letterSpacing "0.03em"
                    color "rgba(255,255,255,0.7)"
                }
            }
            span MASTERCARD {
                style {
                    padding "0.3rem 0.7rem"
                    borderRadius "0.4rem"
                    backgroundColor "rgba(255,255,255,0.08)"
                    fontSize "0.72rem"
                    fontWeight "700"
                    letterSpacing "0.03em"
                    color "rgba(255,255,255,0.7)"
                }
            }
            span AMEX {
                style {
                    padding "0.3rem 0.7rem"
                    borderRadius "0.4rem"
                    backgroundColor "rgba(255,255,255,0.08)"
                    fontSize "0.72rem"
                    fontWeight "700"
                    letterSpacing "0.03em"
                    color "rgba(255,255,255,0.7)"
                }
            }
            span "APPLE PAY" {
                style {
                    padding "0.3rem 0.7rem"
                    borderRadius "0.4rem"
                    backgroundColor "rgba(255,255,255,0.08)"
                    fontSize "0.72rem"
                    fontWeight "700"
                    letterSpacing "0.03em"
                    color "rgba(255,255,255,0.7)"
                }
            }
        }
    }
}
