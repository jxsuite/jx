/- kdl-version 2

shp-product-filter {
    state {
        category all
        (fn)visibleCount "return ({ all: 8, Road: 2, Mountain: 2, Gravel: 1, Kids: 1, Accessories: 2 })[state.category];"
        setAll {
            $expression operator="=" target=(ref)"#/state/category" value=all
        }
        setRoad {
            $expression operator="=" target=(ref)"#/state/category" value=Road
        }
        setMountain {
            $expression operator="=" target=(ref)"#/state/category" value=Mountain
        }
        setGravel {
            $expression operator="=" target=(ref)"#/state/category" value=Gravel
        }
        setKids {
            $expression operator="=" target=(ref)"#/state/category" value=Kids
        }
        setAccessories {
            $expression operator="=" target=(ref)"#/state/category" value=Accessories
        }
    }
    style display=block minWidth="0"
    $element "style" #"${state.category === 'all' ? '' : '#shop-grid > shp-product-card[data-category]{display:none} #shop-grid > shp-product-card[data-category="' + state.category + '"]{display:block}'}"#
    aside {
        style {
            position sticky
            top "7rem"
            backgroundColor "var(--color-bg-white)"
            border "1px solid var(--color-border)"
            borderRadius "var(--radius-lg)"
            boxShadow "var(--shadow-card)"
            padding "1.4rem"
            @--md position=static
        }
        div {
            style {
                display flex
                alignItems center
                justifyContent space-between
                paddingBottom "1rem"
                marginBottom "1.1rem"
                borderBottom "1px solid var(--color-border)"
            }
            div {
                style {
                    display inline-flex
                    alignItems center
                    gap "0.5rem"
                    fontFamily "var(--font-heading)"
                    fontWeight "800"
                    fontSize "1.05rem"
                    letterSpacing "-0.01em"
                }
                span ⚑ {
                    style color="var(--color-primary)"
                }
                span Filter
            }
            span {
                style {
                    display inline-flex
                    alignItems center
                    gap "0.35rem"
                    padding "0.28rem 0.65rem"
                    borderRadius "999px"
                    backgroundColor "var(--color-brand-tint)"
                    color "var(--color-primary)"
                    fontWeight "800"
                    fontSize "0.8rem"
                    fontVariantNumeric tabular-nums
                }
                span "${state.visibleCount}"
                span "of 8" {
                    style fontWeight="600" color="var(--color-text-muted)"
                }
            }
        }
        div Category {
            style {
                textTransform uppercase
                letterSpacing "0.1em"
                fontSize "0.7rem"
                fontWeight "700"
                color "var(--color-text-muted)"
                marginBottom "0.75rem"
            }
        }
        div {
            style display=grid gap="0.4rem"
            button onclick=(ref)"#/state/setAll" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'all' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'all' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'all' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span "All bikes & gear"
                span "8" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
            button onclick=(ref)"#/state/setRoad" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'Road' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'Road' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'Road' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span Road
                span "2" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
            button onclick=(ref)"#/state/setMountain" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'Mountain' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'Mountain' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'Mountain' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span Mountain
                span "2" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
            button onclick=(ref)"#/state/setGravel" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'Gravel' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'Gravel' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'Gravel' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span Gravel
                span "1" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
            button onclick=(ref)"#/state/setKids" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'Kids' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'Kids' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'Kids' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span Kids
                span "1" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
            button onclick=(ref)"#/state/setAccessories" {
                style {
                    display flex
                    alignItems center
                    justifyContent space-between
                    gap "0.5rem"
                    width "100%"
                    padding "0.6rem 0.85rem"
                    borderRadius "var(--radius-sm)"
                    border "1px solid ${state.category === 'Accessories' ? 'var(--color-primary)' : 'var(--color-border)'}"
                    cursor pointer
                    fontFamily inherit
                    fontWeight "700"
                    fontSize "0.92rem"
                    textAlign left
                    transition "background-color 0.15s, color 0.15s, border-color 0.15s"
                    backgroundColor "${state.category === 'Accessories' ? 'var(--color-primary)' : 'var(--color-bg-white)'}"
                    color "${state.category === 'Accessories' ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
                }
                span Accessories
                span "2" {
                    style fontVariantNumeric=tabular-nums opacity="0.7" fontWeight="600"
                }
            }
        }
        div {
            style {
                marginTop "1.3rem"
                padding "0.9rem 1rem"
                borderRadius "var(--radius-sm)"
                backgroundColor "var(--color-bg-cream)"
                display flex
                alignItems center
                gap "0.6rem"
            }
            span 🔧 {
                style fontSize="1.1rem"
            }
            p "Every bike ships fitted with a free first tune-up." {
                style {
                    margin "0"
                    fontSize "0.8rem"
                    lineHeight "1.45"
                    color "var(--color-text-secondary)"
                    fontWeight "500"
                }
            }
        }
    }
}
