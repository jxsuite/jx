/- kdl-version 2
$paths contentType=product param=sku field=sku
$head {
    meta name=description content="${state.product.data.title} — shop this ${state.product.data.category} bike at Cadence Cycles. Fitted in-store with a free first tune-up, free shipping, and 30-day returns."
}

$element .title="${state.product.data.title} — Cadence Cycles" {
    state {
        product {
            $prototype ContentEntry
            contentType product
            field sku
            id (ref)"#/$params/sku"
            $src "@jxsuite/parser/ContentEntry.class.json"
        }
    }
    article {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            padding "clamp(1.5rem, 4vw, 2.5rem) 1.5rem clamp(3rem, 6vw, 4.5rem)"
        }
        div {
            style {
                display flex
                alignItems center
                gap "0.5rem"
                fontSize "0.85rem"
                fontWeight "600"
                color "var(--color-text-muted)"
                marginBottom "1.75rem"
                flexWrap wrap
            }
            a href="/" Home {
                style color="var(--color-text-muted)" textDecoration=none {
                    :hover color="var(--color-primary)"
                }
            }
            span "/" {
                style opacity="0.5"
            }
            a href="/products/" Shop {
                style color="var(--color-text-muted)" textDecoration=none {
                    :hover color="var(--color-primary)"
                }
            }
            span "/" {
                style opacity="0.5"
            }
            span "${state.product.data.category}" {
                style color="var(--color-text-primary)"
            }
        }
        div {
            style {
                display grid
                gridTemplateColumns "1.05fr 0.95fr"
                gap "clamp(1.75rem, 4vw, 3.25rem)"
                alignItems start
                @--md gridTemplateColumns="1fr"
            }
            div {
                div {
                    style {
                        position relative
                        aspectRatio "1 / 1"
                        borderRadius "var(--radius-lg)"
                        overflow hidden
                        backgroundColor "var(--color-panel)"
                        border "1px solid var(--color-border)"
                        boxShadow "var(--shadow-card)"
                    }
                    img src="${state.product.data.image}" alt="${state.product.data.title}" loading=eager {
                        style {
                            position absolute
                            inset "0"
                            width "100%"
                            height "100%"
                            objectFit cover
                            display block
                        }
                    }
                    span "${state.product.data.badge}" {
                        style {
                            display "${state.product.data.badge ? 'inline-flex' : 'none'}"
                            position absolute
                            top "1rem"
                            left "1rem"
                            alignItems center
                            padding "0.35rem 0.8rem"
                            borderRadius "999px"
                            fontSize "0.72rem"
                            fontWeight "800"
                            textTransform uppercase
                            letterSpacing "0.06em"
                            color "var(--color-text-white)"
                            backgroundColor "${state.product.data.badge === 'Sale' ? 'var(--color-sale)' : (state.product.data.badge === 'New' ? 'var(--color-primary)' : 'var(--color-gold)')}"
                            boxShadow "0 8px 18px -8px rgba(13,17,23,0.5)"
                        }
                    }
                }
                div {
                    style {
                        display grid
                        gridTemplateColumns "repeat(3, 1fr)"
                        gap "0.6rem"
                        marginTop "0.85rem"
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.5rem"
                            padding "0.7rem 0.75rem"
                            borderRadius "var(--radius-sm)"
                            backgroundColor "var(--color-bg-cream)"
                            fontSize "0.8rem"
                            fontWeight "600"
                            color "var(--color-text-secondary)"
                        }
                        span 🔧 {
                            style color="var(--color-primary)"
                        }
                        span "Fitted free"
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.5rem"
                            padding "0.7rem 0.75rem"
                            borderRadius "var(--radius-sm)"
                            backgroundColor "var(--color-bg-cream)"
                            fontSize "0.8rem"
                            fontWeight "600"
                            color "var(--color-text-secondary)"
                        }
                        span 🚚 {
                            style color="var(--color-primary)"
                        }
                        span "Ships fast"
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.5rem"
                            padding "0.7rem 0.75rem"
                            borderRadius "var(--radius-sm)"
                            backgroundColor "var(--color-bg-cream)"
                            fontSize "0.8rem"
                            fontWeight "600"
                            color "var(--color-text-secondary)"
                        }
                        span ↩ {
                            style color="var(--color-primary)"
                        }
                        span "30-day returns"
                    }
                }
            }
            div {
                div "${state.product.data.category}" {
                    style {
                        fontSize "0.72rem"
                        fontWeight "700"
                        textTransform uppercase
                        letterSpacing "0.12em"
                        color "var(--color-primary)"
                    }
                }
                h1 "${state.product.data.title}" {
                    style {
                        fontFamily "var(--font-heading)"
                        fontSize "clamp(2rem, 4.5vw, 3rem)"
                        fontWeight "800"
                        lineHeight "1.04"
                        letterSpacing "-0.03em"
                        margin "0.6rem 0 0.75rem"
                    }
                }
                div {
                    style {
                        display flex
                        alignItems center
                        gap "0.5rem"
                        marginBottom "1.35rem"
                        fontSize "0.9rem"
                    }
                    span ★★★★★ {
                        style color="var(--color-accent)" letterSpacing="0.08em"
                    }
                    span "4.9 · 128 reviews" {
                        style color="var(--color-text-muted)" fontWeight="600"
                    }
                }
                div {
                    style {
                        display flex
                        alignItems baseline
                        gap "0.85rem"
                        flexWrap wrap
                        paddingBottom "1.5rem"
                        marginBottom "1.5rem"
                        borderBottom "1px solid var(--color-border)"
                    }
                    span "${state.product.data.price}" {
                        style {
                            fontFamily "var(--font-heading)"
                            fontSize "2.4rem"
                            fontWeight "800"
                            letterSpacing "-0.02em"
                            color "var(--color-text-primary)"
                            fontVariantNumeric tabular-nums
                        }
                    }
                    span "${state.product.data.oldPrice}" {
                        style {
                            display "${state.product.data.oldPrice ? 'inline' : 'none'}"
                            fontSize "1.3rem"
                            fontWeight "600"
                            color "var(--color-text-muted)"
                            textDecoration line-through
                            fontVariantNumeric tabular-nums
                        }
                    }
                    span "On sale" {
                        style {
                            display "${state.product.data.oldPrice ? 'inline-flex' : 'none'}"
                            alignItems center
                            padding "0.28rem 0.7rem"
                            borderRadius "999px"
                            backgroundColor "var(--color-sale-tint)"
                            color "var(--color-sale)"
                            fontSize "0.75rem"
                            fontWeight "800"
                            textTransform uppercase
                            letterSpacing "0.05em"
                        }
                    }
                }
                div {
                    style fontSize="1.05rem" lineHeight="1.75" color="var(--color-text-secondary)"
                    .children "${state.product.$children ?? []}"
                }
                div {
                    style display=flex flexWrap=wrap gap="0.75rem" marginTop="1.75rem"
                    a href="/contact/" {
                        style {
                            display inline-flex
                            alignItems center
                            gap "0.5rem"
                            backgroundColor "var(--color-primary)"
                            color "var(--color-text-white)"
                            padding "1rem 2.25rem"
                            borderRadius "999px"
                            fontSize "1.05rem"
                            fontWeight "700"
                            textDecoration none
                            boxShadow "0 14px 30px -12px rgba(10,157,84,0.8)"
                            transition "transform 0.15s, background-color 0.15s"
                            :hover {
                                backgroundColor "var(--color-primary-hover)"
                                transform "translateY(-2px)"
                            }
                        }
                        span 🛒
                        span "Add to cart"
                    }
                    a href="/contact/" "Reserve in-store" {
                        style {
                            display inline-flex
                            alignItems center
                            border "1px solid var(--color-line-strong)"
                            color "var(--color-text-primary)"
                            padding "1rem 1.85rem"
                            borderRadius "999px"
                            fontSize "1.05rem"
                            fontWeight "700"
                            textDecoration none
                            transition "border-color 0.15s"
                            :hover borderColor="var(--color-primary)"
                        }
                    }
                }
                div {
                    style {
                        marginTop "1.75rem"
                        padding "1.25rem"
                        borderRadius "var(--radius)"
                        backgroundColor "var(--color-bg-cream)"
                        display grid
                        gap "0.7rem"
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.6rem"
                            fontSize "0.92rem"
                            fontWeight "500"
                            color "var(--color-text-secondary)"
                        }
                        span ✓ {
                            style color="var(--color-primary)" fontWeight="800"
                        }
                        span "Professionally assembled and safety-checked before pickup."
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.6rem"
                            fontSize "0.92rem"
                            fontWeight "500"
                            color "var(--color-text-secondary)"
                        }
                        span ✓ {
                            style color="var(--color-primary)" fontWeight="800"
                        }
                        span "Free first tune-up and a lifetime of expert advice."
                    }
                    div {
                        style {
                            display flex
                            alignItems center
                            gap "0.6rem"
                            fontSize "0.92rem"
                            fontWeight "500"
                            color "var(--color-text-secondary)"
                        }
                        span ✓ {
                            style color="var(--color-primary)" fontWeight="800"
                        }
                        span "In stock now — 30-day returns, no questions asked."
                    }
                }
            }
        }
    }
    shp-cta {
        $props {
            heading "Not sure it's the right fit?"
            text "Tell us where and how you ride and our mechanics will match you to the right frame, size, and setup — no pressure."
            cta "Ask a mechanic"
            ctaHref "/contact/"
            cta2 "Keep browsing"
            cta2Href "/products/"
        }
    }
}
