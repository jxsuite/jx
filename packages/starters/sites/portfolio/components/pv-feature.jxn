/- kdl-version 2

pv-feature {
    state number="" title="" text=""
    style display=block paddingTop="1.75rem" borderTop="2px solid var(--color-ink)"
    div "${state.number}" {
        style {
            display "${state.number ? 'block' : 'none'}"
            fontFamily "var(--font-heading)"
            fontSize "1.4rem"
            fontWeight "600"
            color "var(--color-primary)"
            marginBottom "0.75rem"
            lineHeight "1"
        }
    }
    h3 "${state.title}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "1.4rem"
            fontWeight "600"
            margin "0 0 0.5rem"
        }
    }
    p "${state.text}" {
        style margin="0" color="var(--color-text-muted)" fontSize="1rem" lineHeight="1.7"
    }
}
