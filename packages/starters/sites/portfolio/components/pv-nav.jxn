/- kdl-version 2

pv-nav {
    state brand=Aperture
    style {
        position fixed
        top "0"
        left "0"
        right "0"
        zIndex "50"
        display block
        backgroundColor "rgba(12, 12, 13, 0.55)"
        backdropFilter "blur(14px)"
        borderBottom "1px solid rgba(255, 255, 255, 0.08)"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            padding "1.1rem 2rem"
            display flex
            alignItems center
            justifyContent space-between
            gap "1.5rem"
            @--sm padding="0.9rem 1.25rem"
        }
        a href="/" "${state.brand}" {
            style {
                fontFamily "var(--font-label)"
                fontWeight "400"
                fontSize "0.95rem"
                letterSpacing "0.42em"
                textTransform uppercase
                color "var(--color-text-primary)"
                textDecoration none
                paddingLeft "0.42em"
            }
        }
        nav {
            style {
                display flex
                alignItems center
                gap "2.25rem"
                fontSize "0.7rem"
                fontWeight "500"
                letterSpacing "0.2em"
                textTransform uppercase
                @--sm gap="1.25rem"
            }
            a href="/work/" Work {
                style {
                    color "var(--color-text-primary)"
                    textDecoration none
                    opacity "0.85"
                    transition "opacity 0.15s, color 0.15s"
                    :hover color="var(--color-primary)" opacity="1"
                }
            }
            a href="/about/" About {
                style {
                    color "var(--color-text-primary)"
                    textDecoration none
                    opacity "0.85"
                    transition "opacity 0.15s, color 0.15s"
                    @--sm display=none
                    :hover color="var(--color-primary)" opacity="1"
                }
            }
            a href="/contact/" Inquire {
                style color="var(--color-primary)" textDecoration=none transition="opacity 0.15s" {
                    :hover opacity="0.7"
                }
            }
        }
    }
}
