/- kdl-version 2

pf-feature {
    state step="" title="" text=""
    style display=block paddingTop="1.5rem" borderTop="2px solid var(--color-rule)"
    div "Step ${state.step}" {
        style {
            display "${state.step ? 'block' : 'none'}"
            fontFamily "var(--font-sans)"
            fontWeight "600"
            fontSize "0.72rem"
            textTransform uppercase
            letterSpacing "0.16em"
            color "var(--color-accent)"
            marginBottom "1rem"
            fontVariantNumeric tabular-nums
        }
    }
    h3 "${state.title}" {
        style {
            fontFamily "var(--font-serif)"
            fontSize "1.4rem"
            fontWeight "500"
            lineHeight "1.2"
            margin "0 0 0.6rem"
            color "var(--color-ink)"
        }
    }
    p "${state.text}" {
        style margin="0" color="var(--color-muted)" fontSize="1rem" lineHeight="1.6"
    }
}
