/- kdl-version 2

pf-statband {
    state n1="" l1="" n2="" l2="" n3="" l3="" n4="" l4=""
    style {
        display block
        backgroundColor "var(--color-paper)"
        borderTop "1px solid var(--color-rule)"
        borderBottom "1px solid var(--color-rule)"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "repeat(4, 1fr)"
            @--sm gridTemplateColumns="repeat(2, 1fr)"
        }
        div {
            style padding="clamp(1.5rem, 3vw, 2.4rem) clamp(1rem, 2.5vw, 1.75rem)"
            div "${state.n1}" {
                style {
                    fontFamily "var(--font-sans)"
                    fontWeight "600"
                    fontSize "clamp(2rem, 4.5vw, 3.1rem)"
                    lineHeight "1"
                    letterSpacing "-0.02em"
                    color "var(--color-ink)"
                    fontVariantNumeric tabular-nums
                }
            }
            div "${state.l1}" {
                style {
                    marginTop "0.7rem"
                    fontFamily "var(--font-sans)"
                    fontSize "0.7rem"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.14em"
                    color "var(--color-muted)"
                    lineHeight "1.4"
                }
            }
        }
        div {
            style {
                padding "clamp(1.5rem, 3vw, 2.4rem) clamp(1rem, 2.5vw, 1.75rem)"
                borderLeft "1px solid var(--color-hairline)"
            }
            div "${state.n2}" {
                style {
                    fontFamily "var(--font-sans)"
                    fontWeight "600"
                    fontSize "clamp(2rem, 4.5vw, 3.1rem)"
                    lineHeight "1"
                    letterSpacing "-0.02em"
                    color "var(--color-ink)"
                    fontVariantNumeric tabular-nums
                }
            }
            div "${state.l2}" {
                style {
                    marginTop "0.7rem"
                    fontFamily "var(--font-sans)"
                    fontSize "0.7rem"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.14em"
                    color "var(--color-muted)"
                    lineHeight "1.4"
                }
            }
        }
        div {
            style {
                padding "clamp(1.5rem, 3vw, 2.4rem) clamp(1rem, 2.5vw, 1.75rem)"
                borderLeft "1px solid var(--color-hairline)"
                @--sm borderLeft=none borderTop="1px solid var(--color-hairline)"
            }
            div "${state.n3}" {
                style {
                    fontFamily "var(--font-sans)"
                    fontWeight "600"
                    fontSize "clamp(2rem, 4.5vw, 3.1rem)"
                    lineHeight "1"
                    letterSpacing "-0.02em"
                    color "var(--color-ink)"
                    fontVariantNumeric tabular-nums
                }
            }
            div "${state.l3}" {
                style {
                    marginTop "0.7rem"
                    fontFamily "var(--font-sans)"
                    fontSize "0.7rem"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.14em"
                    color "var(--color-muted)"
                    lineHeight "1.4"
                }
            }
        }
        div {
            style {
                padding "clamp(1.5rem, 3vw, 2.4rem) clamp(1rem, 2.5vw, 1.75rem)"
                borderLeft "1px solid var(--color-hairline)"
                @--sm borderTop="1px solid var(--color-hairline)"
            }
            div "${state.n4}" {
                style {
                    fontFamily "var(--font-sans)"
                    fontWeight "600"
                    fontSize "clamp(2rem, 4.5vw, 3.1rem)"
                    lineHeight "1"
                    letterSpacing "-0.02em"
                    color "var(--color-ink)"
                    fontVariantNumeric tabular-nums
                }
            }
            div "${state.l4}" {
                style {
                    marginTop "0.7rem"
                    fontFamily "var(--font-sans)"
                    fontSize "0.7rem"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.14em"
                    color "var(--color-muted)"
                    lineHeight "1.4"
                }
            }
        }
    }
}
