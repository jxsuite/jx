/- kdl-version 2

pf-nav {
    state brand=Meridian sub=Advisory
    style {
        display block
        position sticky
        top "0"
        zIndex "50"
        backgroundColor "var(--color-paper)"
        borderTop "3px solid var(--color-accent)"
        borderBottom "1px solid var(--color-rule)"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            padding "0.9rem 1.5rem"
            display flex
            alignItems baseline
            justifyContent space-between
            gap "1.5rem"
        }
        a href="/" {
            style {
                display inline-flex
                alignItems baseline
                gap "0.6rem"
                textDecoration none
                color "var(--color-ink)"
            }
            span "${state.brand}" {
                style {
                    fontFamily "var(--font-serif)"
                    fontSize "1.5rem"
                    fontWeight "600"
                    letterSpacing "-0.01em"
                    lineHeight "1"
                }
            }
            span "${state.sub}" {
                style {
                    fontFamily "var(--font-sans)"
                    fontSize "0.68rem"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.28em"
                    color "var(--color-accent)"
                }
            }
        }
        nav {
            style {
                display flex
                alignItems baseline
                gap "2rem"
                fontFamily "var(--font-sans)"
                fontSize "0.72rem"
                fontWeight "600"
                textTransform uppercase
                letterSpacing "0.16em"
                @--sm gap="1.15rem"
            }
            a href="/services/" Practice {
                style color="var(--color-ink)" textDecoration=none transition="color 0.15s" {
                    :hover color="var(--color-accent)"
                }
            }
            a href="/insights/" Insights {
                style color="var(--color-ink)" textDecoration=none transition="color 0.15s" {
                    @--sm display=none
                    :hover color="var(--color-accent)"
                }
            }
            a href="/team/" People {
                style color="var(--color-ink)" textDecoration=none transition="color 0.15s" {
                    @--sm display=none
                    :hover color="var(--color-accent)"
                }
            }
            a href="/contact/" Consult {
                style {
                    color "var(--color-ink)"
                    textDecoration none
                    border "1px solid var(--color-rule)"
                    padding "0.5rem 0.9rem"
                    transition "background-color 0.15s, color 0.15s"
                    :hover backgroundColor="var(--color-ink)" color="var(--color-paper)"
                }
            }
        }
    }
}
