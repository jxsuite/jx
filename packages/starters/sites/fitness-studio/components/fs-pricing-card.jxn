/- kdl-version 2

fs-pricing-card {
    state {
        tier ""
        price ""
        per ""
        description ""
        badge ""
        featured #false
        cta "Get started"
        ctaHref "/contact/"
        perk1 ""
        perk2 ""
        perk3 ""
        perk4 ""
        perk5 ""
    }
    style {
        display flex
        flexDirection column
        height "100%"
        position relative
        padding "2.2rem"
        borderRadius "var(--radius)"
        backgroundColor "${state.featured ? 'var(--color-ink)' : 'var(--color-bg-white)'}"
        border "${state.featured ? '1px solid transparent' : '1px solid var(--color-border)'}"
        color "${state.featured ? '#ffffff' : 'var(--color-text-primary)'}"
        boxShadow "${state.featured ? '0 30px 60px -24px rgba(255,46,99,0.5)' : '0 10px 30px -20px rgba(26,15,24,0.25)'}"
        transform "${state.featured ? 'translateY(-0.5rem)' : 'none'}"
        @--lg transform=none
    }
    span "${state.badge}" {
        style {
            display "${state.badge ? 'inline-block' : 'none'}"
            position absolute
            top "-0.85rem"
            left "2.2rem"
            background "var(--grad-hot)"
            color "#ffffff"
            fontFamily "var(--font-heading)"
            fontSize "0.7rem"
            fontWeight "800"
            textTransform uppercase
            letterSpacing "0.08em"
            padding "0.4rem 0.95rem"
            borderRadius "999px"
            boxShadow "0 10px 24px -10px rgba(255,46,99,0.7)"
        }
    }
    h3 "${state.tier}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "0.9rem"
            fontWeight "800"
            textTransform uppercase
            letterSpacing "0.1em"
            margin "0 0 1rem"
            color "${state.featured ? 'rgba(255,255,255,0.7)' : 'var(--color-text-muted)'}"
        }
    }
    div {
        style display=flex alignItems=baseline gap="0.4rem" margin="0 0 0.5rem"
        span "${state.price}" {
            style {
                fontFamily "var(--font-display)"
                fontSize "3.4rem"
                fontWeight "400"
                lineHeight "0.9"
                background "var(--grad-hot)"
                backgroundClip text
                webkitBackgroundClip text
                webkitTextFillColor transparent
                color "var(--color-primary)"
            }
        }
        span "${state.per}" {
            style {
                display "${state.per ? 'inline' : 'none'}"
                color "${state.featured ? 'rgba(255,255,255,0.6)' : 'var(--color-text-muted)'}"
                fontSize "0.95rem"
                fontWeight "600"
            }
        }
    }
    p "${state.description}" {
        style {
            display "${state.description ? 'block' : 'none'}"
            margin "0 0 1.6rem"
            color "${state.featured ? 'rgba(255,255,255,0.72)' : 'var(--color-text-muted)'}"
            fontSize "0.95rem"
            lineHeight "1.6"
        }
    }
    ul {
        style {
            listStyle none
            margin "0 0 1.9rem"
            padding "0"
            display flex
            flexDirection column
            gap "0.7rem"
        }
        li {
            style {
                display "${state.perk1 ? 'flex' : 'none'}"
                gap "0.65rem"
                alignItems flex-start
                fontSize "0.95rem"
                fontWeight "500"
            }
            span ✓ {
                style color="var(--color-ember)" fontWeight="800" flexShrink="0"
            }
            span "${state.perk1}"
        }
        li {
            style {
                display "${state.perk2 ? 'flex' : 'none'}"
                gap "0.65rem"
                alignItems flex-start
                fontSize "0.95rem"
                fontWeight "500"
            }
            span ✓ {
                style color="var(--color-ember)" fontWeight="800" flexShrink="0"
            }
            span "${state.perk2}"
        }
        li {
            style {
                display "${state.perk3 ? 'flex' : 'none'}"
                gap "0.65rem"
                alignItems flex-start
                fontSize "0.95rem"
                fontWeight "500"
            }
            span ✓ {
                style color="var(--color-ember)" fontWeight="800" flexShrink="0"
            }
            span "${state.perk3}"
        }
        li {
            style {
                display "${state.perk4 ? 'flex' : 'none'}"
                gap "0.65rem"
                alignItems flex-start
                fontSize "0.95rem"
                fontWeight "500"
            }
            span ✓ {
                style color="var(--color-ember)" fontWeight="800" flexShrink="0"
            }
            span "${state.perk4}"
        }
        li {
            style {
                display "${state.perk5 ? 'flex' : 'none'}"
                gap "0.65rem"
                alignItems flex-start
                fontSize "0.95rem"
                fontWeight "500"
            }
            span ✓ {
                style color="var(--color-ember)" fontWeight="800" flexShrink="0"
            }
            span "${state.perk5}"
        }
    }
    a href="${state.ctaHref}" "${state.cta}" {
        style {
            marginTop auto
            display block
            textAlign center
            background "${state.featured ? '#ffffff' : 'var(--grad-hot)'}"
            color "${state.featured ? 'var(--color-ink)' : '#ffffff'}"
            padding "0.9rem 1.5rem"
            borderRadius "999px"
            fontFamily "var(--font-heading)"
            fontSize "0.86rem"
            fontWeight "800"
            textTransform uppercase
            letterSpacing "0.06em"
            textDecoration none
            boxShadow "${state.featured ? 'none' : '0 12px 28px -12px rgba(255,46,99,0.55)'}"
            transition "transform 0.15s, box-shadow 0.15s"
            :hover transform="translateY(-2px)" boxShadow="0 16px 34px -12px rgba(255,46,99,0.6)"
        }
    }
}
