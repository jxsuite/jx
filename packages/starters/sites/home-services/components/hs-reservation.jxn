/- kdl-version 2

hs-reservation {
    state heading="Request a free quote"
    style {
        display block
        backgroundColor "var(--color-bg-white)"
        border "1px solid var(--color-border)"
        borderTop "4px solid var(--color-primary)"
        borderRadius "var(--radius)"
        boxShadow "var(--shadow-card)"
        overflow hidden
    }
    div {
        style padding="1.75rem 1.75rem 0"
        h3 "${state.heading}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.7rem"
                fontWeight "600"
                textTransform uppercase
                letterSpacing "0.02em"
                margin "0 0 0.35rem"
            }
        }
        p "Flat-rate pricing · No obligation · Same-day slots available." {
            style margin="0" color="var(--color-text-muted)" fontSize="0.95rem"
        }
    }
    form action="#" method=post {
        style display=grid gap="0.9rem" alignContent=start padding="1.4rem 1.75rem 1.75rem"
        input type=text name=name placeholder="Your name" required="true" aria-label="Your name" {
            style {
                width "100%"
                padding "0.8rem 0.9rem"
                border "1px solid var(--color-border-strong)"
                borderRadius "var(--radius-sm)"
                fontSize "1rem"
                fontFamily inherit
                backgroundColor "var(--color-bg-cream)"
            }
        }
        div {
            style display=grid gridTemplateColumns="1fr 1fr" gap="0.9rem" {
                @--sm gridTemplateColumns="1fr"
            }
            input type=email name=email placeholder="Email address" required="true" aria-label="Email address" {
                style {
                    width "100%"
                    padding "0.8rem 0.9rem"
                    border "1px solid var(--color-border-strong)"
                    borderRadius "var(--radius-sm)"
                    fontSize "1rem"
                    fontFamily inherit
                    backgroundColor "var(--color-bg-cream)"
                }
            }
            input type=tel name=phone placeholder="Phone number" aria-label="Phone number" {
                style {
                    width "100%"
                    padding "0.8rem 0.9rem"
                    border "1px solid var(--color-border-strong)"
                    borderRadius "var(--radius-sm)"
                    fontSize "1rem"
                    fontFamily inherit
                    backgroundColor "var(--color-bg-cream)"
                }
            }
        }
        select name=service aria-label="Service needed" {
            style {
                width "100%"
                padding "0.8rem 0.9rem"
                border "1px solid var(--color-border-strong)"
                borderRadius "var(--radius-sm)"
                fontSize "1rem"
                fontFamily inherit
                fontWeight "500"
                color "var(--color-text-primary)"
                backgroundColor "var(--color-bg-cream)"
                cursor pointer
            }
            option value="" "What do you need? (e.g. AC repair)"
            option value=ac-repair "AC Repair"
            option value=ac-install "AC Installation"
            option value=furnace-repair "Furnace Repair"
            option value=furnace-install "Furnace Installation"
            option value=heat-pump "Heat Pumps"
            option value=maintenance "Maintenance Plan"
            option value=emergency "Emergency — no heat/AC"
            option value=other "Something else"
        }
        textarea name=notes rows="4" placeholder="Describe the problem or project…" aria-label=Notes {
            style {
                width "100%"
                padding "0.8rem 0.9rem"
                border "1px solid var(--color-border-strong)"
                borderRadius "var(--radius-sm)"
                fontSize "1rem"
                fontFamily inherit
                backgroundColor "var(--color-bg-cream)"
            }
        }
        button type=submit "Request My Free Quote →" {
            style {
                backgroundColor "var(--color-primary)"
                color "var(--color-text-white)"
                padding "0.95rem 1.5rem"
                border none
                borderRadius "var(--radius-sm)"
                fontFamily "var(--font-heading)"
                textTransform uppercase
                letterSpacing "0.05em"
                fontSize "1.05rem"
                fontWeight "600"
                cursor pointer
                transition "background-color 0.15s"
                :hover backgroundColor="var(--color-primary-hover)"
            }
        }
        p "This is a demo form. Wire it to your CRM, scheduler, or email in pages/contact.md." {
            style fontSize="0.85rem" color="var(--color-text-muted)" margin="0"
        }
    }
}
