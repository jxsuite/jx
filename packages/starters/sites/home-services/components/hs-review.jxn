/- kdl-version 2

hs-review {
    state quote="" author="" role=""
    style {
        position relative
        display flex
        flexDirection column
        height "100%"
        padding "1.9rem 1.75rem"
        backgroundColor "var(--color-bg-white)"
        border "1px solid var(--color-border)"
        borderRadius "var(--radius)"
        boxShadow "var(--shadow-card)"
    }
    div {
        style {
            display flex
            alignItems center
            justifyContent space-between
            gap "1rem"
            marginBottom "0.9rem"
        }
        div ★★★★★ {
            style color="var(--color-primary)" fontSize="1.05rem" letterSpacing="0.14em"
        }
        span ” {
            style {
                fontFamily "var(--font-heading)"
                fontSize "2.4rem"
                lineHeight "0.6"
                color "var(--color-bg-concrete)"
                fontWeight "700"
            }
        }
    }
    p "“${state.quote}”" {
        style {
            flex "1"
            fontSize "1.05rem"
            lineHeight "1.6"
            color "var(--color-text-primary)"
            margin "0 0 1.35rem"
        }
    }
    div {
        style {
            display flex
            alignItems center
            gap "0.75rem"
            paddingTop "1.1rem"
            borderTop "1px solid var(--color-border)"
        }
        div ★ {
            style {
                display flex
                alignItems center
                justifyContent center
                width "2.4rem"
                height "2.4rem"
                borderRadius "var(--radius-sm)"
                backgroundColor "var(--color-primary-soft)"
                color "var(--color-primary)"
                fontFamily "var(--font-heading)"
                fontWeight "700"
                fontSize "1.05rem"
            }
        }
        div {
            div "${state.author}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontWeight "600"
                    textTransform uppercase
                    letterSpacing "0.02em"
                    fontSize "1rem"
                }
            }
            div "${state.role}" {
                style fontSize="0.85rem" color="var(--color-text-muted)"
            }
        }
    }
}
