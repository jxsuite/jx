/- kdl-version 2

hs-nav {
    state {
        brand SUMMIT
        brandSub "HEATING & COOLING"
        phone "(970) 555-0148"
        phoneHref tel:+19705550148
        hours "Mon–Fri 7a–6p · Sat 8a–2p"
        region "Licensed & Insured · Serving Northern Colorado"
    }
    style display=block position=sticky top="0" zIndex="60"
    div {
        style {
            backgroundColor "var(--color-steel)"
            color "var(--color-text-steel-muted)"
            borderBottom "1px solid var(--color-steel-line)"
            fontFamily "var(--font-body)"
        }
        div {
            style {
                maxWidth "var(--max-width)"
                margin "0 auto"
                padding "0.4rem 1.5rem"
                display flex
                alignItems center
                justifyContent space-between
                gap "1rem"
                fontSize "0.82rem"
                fontWeight "500"
            }
            span "${state.region}" {
                style letterSpacing="0.02em" {
                    @--md display=none
                }
            }
            div {
                style display=flex alignItems=center gap="1.1rem" marginLeft=auto
                span "${state.hours}" {
                    style letterSpacing="0.02em" {
                        @--lg display=none
                    }
                }
                span {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.4rem"
                        padding "0.15rem 0.6rem"
                        borderRadius "999px"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        fontFamily "var(--font-heading)"
                        fontWeight "600"
                        fontSize "0.72rem"
                        letterSpacing "0.08em"
                        textTransform uppercase
                    }
                    span {
                        style {
                            width "0.45rem"
                            height "0.45rem"
                            borderRadius "999px"
                            backgroundColor "#ffffff"
                            boxShadow "0 0 0 3px rgba(255,255,255,0.35)"
                        }
                    }
                    span "24/7 Emergency"
                }
            }
        }
    }
    div {
        style {
            backgroundColor "var(--color-bg-white)"
            borderBottom "2px solid var(--color-steel)"
            boxShadow "0 6px 24px -18px rgba(14,26,35,0.6)"
        }
        div {
            style {
                maxWidth "var(--max-width)"
                margin "0 auto"
                padding "0.7rem 1.5rem"
                display flex
                alignItems center
                justifyContent space-between
                gap "1.5rem"
            }
            a href="/" {
                style {
                    display flex
                    alignItems center
                    gap "0.7rem"
                    textDecoration none
                    color "var(--color-text-primary)"
                }
                span ▲ {
                    style {
                        display flex
                        alignItems center
                        justifyContent center
                        width "2.6rem"
                        height "2.6rem"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        borderRadius "0.35rem"
                        fontFamily "var(--font-heading)"
                        fontWeight "700"
                        fontSize "1.5rem"
                        lineHeight "1"
                        clipPath "polygon(0 0, 100% 0, 100% 78%, 50% 100%, 0 78%)"
                    }
                }
                span {
                    style display=flex flexDirection=column lineHeight="1"
                    span "${state.brand}" {
                        style {
                            fontFamily "var(--font-heading)"
                            fontWeight "700"
                            fontSize "1.35rem"
                            letterSpacing "0.06em"
                        }
                    }
                    span "${state.brandSub}" {
                        style {
                            fontFamily "var(--font-heading)"
                            fontWeight "500"
                            fontSize "0.6rem"
                            letterSpacing "0.24em"
                            color "var(--color-primary)"
                            marginTop "0.15rem"
                        }
                    }
                }
            }
            nav {
                style display=flex alignItems=center gap="1.75rem"
                a href="/services/" Services {
                    style {
                        fontFamily "var(--font-heading)"
                        textTransform uppercase
                        letterSpacing "0.06em"
                        color "var(--color-text-primary)"
                        textDecoration none
                        fontWeight "600"
                        fontSize "0.95rem"
                        @--md display=none
                        :hover color="var(--color-primary)"
                    }
                }
                a href="/about/" About {
                    style {
                        fontFamily "var(--font-heading)"
                        textTransform uppercase
                        letterSpacing "0.06em"
                        color "var(--color-text-primary)"
                        textDecoration none
                        fontWeight "600"
                        fontSize "0.95rem"
                        @--md display=none
                        :hover color="var(--color-primary)"
                    }
                }
                a href="${state.phoneHref}" {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.5rem"
                        fontFamily "var(--font-heading)"
                        color "var(--color-text-primary)"
                        textDecoration none
                        fontWeight "700"
                        fontSize "1.05rem"
                        letterSpacing "0.01em"
                        @--sm display=none
                        :hover color="var(--color-primary)"
                    }
                    span ☏ {
                        style color="var(--color-primary)" fontSize="1.1rem"
                    }
                    span "${state.phone}"
                }
                a href="/contact/" "Free Quote" {
                    style {
                        display inline-block
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        padding "0.6rem 1.35rem"
                        borderRadius "var(--radius-sm)"
                        textDecoration none
                        fontFamily "var(--font-heading)"
                        textTransform uppercase
                        letterSpacing "0.05em"
                        fontWeight "600"
                        fontSize "0.95rem"
                        boxShadow "0 10px 22px -12px rgba(244,81,30,0.9)"
                        transition "background-color 0.15s, transform 0.15s"
                        :hover {
                            backgroundColor "var(--color-primary-hover)"
                            transform "translateY(-1px)"
                        }
                    }
                }
            }
        }
    }
}
