/- kdl-version 2

hs-section-header {
    state eyebrow="" heading="" subheading="" align=center
    style {
        display block
        maxWidth "var(--max-width-narrow)"
        margin "0 auto 2.75rem"
        textAlign "${state.align}"
    }
    p {
        style {
            display "${state.eyebrow ? 'inline-flex' : 'none'}"
            alignItems center
            gap "0.5rem"
            textTransform uppercase
            fontFamily "var(--font-heading)"
            letterSpacing "0.14em"
            fontSize "0.82rem"
            fontWeight "600"
            color "var(--color-primary)"
            margin "0 0 0.9rem"
        }
        span {
            style {
                width "1.6rem"
                height "0.2rem"
                backgroundColor "var(--color-primary)"
                display inline-block
            }
        }
        span "${state.eyebrow}"
    }
    h2 "${state.heading}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "clamp(2rem, 4.4vw, 3rem)"
            fontWeight "700"
            textTransform uppercase
            lineHeight "1.05"
            letterSpacing "0.01em"
            margin "0"
            color "var(--color-text-primary)"
        }
    }
    p "${state.subheading}" {
        style {
            display "${state.subheading ? 'block' : 'none'}"
            fontSize "1.12rem"
            lineHeight "1.7"
            color "var(--color-text-muted)"
            margin "1rem auto 0"
            maxWidth "58ch"
        }
    }
}
