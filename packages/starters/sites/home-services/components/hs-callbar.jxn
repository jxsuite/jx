/- kdl-version 2

hs-callbar {
    state phone="(970) 555-0148" phoneHref=tel:+19705550148
    style {
        display none
        position fixed
        bottom "0"
        left "0"
        right "0"
        zIndex "70"
        gridTemplateColumns "1fr 1fr"
        backgroundColor "var(--color-steel)"
        borderTop "2px solid var(--color-primary)"
        boxShadow "0 -8px 26px -14px rgba(0,0,0,0.7)"
        @--md display=grid
    }
    a href="${state.phoneHref}" {
        style {
            display flex
            alignItems center
            justifyContent center
            gap "0.5rem"
            padding "0.95rem 1rem"
            color "var(--color-text-white)"
            textDecoration none
            fontFamily "var(--font-heading)"
            textTransform uppercase
            letterSpacing "0.04em"
            fontWeight "600"
            fontSize "1rem"
            borderRight "1px solid var(--color-steel-line)"
        }
        span ☏ {
            style color="var(--color-primary)" fontSize="1.15rem"
        }
        span "Call Now"
    }
    a href="/contact/" {
        style {
            display flex
            alignItems center
            justifyContent center
            gap "0.5rem"
            padding "0.95rem 1rem"
            backgroundColor "var(--color-primary)"
            color "var(--color-text-white)"
            textDecoration none
            fontFamily "var(--font-heading)"
            textTransform uppercase
            letterSpacing "0.04em"
            fontWeight "600"
            fontSize "1rem"
        }
        span ⚡ {
            style fontSize="1.1rem"
        }
        span "Free Quote"
    }
}
