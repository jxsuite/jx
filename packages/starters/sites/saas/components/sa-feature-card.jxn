/- kdl-version 2

sa-feature-card {
    state icon="" title="" text="" col="2"
    style {
        display flex
        flexDirection column
        gridColumn "span ${state.col}"
        padding "1.9rem"
        backgroundColor "var(--color-bg-elev)"
        borderRadius "var(--radius)"
        border "1px solid var(--color-border)"
        position relative
        overflow hidden
        transition "border-color 0.18s, transform 0.18s, box-shadow 0.18s"
        @--md gridColumn="span 1"
        :hover {
            borderColor "rgba(124, 116, 255, 0.5)"
            transform "translateY(-3px)"
            boxShadow "0 18px 44px -20px var(--glow)"
        }
    }
    div "${state.icon}" {
        style {
            display inline-flex
            alignItems center
            justifyContent center
            width "2.9rem"
            height "2.9rem"
            borderRadius "0.7rem"
            background "linear-gradient(150deg, rgba(124,116,255,0.28), rgba(34,211,238,0.14))"
            border "1px solid var(--color-border)"
            fontSize "1.45rem"
            lineHeight "1"
            marginBottom "1.1rem"
        }
    }
    h3 "${state.title}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "1.22rem"
            fontWeight "600"
            letterSpacing "-0.01em"
            margin "0 0 0.5rem"
            color "var(--color-text-primary)"
        }
    }
    p "${state.text}" {
        style {
            margin "0"
            color "var(--color-text-muted)"
            fontSize "0.98rem"
            lineHeight "1.65"
            maxWidth "46ch"
        }
    }
}
