/- kdl-version 2

sa-footer {
    state {
        brand Flowlark
        tagline "The product platform for teams that ship. Plan, build, and scale without the busywork."
        email hello@flowlark.app
    }
    style {
        display block
        backgroundColor "var(--color-bg-dark)"
        color "var(--color-text-white)"
        padding "3.5rem 1.5rem 2rem"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "2fr 1fr 1fr"
            gap "2.5rem"
            @--md gridTemplateColumns="1fr"
        }
        div {
            div "${state.brand}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.35rem"
                    fontWeight "700"
                    marginBottom "0.75rem"
                    letterSpacing "-0.02em"
                }
            }
            p "${state.tagline}" {
                style margin="0" opacity="0.7" maxWidth="36ch" lineHeight="1.7"
            }
        }
        div {
            div Product {
                style {
                    textTransform uppercase
                    letterSpacing "0.08em"
                    fontSize "0.75rem"
                    opacity "0.55"
                    marginBottom "0.9rem"
                }
            }
            a href="/features/" Features {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.8"
                    textDecoration none
                    marginBottom "0.4rem"
                }
            }
            a href="/pricing/" Pricing {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.8"
                    textDecoration none
                    marginBottom "0.4rem"
                }
            }
            a href="/contact/" Contact {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.8"
                    textDecoration none
                }
            }
        }
        div {
            div "Get in touch" {
                style {
                    textTransform uppercase
                    letterSpacing "0.08em"
                    fontSize "0.75rem"
                    opacity "0.55"
                    marginBottom "0.9rem"
                }
            }
            p "${state.email}" {
                style margin="0 0 0.4rem" opacity="0.8"
            }
            p "Remote-first · Worldwide" {
                style margin="0" opacity="0.8"
            }
        }
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "2.5rem auto 0"
            paddingTop "1.5rem"
            borderTop "1px solid rgba(255, 255, 255, 0.15)"
            fontSize "0.85rem"
            opacity "0.55"
        }
        p "© Flowlark. Built with Jx." {
            style margin="0"
        }
    }
}
