/- kdl-version 2

sa-logo-cloud {
    state {
        label "Trusted by fast-moving teams everywhere"
        logo1 "◈ Northwind"
        logo2 "✦ Lumen"
        logo3 "▲ Apex"
        logo4 "❖ Corva"
        logo5 "⬡ Hivebase"
        logo6 "◐ Halcyon"
    }
    style {
        display block
        padding "clamp(2.5rem, 5vw, 3.5rem) 1.5rem"
        borderTop "1px solid var(--color-border)"
        borderBottom "1px solid var(--color-border)"
        backgroundColor "var(--color-bg-cream)"
    }
    div {
        style maxWidth="var(--max-width)" margin="0 auto" textAlign=center
        p "${state.label}" {
            style {
                fontSize "0.8rem"
                fontWeight "600"
                textTransform uppercase
                letterSpacing "0.12em"
                color "var(--color-text-muted)"
                margin "0 0 1.75rem"
            }
        }
        div {
            style {
                display flex
                flexWrap wrap
                justifyContent center
                alignItems center
                gap "clamp(1.5rem, 5vw, 3.5rem)"
            }
            span "${state.logo1}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                }
            }
            span "${state.logo2}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                }
            }
            span "${state.logo3}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                }
            }
            span "${state.logo4}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                }
            }
            span "${state.logo5}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                    @--sm display=none
                }
            }
            span "${state.logo6}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.2rem"
                    fontWeight "600"
                    color "var(--color-text-primary)"
                    opacity "0.65"
                    @--sm display=none
                }
            }
        }
    }
}
