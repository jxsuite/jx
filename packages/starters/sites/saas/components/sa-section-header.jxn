/- kdl-version 2

sa-section-header {
    state eyebrow="" heading="" subheading="" align=center
    style {
        display block
        maxWidth "var(--max-width-narrow)"
        margin "0 auto 3rem"
        textAlign "${state.align}"
    }
    p "${state.eyebrow}" {
        style {
            display "${state.eyebrow ? 'block' : 'none'}"
            fontFamily "var(--font-heading)"
            textTransform uppercase
            letterSpacing "0.12em"
            fontSize "0.8rem"
            fontWeight "600"
            color "var(--color-primary)"
            margin "0 0 0.75rem"
        }
    }
    h2 "${state.heading}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "clamp(1.9rem, 4vw, 2.6rem)"
            fontWeight "700"
            lineHeight "1.15"
            letterSpacing "-0.03em"
            margin "0"
        }
    }
    p "${state.subheading}" {
        style {
            display "${state.subheading ? 'block' : 'none'}"
            fontSize "1.1rem"
            lineHeight "1.7"
            color "var(--color-text-muted)"
            margin "1rem auto 0"
            maxWidth "56ch"
        }
    }
}
