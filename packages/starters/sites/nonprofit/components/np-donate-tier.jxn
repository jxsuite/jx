/- kdl-version 2

np-donate-tier {
    state {
        amount ""
        title ""
        text ""
        icon ""
        featured #false
        cta "Give this amount"
        ctaHref "/get-involved/"
    }
    style {
        display flex
        flexDirection column
        position relative
        padding "2rem 1.9rem 2.1rem"
        backgroundColor "${state.featured ? 'var(--color-primary-deep)' : 'var(--color-bg-white)'}"
        color "${state.featured ? 'var(--color-text-white)' : 'var(--color-text-primary)'}"
        borderRadius "var(--radius-lg)"
        border "${state.featured ? '2px solid var(--color-gold)' : '1px solid var(--color-border)'}"
        boxShadow "${state.featured ? 'var(--shadow-float)' : 'var(--shadow-card)'}"
        transform "${state.featured ? 'translateY(-0.5rem)' : 'none'}"
    }
    div "★ Most loved" {
        style {
            display "${state.featured ? 'inline-flex' : 'none'}"
            alignItems center
            gap "0.35rem"
            alignSelf flex-start
            backgroundColor "var(--color-gold)"
            color "var(--color-primary-deep)"
            fontSize "0.72rem"
            fontWeight "800"
            textTransform uppercase
            letterSpacing "0.08em"
            padding "0.3rem 0.8rem"
            borderRadius "999px"
            marginBottom "1rem"
        }
    }
    div "${state.icon}" {
        style {
            display inline-flex
            alignItems center
            justifyContent center
            width "3rem"
            height "3rem"
            borderRadius "999px"
            backgroundColor "${state.featured ? 'rgba(255,255,255,0.12)' : 'var(--color-primary-soft)'}"
            fontSize "1.5rem"
            marginBottom "1.1rem"
        }
    }
    div "${state.amount}" {
        style {
            fontFamily "var(--font-display)"
            fontSize "2.6rem"
            fontWeight "700"
            lineHeight "1"
            color "${state.featured ? 'var(--color-gold)' : 'var(--color-primary)'}"
        }
    }
    h3 "${state.title}" {
        style {
            fontFamily "var(--font-display)"
            fontSize "1.3rem"
            fontWeight "600"
            margin "0.85rem 0 0.4rem"
        }
    }
    p "${state.text}" {
        style {
            margin "0 0 1.6rem"
            fontSize "0.98rem"
            fontWeight "600"
            lineHeight "1.6"
            flex "1"
            color "${state.featured ? 'rgba(255,255,255,0.82)' : 'var(--color-text-muted)'}"
        }
    }
    a href="${state.ctaHref}" {
        style {
            display flex
            alignItems center
            justifyContent center
            gap "0.4rem"
            backgroundColor "${state.featured ? 'var(--color-gold)' : 'var(--color-accent)'}"
            color "${state.featured ? 'var(--color-primary-deep)' : 'var(--color-text-white)'}"
            padding "0.85rem 1.25rem"
            borderRadius "999px"
            textDecoration none
            fontWeight "800"
            fontSize "1rem"
            transition "transform 0.15s, opacity 0.15s"
            :hover transform="translateY(-1px)" opacity="0.94"
        }
        span ❤ {
            style fontSize="0.9rem"
        }
        span "${state.cta}"
    }
}
