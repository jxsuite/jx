/- kdl-version 2

np-contact-info {
    state {
        line1 "240 Riverside Avenue"
        line2 "Rivertown, CA 90210"
        phone "(555) 204-7788"
        phoneHref tel:+15552047788
        email hello@rivertownfoundation.org
        emailHref mailto:hello@rivertownfoundation.org
    }
    style display=block
    div {
        style {
            padding "2rem"
            backgroundColor "var(--color-primary-deep)"
            color "var(--color-text-white)"
            borderRadius "var(--radius-lg)"
        }
        h3 "Visit us" {
            style {
                fontFamily "var(--font-display)"
                fontSize "1.5rem"
                fontWeight "600"
                margin "0 0 1rem"
            }
        }
        p "${state.line1}" {
            style margin="0 0 0.35rem" opacity="0.85" fontWeight="600"
        }
        p "${state.line2}" {
            style margin="0 0 0.35rem" opacity="0.85" fontWeight="600"
        }
        p {
            style margin="0.85rem 0 0.35rem"
            a href="${state.phoneHref}" "${state.phone}" {
                style color="var(--color-gold)" textDecoration=none fontWeight="800"
            }
        }
        p {
            style margin="0"
            a href="${state.emailHref}" "${state.email}" {
                style color="var(--color-gold)" textDecoration=none fontWeight="800"
            }
        }
    }
    div {
        style {
            marginTop "1.5rem"
            padding "2rem"
            backgroundColor "var(--color-bg-cream)"
            border "1px solid var(--color-border)"
            borderRadius "var(--radius-lg)"
        }
        h3 "Office hours" {
            style {
                fontFamily "var(--font-display)"
                fontSize "1.5rem"
                fontWeight "600"
                color "var(--color-primary-deep)"
                margin "0 0 1.25rem"
            }
        }
        div {
            style {
                display flex
                justifyContent space-between
                padding "0.6rem 0"
                borderBottom "1px solid var(--color-border)"
                fontWeight "600"
            }
            span "Monday – Friday" {
                style fontWeight="700"
            }
            span "9:00am – 5:00pm" {
                style color="var(--color-text-muted)"
            }
        }
        div {
            style {
                display flex
                justifyContent space-between
                padding "0.6rem 0"
                borderBottom "1px solid var(--color-border)"
                fontWeight "600"
            }
            span Saturday {
                style fontWeight="700"
            }
            span "9:00am – 1:00pm (Pantry)" {
                style color="var(--color-text-muted)"
            }
        }
        div {
            style display=flex justifyContent=space-between padding="0.6rem 0" fontWeight="600"
            span Sunday {
                style fontWeight="700"
            }
            span Closed {
                style color="var(--color-text-muted)"
            }
        }
    }
}
