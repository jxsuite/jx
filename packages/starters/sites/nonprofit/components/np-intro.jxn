/- kdl-version 2

np-intro {
    state {
        eyebrow "Our mission"
        image type=string format=image default=""
        imageAlt ""
        reverse #false
        signNumber "17"
        signLabel "years rooted in Rivertown"
    }
    style display=block padding="clamp(3.5rem, 8vw, 6rem) 1.5rem"
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "1fr 1fr"
            gap "clamp(2.5rem, 6vw, 5rem)"
            alignItems center
            @--md gridTemplateColumns="1fr" gap="2.75rem"
        }
        div {
            style position=relative order="${state.reverse ? '2' : '1'}" {
                @--md order="1" maxWidth="480px"
            }
            div {
                style {
                    position absolute
                    inset "-1.1rem 1.25rem 1.25rem -1.1rem"
                    borderRadius "44% 56% 52% 48% / 55% 45% 55% 45%"
                    backgroundColor "var(--color-gold-soft)"
                    opacity "0.75"
                }
            }
            div {
                style {
                    position relative
                    aspectRatio "4 / 3.4"
                    borderRadius "var(--radius-lg)"
                    overflow hidden
                    boxShadow "var(--shadow-card)"
                }
                img src="${state.image}" alt="${state.imageAlt}" loading=lazy {
                    style {
                        position absolute
                        inset "0"
                        width "100%"
                        height "100%"
                        objectFit cover
                        display block
                    }
                }
            }
            div {
                style {
                    position absolute
                    right "-0.75rem"
                    bottom "-1rem"
                    display flex
                    alignItems center
                    gap "0.75rem"
                    padding "0.85rem 1.25rem"
                    backgroundColor "var(--color-primary)"
                    color "var(--color-text-white)"
                    borderRadius "1.1rem"
                    boxShadow "0 18px 34px -16px rgba(23,58,43,0.8)"
                }
                span "${state.signNumber}" {
                    style {
                        fontFamily "var(--font-display)"
                        fontSize "2rem"
                        fontWeight "700"
                        lineHeight "1"
                    }
                }
                span "${state.signLabel}" {
                    style {
                        fontSize "0.82rem"
                        fontWeight "700"
                        lineHeight "1.2"
                        maxWidth "12ch"
                        opacity "0.92"
                    }
                }
            }
        }
        div {
            style order="${state.reverse ? '1' : '2'}" {
                @--md order="2"
            }
            p "${state.eyebrow}" {
                style {
                    display "${state.eyebrow ? 'inline-flex' : 'none'}"
                    alignItems center
                    gap "0.5rem"
                    padding "0.35rem 0.9rem"
                    borderRadius "999px"
                    backgroundColor "var(--color-primary-soft)"
                    textTransform uppercase
                    letterSpacing "0.14em"
                    fontSize "0.75rem"
                    fontWeight "800"
                    color "var(--color-primary)"
                    margin "0 0 1.25rem"
                }
            }
            div {
                style {
                    fontSize "1.12rem"
                    lineHeight "1.8"
                    color "var(--color-text-secondary)"
                    fontWeight "500"
                    "& h3" {
                        fontFamily "var(--font-display)"
                        fontSize "clamp(1.8rem, 3.6vw, 2.5rem)"
                        fontWeight "600"
                        lineHeight "1.12"
                        letterSpacing "-0.01em"
                        color "var(--color-primary-deep)"
                        margin "0 0 1.1rem"
                    }
                    "& p" margin="0 0 1.1rem"
                    "& strong" color="var(--color-primary)" fontWeight="800"
                }
                slot
            }
        }
    }
}
