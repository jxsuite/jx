/- kdl-version 2

np-program-card {
    state {
        title ""
        summary ""
        tag Program
        href "/programs/"
        image type=string format=image default=""
    }
    style {
        display flex
        flexDirection column
        backgroundColor "var(--color-bg-white)"
        borderRadius "var(--radius-lg)"
        overflow hidden
        boxShadow "var(--shadow-card)"
        transition "transform 0.18s, box-shadow 0.18s"
        :hover transform="translateY(-5px)" boxShadow="var(--shadow-float)"
    }
    div {
        style position=relative aspectRatio="16 / 11" overflow=hidden
        img src="${state.image}" alt="${state.title}" loading=lazy {
            style {
                position absolute
                inset "0"
                width "100%"
                height "100%"
                objectFit cover
                display block
            }
        }
        span {
            style {
                position absolute
                left "1rem"
                top "1rem"
                display inline-flex
                alignItems center
                gap "0.4rem"
                padding "0.4rem 0.85rem"
                borderRadius "999px"
                backgroundColor "rgba(251,245,236,0.92)"
                backdropFilter "blur(4px)"
                fontSize "0.74rem"
                fontWeight "800"
                textTransform uppercase
                letterSpacing "0.08em"
                color "var(--color-primary)"
            }
            span 🌿 {
                style fontSize="0.8rem"
            }
            span "${state.tag}"
        }
    }
    div {
        style padding="1.6rem 1.6rem 1.75rem" display=flex flexDirection=column flex="1"
        h3 "${state.title}" {
            style {
                fontFamily "var(--font-display)"
                fontSize "1.5rem"
                fontWeight "600"
                lineHeight "1.15"
                color "var(--color-primary-deep)"
                margin "0 0 0.6rem"
            }
        }
        p "${state.summary}" {
            style {
                margin "0 0 1.35rem"
                color "var(--color-text-muted)"
                fontSize "1rem"
                fontWeight "600"
                lineHeight "1.65"
                flex "1"
            }
        }
        a href="${state.href}" {
            style {
                display inline-flex
                alignItems center
                gap "0.45rem"
                color "var(--color-accent)"
                fontWeight "800"
                fontSize "0.95rem"
                textDecoration none
                transition "gap 0.18s"
                :hover gap="0.85rem"
            }
            span "Learn more"
            span →
        }
    }
}
