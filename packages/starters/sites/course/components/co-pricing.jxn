/- kdl-version 2

co-pricing {
    state {
        badge ""
        plan "Full Program"
        price ""
        period ""
        description ""
        cta "Enroll Now"
        ctaHref "/enroll/"
        note ""
    }
    style {
        display block
        maxWidth "460px"
        margin "0 auto"
        backgroundColor "var(--color-bg-white)"
        border "1px solid var(--color-border-strong)"
        borderRadius "1rem"
        overflow hidden
        boxShadow "0 30px 70px -34px rgba(15,20,36,0.5)"
    }
    div {
        style {
            display "${state.badge ? 'flex' : 'none'}"
            alignItems center
            justifyContent center
            gap "0.5rem"
            backgroundColor "var(--color-primary)"
            color "var(--color-text-white)"
            padding "0.65rem 1rem"
            fontFamily "var(--font-mono)"
            fontSize "0.78rem"
            fontWeight "600"
            letterSpacing "0.02em"
        }
        span {
            style {
                width "0.45rem"
                height "0.45rem"
                borderRadius "999px"
                backgroundColor "var(--color-accent)"
            }
        }
        span "${state.badge}"
    }
    div {
        style padding="clamp(1.85rem, 4vw, 2.5rem)"
        div "${state.plan}" {
            style {
                fontFamily "var(--font-mono)"
                fontSize "0.8rem"
                fontWeight "600"
                textTransform uppercase
                letterSpacing "0.08em"
                color "var(--color-text-muted)"
                marginBottom "0.75rem"
            }
        }
        div {
            style display=flex alignItems=baseline gap="0.5rem" flexWrap=wrap
            span "${state.price}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "clamp(2.5rem, 6vw, 3.25rem)"
                    fontWeight "800"
                    letterSpacing "-0.03em"
                    lineHeight "1"
                    color "var(--color-text-primary)"
                }
            }
            span "${state.period}" {
                style {
                    display "${state.period ? 'inline' : 'none'}"
                    fontFamily "var(--font-mono)"
                    color "var(--color-text-muted)"
                    fontSize "0.9rem"
                    fontWeight "500"
                }
            }
        }
        p "${state.description}" {
            style {
                display "${state.description ? 'block' : 'none'}"
                margin "0.85rem 0 1.5rem"
                color "var(--color-text-muted)"
                fontSize "1rem"
                lineHeight "1.65"
            }
        }
        div {
            style {
                margin "0 0 1.75rem"
                paddingTop "1.5rem"
                borderTop "1px solid var(--color-border)"
                fontSize "0.98rem"
                lineHeight "1.6"
                "& ul" listStyle=none margin="0" padding="0"
                "& li" {
                    position relative
                    paddingLeft "1.7rem"
                    marginBottom "0.65rem"
                    color "var(--color-text-primary)"
                }
                "& li::before" {
                    content '✔'
                    position absolute
                    left "0"
                    top "0"
                    color "#65a30d"
                    fontWeight "700"
                    fontFamily "var(--font-mono)"
                }
            }
            slot
        }
        a href="${state.ctaHref}" "${state.cta}" {
            style {
                display block
                textAlign center
                backgroundColor "var(--color-primary)"
                color "var(--color-text-white)"
                padding "0.95rem 1.5rem"
                borderRadius "999px"
                fontSize "1.05rem"
                fontWeight "600"
                textDecoration none
                boxShadow "0 14px 30px -14px rgba(79,70,229,0.9)"
                transition "background-color 0.15s, transform 0.15s"
                :hover backgroundColor="var(--color-primary-hover)" transform="translateY(-1px)"
            }
        }
        p "${state.note}" {
            style {
                display "${state.note ? 'block' : 'none'}"
                margin "1rem 0 0"
                textAlign center
                fontFamily "var(--font-mono)"
                fontSize "0.78rem"
                color "var(--color-text-muted)"
            }
        }
    }
}
