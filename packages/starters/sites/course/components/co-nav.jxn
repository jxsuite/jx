/- kdl-version 2

co-nav {
    state brand="Craft & Code"
    style display=block position=sticky top="0" zIndex="50"
    div {
        style {
            backgroundColor "var(--color-ink)"
            color "var(--color-text-white)"
            borderBottom "1px solid var(--color-terminal-line)"
        }
        div {
            style {
                maxWidth "var(--max-width)"
                margin "0 auto"
                padding "0.5rem 1.5rem"
                display flex
                alignItems center
                justifyContent center
                gap "1rem"
                flexWrap wrap
                fontFamily "var(--font-mono)"
                fontSize "0.78rem"
                letterSpacing "0.01em"
            }
            span {
                style display=inline-flex alignItems=center gap="0.5rem"
                span {
                    style {
                        width "0.5rem"
                        height "0.5rem"
                        borderRadius "999px"
                        backgroundColor "var(--color-accent)"
                        boxShadow "0 0 0 3px rgba(163,230,53,0.2)"
                        flex none
                    }
                }
                span {
                    style color="rgba(255,255,255,0.92)"
                    span next_cohort {
                        style color="var(--color-accent)"
                    }
                    span " = " {
                        style color="rgba(255,255,255,0.5)"
                    }
                    span "Sept 8, 2026"
                }
            }
            span · {
                style color="var(--color-terminal-line)" {
                    @--sm display=none
                }
            }
            span "6 of 24 seats left" {
                style color="rgba(255,255,255,0.7)" {
                    @--sm display=none
                }
            }
            span · {
                style color="var(--color-terminal-line)" {
                    @--sm display=none
                }
            }
            a href="/enroll/" "apply →" {
                style color="var(--color-accent-cyan)" textDecoration=none fontWeight="600" {
                    :hover textDecoration=underline
                }
            }
        }
    }
    div {
        style {
            backgroundColor "rgba(255, 255, 255, 0.85)"
            backdropFilter "blur(10px)"
            borderBottom "1px solid var(--color-border)"
        }
        div {
            style {
                maxWidth "var(--max-width)"
                margin "0 auto"
                padding "0.85rem 1.5rem"
                display flex
                alignItems center
                justifyContent space-between
                gap "1.5rem"
            }
            a href="/" {
                style display=flex alignItems=center gap="0.65rem" textDecoration=none
                span "</>" {
                    style {
                        display inline-flex
                        alignItems center
                        justifyContent center
                        width "2rem"
                        height "2rem"
                        borderRadius "0.5rem"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        fontFamily "var(--font-mono)"
                        fontSize "0.85rem"
                        fontWeight "700"
                        boxShadow "0 6px 16px -6px rgba(79,70,229,0.7)"
                    }
                }
                span {
                    style {
                        fontFamily "var(--font-heading)"
                        fontSize "1.2rem"
                        fontWeight "800"
                        color "var(--color-text-primary)"
                        letterSpacing "-0.02em"
                    }
                    span "${state.brand}"
                    span " Academy" {
                        style color="var(--color-primary)"
                    }
                }
            }
            nav {
                style display=flex alignItems=center gap="1.9rem" {
                    @--sm gap="1rem"
                }
                a href="/curriculum/" Curriculum {
                    style {
                        fontFamily "var(--font-mono)"
                        textTransform uppercase
                        letterSpacing "0.08em"
                        color "var(--color-text-muted)"
                        textDecoration none
                        fontWeight "500"
                        fontSize "0.78rem"
                        @--sm display=none
                        :hover color="var(--color-primary)"
                    }
                }
                a href="/about/" About {
                    style {
                        fontFamily "var(--font-mono)"
                        textTransform uppercase
                        letterSpacing "0.08em"
                        color "var(--color-text-muted)"
                        textDecoration none
                        fontWeight "500"
                        fontSize "0.78rem"
                        @--sm display=none
                        :hover color="var(--color-primary)"
                    }
                }
                a href="/enroll/" Enroll {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.4rem"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        padding "0.55rem 1.3rem"
                        borderRadius "999px"
                        textDecoration none
                        fontWeight "600"
                        fontSize "0.9rem"
                        boxShadow "0 8px 20px -8px rgba(79,70,229,0.8)"
                        transition "transform 0.15s, background-color 0.15s"
                        :hover {
                            backgroundColor "var(--color-primary-hover)"
                            transform "translateY(-1px)"
                        }
                    }
                }
            }
        }
    }
}
