/- kdl-version 2

co-hero {
    state {
        eyebrow ""
        heading ""
        headingAccent ""
        subheading ""
        cta "Enroll Now"
        ctaHref "/enroll/"
        cta2 ""
        cta2Href "/curriculum/"
        note ""
        o1 ""
        o2 ""
        o3 ""
    }
    style {
        display block
        position relative
        overflow hidden
        backgroundColor "var(--color-bg-white)"
        backgroundImage "radial-gradient(ellipse 45% 50% at 88% 0%, rgba(79,70,229,0.12), transparent 60%), radial-gradient(ellipse 40% 45% at 5% 95%, rgba(34,211,238,0.08), transparent 60%)"
    }
    div {
        style {
            position absolute
            inset "0"
            backgroundImage "radial-gradient(circle, rgba(15,20,36,0.05) 1px, transparent 1px)"
            backgroundSize "30px 30px"
            opacity "0.6"
            pointerEvents none
        }
    }
    div {
        style {
            position relative
            zIndex "2"
            maxWidth "var(--max-width)"
            margin "0 auto"
            padding "clamp(3rem, 7vw, 5.5rem) 1.5rem clamp(3.5rem, 7vw, 6rem)"
            display grid
            gridTemplateColumns "1.02fr 0.98fr"
            gap "clamp(2.5rem, 5vw, 4.5rem)"
            alignItems center
            @--lg gridTemplateColumns="1fr" gap="3rem"
        }
        div {
            p {
                style {
                    display "${state.eyebrow ? 'inline-flex' : 'none'}"
                    alignItems center
                    gap "0.55rem"
                    fontFamily "var(--font-mono)"
                    fontSize "0.8rem"
                    fontWeight "600"
                    color "var(--color-primary)"
                    backgroundColor "var(--color-indigo-050)"
                    border "1px solid var(--color-indigo-line)"
                    padding "0.4rem 0.85rem"
                    borderRadius "999px"
                    margin "0 0 1.5rem"
                }
                span {
                    style {
                        width "0.45rem"
                        height "0.45rem"
                        borderRadius "999px"
                        backgroundColor "var(--color-accent)"
                        boxShadow "0 0 0 3px rgba(163,230,53,0.25)"
                    }
                }
                span "${state.eyebrow}"
            }
            h1 {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "clamp(2.4rem, 5.4vw, 4rem)"
                    fontWeight "800"
                    lineHeight "1.04"
                    letterSpacing "-0.035em"
                    margin "0 0 1.35rem"
                    color "var(--color-text-primary)"
                }
                span "${state.heading} "
                span {
                    style position=relative color="var(--color-primary)" whiteSpace=nowrap
                    span "${state.headingAccent}"
                }
            }
            p "${state.subheading}" {
                style {
                    fontSize "clamp(1.05rem, 1.6vw, 1.22rem)"
                    lineHeight "1.6"
                    color "var(--color-text-muted)"
                    margin "0 0 1.85rem"
                    maxWidth "50ch"
                }
            }
            div {
                style display=flex gap="0.75rem" flexWrap=wrap marginBottom="1.65rem"
                a href="${state.ctaHref}" "${state.cta}" {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.5rem"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        padding "0.9rem 1.9rem"
                        borderRadius "999px"
                        fontSize "1.02rem"
                        fontWeight "600"
                        textDecoration none
                        boxShadow "0 14px 30px -12px rgba(79,70,229,0.9)"
                        transition "transform 0.15s, background-color 0.15s"
                        :hover {
                            backgroundColor "var(--color-primary-hover)"
                            transform "translateY(-2px)"
                        }
                    }
                }
                a href="${state.cta2Href}" "${state.cta2}" {
                    style {
                        display "${state.cta2 ? 'inline-flex' : 'none'}"
                        alignItems center
                        gap "0.5rem"
                        border "1px solid var(--color-border-strong)"
                        backgroundColor "var(--color-bg-white)"
                        color "var(--color-text-primary)"
                        padding "0.9rem 1.7rem"
                        borderRadius "999px"
                        fontSize "1.02rem"
                        fontWeight "600"
                        textDecoration none
                        transition "border-color 0.15s, color 0.15s"
                        :hover borderColor="var(--color-primary)" color="var(--color-primary)"
                    }
                }
            }
            div {
                style {
                    display "${state.o1 ? 'flex' : 'none'}"
                    flexWrap wrap
                    gap "0.55rem"
                    marginBottom "1.35rem"
                }
                span {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.45rem"
                        fontFamily "var(--font-mono)"
                        fontSize "0.8rem"
                        fontWeight "500"
                        color "var(--color-text-primary)"
                        backgroundColor "var(--color-bg-cream)"
                        border "1px solid var(--color-border)"
                        padding "0.4rem 0.8rem"
                        borderRadius "0.5rem"
                    }
                    span ✔ {
                        style color="#65a30d" fontWeight="700"
                    }
                    span "${state.o1}"
                }
                span {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.45rem"
                        fontFamily "var(--font-mono)"
                        fontSize "0.8rem"
                        fontWeight "500"
                        color "var(--color-text-primary)"
                        backgroundColor "var(--color-bg-cream)"
                        border "1px solid var(--color-border)"
                        padding "0.4rem 0.8rem"
                        borderRadius "0.5rem"
                    }
                    span ✔ {
                        style color="#65a30d" fontWeight="700"
                    }
                    span "${state.o2}"
                }
                span {
                    style {
                        display inline-flex
                        alignItems center
                        gap "0.45rem"
                        fontFamily "var(--font-mono)"
                        fontSize "0.8rem"
                        fontWeight "500"
                        color "var(--color-text-primary)"
                        backgroundColor "var(--color-bg-cream)"
                        border "1px solid var(--color-border)"
                        padding "0.4rem 0.8rem"
                        borderRadius "0.5rem"
                    }
                    span ✔ {
                        style color="#65a30d" fontWeight="700"
                    }
                    span "${state.o3}"
                }
            }
            p {
                style {
                    display "${state.note ? 'flex' : 'none'}"
                    alignItems center
                    gap "0.5rem"
                    margin "0"
                    fontFamily "var(--font-mono)"
                    fontSize "0.82rem"
                    color "var(--color-text-muted)"
                }
                span ▸ {
                    style color="var(--color-primary)"
                }
                span "${state.note}"
            }
        }
        div {
            style position=relative
            div {
                style {
                    position absolute
                    inset "-12% -8% -14% -8%"
                    background "radial-gradient(circle at 60% 40%, rgba(79,70,229,0.28), transparent 65%)"
                    filter "blur(12px)"
                    pointerEvents none
                }
            }
            div {
                style {
                    position relative
                    borderRadius "0.9rem"
                    overflow hidden
                    backgroundColor "var(--color-terminal)"
                    border "1px solid var(--color-terminal-line)"
                    boxShadow "0 40px 80px -32px rgba(11,16,32,0.75)"
                }
                div {
                    style {
                        display flex
                        alignItems center
                        gap "0.5rem"
                        padding "0.75rem 1rem"
                        borderBottom "1px solid var(--color-terminal-line)"
                        backgroundColor "var(--color-terminal-2)"
                    }
                    span {
                        style {
                            width "0.72rem"
                            height "0.72rem"
                            borderRadius "999px"
                            backgroundColor "#ff5f57"
                        }
                    }
                    span {
                        style {
                            width "0.72rem"
                            height "0.72rem"
                            borderRadius "999px"
                            backgroundColor "#febc2e"
                        }
                    }
                    span {
                        style {
                            width "0.72rem"
                            height "0.72rem"
                            borderRadius "999px"
                            backgroundColor "#28c840"
                        }
                    }
                    span "~/craft-code — start-here.sh" {
                        style {
                            marginLeft "0.75rem"
                            fontFamily "var(--font-mono)"
                            fontSize "0.75rem"
                            color "var(--color-text-faint)"
                        }
                    }
                }
                div {
                    style {
                        padding "1.35rem 1.5rem 1.6rem"
                        fontFamily "var(--font-mono)"
                        fontSize "0.9rem"
                        lineHeight "2"
                        color "rgba(255,255,255,0.92)"
                    }
                    div {
                        span "$ " {
                            style color="var(--color-accent)"
                        }
                        span "enroll "
                        span "--track " {
                            style color="var(--color-accent-cyan)"
                        }
                        span web-dev {
                            style color="#fcd34d"
                        }
                    }
                    div "# 14 weeks · 6 guided modules · live cohort" {
                        style color="var(--color-text-faint)"
                    }
                    div {
                        span "✔ " {
                            style color="var(--color-accent)" fontWeight="700"
                        }
                        span "mentorship + small-group code review"
                    }
                    div {
                        span "✔ " {
                            style color="var(--color-accent)" fontWeight="700"
                        }
                        span "build real, portfolio-ready projects"
                    }
                    div {
                        span "✔ " {
                            style color="var(--color-accent)" fontWeight="700"
                        }
                        span "deploy a full-stack capstone"
                    }
                    div {
                        style marginTop="0.35rem"
                        span "$ " {
                            style color="var(--color-accent)"
                        }
                        span "./ship-your-career.sh"
                    }
                    div {
                        style display=flex alignItems=center gap="0.4rem"
                        span → {
                            style color="var(--color-primary-light)"
                        }
                        span "92% hired within 6 months" {
                            style color="#ffffff" fontWeight="600"
                        }
                        span {
                            style {
                                display inline-block
                                width "0.62rem"
                                height "1.15rem"
                                backgroundColor "var(--color-accent)"
                                marginLeft "0.15rem"
                                borderRadius "1px"
                            }
                        }
                    }
                }
            }
        }
    }
}
