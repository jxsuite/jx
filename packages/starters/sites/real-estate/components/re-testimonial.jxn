/- kdl-version 2

re-testimonial {
    state quote="" author="" role=""
    style {
        display flex
        flexDirection column
        padding "1.85rem"
        backgroundColor "var(--color-bg-white)"
        border "1px solid var(--color-border)"
        borderRadius "var(--radius)"
        boxShadow "var(--shadow-card)"
    }
    div ★★★★★ {
        style {
            color "var(--color-accent-bright)"
            fontSize "0.95rem"
            marginBottom "1rem"
            letterSpacing "0.14em"
        }
    }
    p "“${state.quote}”" {
        style {
            fontFamily "var(--font-display)"
            fontStyle italic
            fontSize "1.2rem"
            lineHeight "1.5"
            fontWeight "400"
            color "var(--color-text-primary)"
            margin "0 0 1.5rem"
            flex "1"
        }
    }
    div {
        style {
            display flex
            alignItems center
            gap "0.75rem"
            paddingTop "1.1rem"
            borderTop "1px solid var(--color-border)"
        }
        div "${state.author.charAt(0)}" {
            style {
                display flex
                alignItems center
                justifyContent center
                width "2.5rem"
                height "2.5rem"
                borderRadius "999px"
                backgroundColor "var(--color-teal-tint)"
                color "var(--color-primary)"
                fontFamily "var(--font-heading)"
                fontWeight "800"
                fontSize "1rem"
            }
        }
        div {
            div "${state.author}" {
                style fontWeight="700" fontSize="0.95rem"
            }
            div "${state.role}" {
                style fontSize="0.85rem" color="var(--color-text-muted)" fontWeight="500"
            }
        }
    }
}
