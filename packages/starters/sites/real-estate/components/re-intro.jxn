/- kdl-version 2

re-intro {
    state {
        image type=string format=image default=""
        imageAlt ""
        reverse #false
    }
    style display=block padding="clamp(3.5rem, 8vw, 6rem) 1.5rem"
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "1fr 1fr"
            gap "clamp(2rem, 5vw, 4rem)"
            alignItems center
            @--md gridTemplateColumns="1fr"
        }
        div {
            style order="${state.reverse ? '2' : '1'}" position=relative
            img src="${state.image}" alt="${state.imageAlt}" loading=lazy {
                style {
                    width "100%"
                    height auto
                    borderRadius "var(--radius-lg)"
                    display block
                    border "1px solid var(--color-border)"
                    boxShadow "var(--shadow-card)"
                }
            }
        }
        div {
            style {
                order "${state.reverse ? '1' : '2'}"
                fontSize "1.08rem"
                lineHeight "1.75"
                color "var(--color-text-secondary)"
            }
            slot
        }
    }
}
