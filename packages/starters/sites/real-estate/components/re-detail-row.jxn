/- kdl-version 2

re-detail-row {
    state label="" value=""
    style {
        display flex
        justifyContent space-between
        gap "1rem"
        padding "0.55rem 0"
        borderTop "1px solid rgba(255, 255, 255, 0.15)"
    }
    span "${state.label}" {
        style fontWeight="600"
    }
    span "${state.value}" {
        style opacity="0.8"
    }
}
