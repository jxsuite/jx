/- kdl-version 2

re-listing-card {
    state {
        heading ""
        price "0"
        beds "0"
        baths "0"
        sqft "0"
        city ""
        status "For Sale"
        image type=string format=image default=""
        href "#"
    }
    style {
        display block
        backgroundColor "var(--color-bg-white)"
        border "1px solid var(--color-border)"
        borderRadius "var(--radius)"
        overflow hidden
        boxShadow "var(--shadow-card)"
        transition "transform 0.2s, box-shadow 0.2s, border-color 0.2s"
        :hover {
            transform "translateY(-4px)"
            boxShadow "0 18px 40px -18px rgba(15,23,42,0.28)"
            borderColor "var(--color-border-strong)"
        }
        ":hover img" transform="scale(1.05)"
    }
    a href="${state.href}" {
        style {
            display block
            position relative
            overflow hidden
            textDecoration none
            aspectRatio "3 / 2"
            backgroundColor "var(--color-bg-tint)"
        }
        img src="${state.image}" alt="${state.heading}" loading=lazy {
            style {
                position absolute
                inset "0"
                width "100%"
                height "100%"
                objectFit cover
                display block
                transition "transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)"
            }
        }
        span {
            style {
                position absolute
                top "0.85rem"
                left "0.85rem"
                display inline-flex
                alignItems center
                gap "0.35rem"
                backgroundColor "${state.status === 'New' ? 'var(--color-status-new)' : 'rgba(11,18,32,0.82)'}"
                color "var(--color-text-white)"
                fontWeight "700"
                fontSize "0.72rem"
                letterSpacing "0.04em"
                textTransform uppercase
                padding "0.3rem 0.65rem"
                borderRadius "999px"
                backdropFilter "blur(4px)"
            }
            span {
                style {
                    width "0.4rem"
                    height "0.4rem"
                    borderRadius "999px"
                    backgroundColor "var(--color-accent-bright)"
                }
            }
            span "${state.status}"
        }
        span ♡ {
            style {
                position absolute
                top "0.85rem"
                right "0.85rem"
                display inline-flex
                alignItems center
                justifyContent center
                width "2rem"
                height "2rem"
                borderRadius "999px"
                backgroundColor "rgba(255,255,255,0.92)"
                color "var(--color-text-secondary)"
                fontSize "0.95rem"
                boxShadow "0 2px 8px rgba(15,23,42,0.18)"
            }
        }
    }
    div {
        style padding="1.1rem 1.25rem 1.3rem"
        div {
            style {
                display flex
                alignItems baseline
                justifyContent space-between
                gap "0.75rem"
                marginBottom "0.35rem"
            }
            div "$${Number(state.price).toLocaleString('en-US')}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.5rem"
                    fontWeight "800"
                    letterSpacing "-0.02em"
                    color "var(--color-text-primary)"
                    fontVariantNumeric tabular-nums
                }
            }
            div "${state.sqft && Number(state.sqft) > 0 ? '$' + Math.round(Number(state.price)/Number(state.sqft)).toLocaleString('en-US') + '/sqft' : ''}" {
                style {
                    fontSize "0.78rem"
                    fontWeight "600"
                    color "var(--color-text-muted)"
                    whiteSpace nowrap
                    fontVariantNumeric tabular-nums
                }
            }
        }
        a href="${state.href}" {
            style textDecoration=none color="var(--color-text-primary)"
            h3 "${state.heading}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "1.05rem"
                    fontWeight "700"
                    margin "0 0 0.25rem"
                    letterSpacing "-0.01em"
                }
            }
        }
        p {
            style {
                display flex
                alignItems center
                gap "0.3rem"
                margin "0 0 0.9rem"
                color "var(--color-text-muted)"
                fontSize "0.88rem"
                fontWeight "500"
            }
            span 📍 {
                style fontSize="0.8rem"
            }
            span "${state.city}"
        }
        div {
            style {
                display flex
                alignItems center
                paddingTop "0.85rem"
                borderTop "1px solid var(--color-border)"
            }
            div {
                style flex="1" textAlign=center
                div "${state.beds}" {
                    style {
                        fontWeight "800"
                        fontSize "0.98rem"
                        color "var(--color-text-primary)"
                        fontVariantNumeric tabular-nums
                    }
                }
                div beds {
                    style fontSize="0.72rem" color="var(--color-text-muted)" fontWeight="600"
                }
            }
            div {
                style width="1px" alignSelf=stretch backgroundColor="var(--color-border)"
            }
            div {
                style flex="1" textAlign=center
                div "${state.baths}" {
                    style {
                        fontWeight "800"
                        fontSize "0.98rem"
                        color "var(--color-text-primary)"
                        fontVariantNumeric tabular-nums
                    }
                }
                div baths {
                    style fontSize="0.72rem" color="var(--color-text-muted)" fontWeight="600"
                }
            }
            div {
                style width="1px" alignSelf=stretch backgroundColor="var(--color-border)"
            }
            div {
                style flex="1" textAlign=center
                div "${Number(state.sqft).toLocaleString('en-US')}" {
                    style {
                        fontWeight "800"
                        fontSize "0.98rem"
                        color "var(--color-text-primary)"
                        fontVariantNumeric tabular-nums
                    }
                }
                div sqft {
                    style fontSize="0.72rem" color="var(--color-text-muted)" fontWeight="600"
                }
            }
        }
    }
}
