/- kdl-version 2

bit-review {
    state quote="" author="" role=""
    style display=block
    div “ {
        style {
            fontFamily "var(--font-heading)"
            fontSize "4.5rem"
            lineHeight "0.6"
            fontWeight "700"
            color "var(--color-primary)"
            marginBottom "1rem"
            height "2rem"
        }
    }
    p "${state.quote}" {
        style {
            fontFamily "var(--font-heading)"
            fontSize "clamp(1.5rem, 3vw, 2.15rem)"
            fontStyle italic
            fontWeight "400"
            lineHeight "1.35"
            letterSpacing "-0.01em"
            margin "0 0 1.75rem"
            color "var(--color-text-primary)"
        }
    }
    div {
        style display=flex alignItems=center gap="0.85rem"
        span {
            style width="2rem" height="1px" backgroundColor="var(--color-primary)"
        }
        div {
            div "${state.author}" {
                style {
                    fontFamily "var(--font-body)"
                    fontWeight "700"
                    fontSize "0.85rem"
                    textTransform uppercase
                    letterSpacing "0.1em"
                    color "var(--color-text-primary)"
                }
            }
            div "${state.role}" {
                style {
                    fontFamily "var(--font-body)"
                    fontSize "0.85rem"
                    color "var(--color-text-muted)"
                }
            }
        }
    }
}
