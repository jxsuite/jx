/- kdl-version 2

bit-nav {
    state brand="Bistro & Café" status="Open today · 8am – 3pm" place="128 Market St · Riverbend"
    style display=block position=sticky top="0" zIndex="50"
    div {
        style backgroundColor="var(--color-espresso)" color="var(--color-text-white)"
        div {
            style {
                maxWidth "var(--max-width-wide)"
                margin "0 auto"
                padding "0.42rem 1.5rem"
                display flex
                alignItems center
                justifyContent center
                gap "0.9rem"
                fontFamily "var(--font-body)"
                fontSize "0.72rem"
                fontWeight "600"
                textTransform uppercase
                letterSpacing "0.18em"
            }
            span {
                style display=inline-flex alignItems=center gap="0.5rem" color="var(--color-amber)"
                span {
                    style {
                        width "0.42rem"
                        height "0.42rem"
                        borderRadius "999px"
                        backgroundColor "var(--color-amber)"
                        boxShadow "0 0 0 3px rgba(201,138,60,0.25)"
                    }
                }
                span "${state.status}"
            }
            span — {
                style opacity="0.35" {
                    @--sm display=none
                }
            }
            span "${state.place}" {
                style opacity="0.72" {
                    @--sm display=none
                }
            }
        }
    }
    div {
        style {
            backgroundColor "rgba(246,236,219,0.9)"
            backdropFilter "blur(8px)"
            borderBottom "1px solid var(--color-border)"
        }
        div {
            style {
                maxWidth "var(--max-width-wide)"
                margin "0 auto"
                padding "0.85rem 1.5rem"
                display grid
                gridTemplateColumns "1fr auto 1fr"
                alignItems center
                gap "1rem"
            }
            nav {
                style {
                    display flex
                    alignItems center
                    gap "1.75rem"
                    fontFamily "var(--font-body)"
                    fontSize "0.76rem"
                    fontWeight "700"
                    textTransform uppercase
                    letterSpacing "0.16em"
                    @--sm gap="1.1rem"
                }
                a href="/menu/" Menu {
                    style {
                        color "var(--color-text-primary)"
                        textDecoration none
                        transition "color 0.15s"
                        :hover color="var(--color-primary)"
                    }
                }
                a href="/about/" Story {
                    style {
                        color "var(--color-text-primary)"
                        textDecoration none
                        transition "color 0.15s"
                        @--sm display=none
                        :hover color="var(--color-primary)"
                    }
                }
            }
            a href="/" "${state.brand}" {
                style {
                    justifySelf center
                    textAlign center
                    fontFamily "var(--font-heading)"
                    fontSize "clamp(1.35rem, 3.5vw, 1.85rem)"
                    fontWeight "700"
                    color "var(--color-text-primary)"
                    textDecoration none
                    letterSpacing "-0.01em"
                    lineHeight "1"
                    whiteSpace nowrap
                }
            }
            nav {
                style justifySelf=end display=flex alignItems=center gap="1.5rem"
                a href="/contact/" Visit {
                    style {
                        fontFamily "var(--font-body)"
                        fontSize "0.76rem"
                        fontWeight "700"
                        textTransform uppercase
                        letterSpacing "0.16em"
                        color "var(--color-text-primary)"
                        textDecoration none
                        transition "color 0.15s"
                        @--md display=none
                        :hover color="var(--color-primary)"
                    }
                }
                a href="/contact/" Reserve {
                    style {
                        display inline-block
                        border "1px solid var(--color-primary)"
                        backgroundColor "var(--color-primary)"
                        color "var(--color-text-white)"
                        padding "0.5rem 1.25rem"
                        borderRadius "999px"
                        textDecoration none
                        fontFamily "var(--font-body)"
                        fontWeight "700"
                        fontSize "0.76rem"
                        textTransform uppercase
                        letterSpacing "0.14em"
                        transition "background-color 0.15s, color 0.15s"
                        :hover backgroundColor=transparent color="var(--color-primary)"
                    }
                }
            }
        }
    }
}
