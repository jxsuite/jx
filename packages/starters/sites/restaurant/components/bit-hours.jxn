/- kdl-version 2

bit-hours {
    state {
        heading Hours
        status "Open today"
        weekdays "7:00am – 3:00pm"
        saturday "8:00am – 4:00pm"
        sunday "8:00am – 2:00pm"
        note "Kitchen closes 30 minutes before close."
    }
    style {
        display block
        backgroundColor "var(--color-espresso)"
        color "var(--color-text-white)"
        borderRadius "var(--radius)"
        padding "clamp(1.75rem, 3vw, 2.5rem)"
    }
    div {
        style {
            display flex
            alignItems center
            justifyContent space-between
            gap "1rem"
            marginBottom "1.5rem"
        }
        h3 "${state.heading}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.65rem"
                fontWeight "700"
                margin "0"
                color "var(--color-text-white)"
            }
        }
        span {
            style {
                display inline-flex
                alignItems center
                gap "0.5rem"
                padding "0.35rem 0.85rem"
                borderRadius "999px"
                border "1px solid rgba(201,138,60,0.5)"
                fontFamily "var(--font-body)"
                fontSize "0.68rem"
                fontWeight "700"
                textTransform uppercase
                letterSpacing "0.14em"
                color "var(--color-amber)"
            }
            span {
                style {
                    width "0.45rem"
                    height "0.45rem"
                    borderRadius "999px"
                    backgroundColor "var(--color-amber)"
                    boxShadow "0 0 0 3px rgba(201,138,60,0.22)"
                }
            }
            span "${state.status}"
        }
    }
    div {
        style {
            display flex
            justifyContent space-between
            alignItems baseline
            padding "0.7rem 0"
            borderBottom "1px solid rgba(246,236,219,0.14)"
        }
        span "Mon – Fri" {
            style {
                fontFamily "var(--font-body)"
                fontSize "0.78rem"
                fontWeight "700"
                textTransform uppercase
                letterSpacing "0.12em"
                opacity "0.75"
            }
        }
        span "${state.weekdays}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.15rem"
                color "var(--color-text-white)"
            }
        }
    }
    div {
        style {
            display flex
            justifyContent space-between
            alignItems baseline
            padding "0.7rem 0"
            borderBottom "1px solid rgba(246,236,219,0.14)"
        }
        span Saturday {
            style {
                fontFamily "var(--font-body)"
                fontSize "0.78rem"
                fontWeight "700"
                textTransform uppercase
                letterSpacing "0.12em"
                opacity "0.75"
            }
        }
        span "${state.saturday}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.15rem"
                color "var(--color-text-white)"
            }
        }
    }
    div {
        style display=flex justifyContent=space-between alignItems=baseline padding="0.7rem 0"
        span Sunday {
            style {
                fontFamily "var(--font-body)"
                fontSize "0.78rem"
                fontWeight "700"
                textTransform uppercase
                letterSpacing "0.12em"
                opacity "0.75"
            }
        }
        span "${state.sunday}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.15rem"
                color "var(--color-text-white)"
            }
        }
    }
    p "${state.note}" {
        style {
            display "${state.note ? 'block' : 'none'}"
            margin "1.5rem 0 0"
            fontFamily "var(--font-heading)"
            fontStyle italic
            fontSize "0.95rem"
            opacity "0.6"
        }
    }
}
