/- kdl-version 2

bit-footer {
    state {
        brand "Bistro & Café"
        tagline "Seasonal plates, house pastries, and small-batch coffee — served in a warm room just off Market Street."
        address1 "128 Market Street"
        address2 "Riverbend, CA 90210"
        phone "(555) 018-2340"
    }
    style {
        display block
        backgroundColor "var(--color-espresso)"
        color "var(--color-text-white)"
        padding "clamp(3.5rem, 7vw, 5rem) 1.5rem 2.25rem"
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "0 auto"
            display grid
            gridTemplateColumns "1.6fr 1fr 1fr"
            gap "clamp(2rem, 5vw, 3.5rem)"
            @--md gridTemplateColumns="1fr" gap="2.25rem"
        }
        div {
            div "${state.brand}" {
                style {
                    fontFamily "var(--font-heading)"
                    fontSize "2rem"
                    fontWeight "700"
                    letterSpacing "-0.01em"
                    marginBottom "1rem"
                }
            }
            p "${state.tagline}" {
                style {
                    margin "0"
                    fontFamily "var(--font-body)"
                    opacity "0.68"
                    maxWidth "38ch"
                    lineHeight "1.7"
                }
            }
        }
        div {
            div Visit {
                style {
                    fontFamily "var(--font-body)"
                    textTransform uppercase
                    letterSpacing "0.16em"
                    fontSize "0.72rem"
                    fontWeight "700"
                    color "var(--color-amber)"
                    marginBottom "1rem"
                }
            }
            p "${state.address1}" {
                style margin="0 0 0.35rem" opacity="0.82"
            }
            p "${state.address2}" {
                style margin="0 0 0.75rem" opacity="0.82"
            }
            a href=tel:+15550182340 "${state.phone}" {
                style {
                    color "var(--color-text-white)"
                    opacity "0.82"
                    textDecoration none
                    borderBottom "1px solid rgba(246,236,219,0.25)"
                    paddingBottom "0.1rem"
                }
            }
        }
        div {
            div Explore {
                style {
                    fontFamily "var(--font-body)"
                    textTransform uppercase
                    letterSpacing "0.16em"
                    fontSize "0.72rem"
                    fontWeight "700"
                    color "var(--color-amber)"
                    marginBottom "1rem"
                }
            }
            a href="/menu/" "The Menu" {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.82"
                    textDecoration none
                    marginBottom "0.5rem"
                    transition "opacity 0.15s"
                    :hover opacity="1"
                }
            }
            a href="/about/" "Our Story" {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.82"
                    textDecoration none
                    marginBottom "0.5rem"
                    transition "opacity 0.15s"
                    :hover opacity="1"
                }
            }
            a href="/contact/" Reservations {
                style {
                    display block
                    color "var(--color-text-white)"
                    opacity "0.82"
                    textDecoration none
                    transition "opacity 0.15s"
                    :hover opacity="1"
                }
            }
        }
    }
    div {
        style {
            maxWidth "var(--max-width)"
            margin "clamp(2.5rem, 5vw, 3.5rem) auto 0"
            paddingTop "1.5rem"
            borderTop "1px solid rgba(246,236,219,0.15)"
            display flex
            justifyContent space-between
            alignItems center
            gap "1rem"
            flexWrap wrap
            fontFamily "var(--font-body)"
            fontSize "0.8rem"
            opacity "0.55"
        }
        p "© Bistro & Café. Built with Jx." {
            style margin="0"
        }
        p "Set in Playfair Display & Mulish" {
            style margin="0" textTransform=uppercase letterSpacing="0.14em" fontSize="0.7rem"
        }
    }
}
