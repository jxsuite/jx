/- kdl-version 2

bl-tag-pill {
    state label=""
    style display=inline-flex alignItems=center gap="0.5rem"
    span {
        style width="1.6rem" height="1px" backgroundColor="var(--color-primary)"
    }
    span "${state.label}" {
        style {
            fontFamily "var(--font-body)"
            fontSize "0.74rem"
            fontWeight "600"
            textTransform uppercase
            letterSpacing "0.18em"
            color "var(--color-primary)"
        }
    }
}
