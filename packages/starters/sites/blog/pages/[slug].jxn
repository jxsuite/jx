/- kdl-version 2
$layout "./layouts/post.jxn"
$paths contentType=posts param=slug field=id
$head {
    meta name=description content="${state.entry.data.excerpt}"
}

$element .title="${state.entry.data.title} — The Long Field" {
    state {
        entry {
            $prototype ContentEntry
            contentType posts
            field id
            id (ref)"#/$params/slug"
            $src "@jxsuite/parser/ContentEntry.class.json"
        }
    }
    a href="/" "← All writing" {
        style {
            display inline-flex
            alignItems center
            gap "0.4rem"
            color "var(--color-primary)"
            textDecoration none
            fontWeight "600"
            fontSize "0.95rem"
            marginBottom "2rem"
            :hover textDecoration=underline
        }
    }
    header {
        style marginBottom="2rem"
        div {
            style marginBottom="1.1rem"
            bl-tag-pill {
                $props label="${state.entry.data.tag}"
            }
        }
        h1 "${state.entry.data.title}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "clamp(2.1rem, 5vw, 3.2rem)"
                fontWeight "600"
                lineHeight "1.1"
                letterSpacing "-0.02em"
                margin "0 0 1rem"
                color "var(--color-text-primary)"
            }
        }
        p "${state.entry.data.excerpt}" {
            style {
                fontFamily "var(--font-heading)"
                fontSize "1.35rem"
                lineHeight "1.5"
                color "var(--color-text-muted)"
                fontStyle italic
                margin "0 0 1.5rem"
            }
        }
        div {
            style {
                display flex
                alignItems center
                gap "0.6rem"
                fontSize "0.9rem"
                textTransform uppercase
                letterSpacing "0.06em"
                color "var(--color-text-muted)"
                borderTop "1px solid var(--color-border)"
                paddingTop "1.25rem"
            }
            span "${state.entry.data.author}" {
                style fontWeight="600" color="var(--color-text-primary)"
            }
            span ·
            span "${state.entry.data.date}"
        }
    }
    img src="${state.entry.data.cover}" alt="${state.entry.data.title}" loading=lazy {
        style {
            width "100%"
            aspectRatio "16 / 9"
            objectFit cover
            borderRadius "var(--radius)"
            marginBottom "2.5rem"
            display "${state.entry.data.cover ? 'block' : 'none'}"
        }
    }
    bl-prose {
        .children "${state.entry.$children}"
    }
    hr {
        style border=none borderTop="1px solid var(--color-border)" margin="3rem 0 2.5rem"
    }
    bl-author-bio {
        $props {
            name "${state.entry.data.author}"
            role "Writer & editor"
            bio "Marren Oda writes The Long Field — slow essays on design, technology, and the craft of making things well."
            avatar "/images/author.jpg"
        }
    }
    div {
        style marginTop="2.5rem"
        bl-newsletter-cta
    }
}
