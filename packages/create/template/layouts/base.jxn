/- kdl-version 2

div {
    style {
        margin "0"
        padding "0"
        minHeight "100vh"
        display flex
        flexDirection column
        fontFamily "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        lineHeight "1.6"
        color "#1a1a1a"
    }
    header {
        style padding="1rem 2rem" borderBottom="1px solid #e5e5e5"
        a href="/" {
            style textDecoration=none fontSize="1.25rem" fontWeight="700" color="#1a1a1a"
            - "My Site"
        }
    }
    main {
        style flex="1" maxWidth="800px" margin="0 auto" padding="2rem" width="100%"
        slot
    }
    footer {
        style {
            padding "1.5rem 2rem"
            borderTop "1px solid #e5e5e5"
            textAlign center
            fontSize "0.875rem"
            color "#666"
        }
        p {
            style margin="0"
            - "Built with Jx"
        }
    }
}
