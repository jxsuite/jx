{
  "children": [
    {
      "attributes": {
        "onclick": {
          "$ref": "#/state/spook"
        }
      },
      "tagName": "button",
      "textContent": "?"
    },
    {
      "tagName": "span",
      "textContent": "${state.n}"
    }
  ],
  "state": {
    "n": 0,
    "spook": {
      "$prototype": "Function",
      "$src": "./ghost-helpers.js",
      "parameters": ["state"]
    }
  },
  "tagName": "ghost-widget"
}
