{
  "name": "@jxsuite/erase",
  "version": "0.1.0",
  "description": "Erases TypeScript from Jx function bodies, so every tier that analyses or runs one sees JavaScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/erase"
  },
  "files": [
    "src/"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
