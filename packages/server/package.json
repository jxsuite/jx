{
  "name": "@jxsuite/server",
  "version": "7.0.0",
  "description": "Jx development server with live reload, server-side proxy, and studio integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/server"
  },
  "files": [
    "src/"
  ],
  "type": "module",
  "imports": {
    "#serve": {
      "bun": "./src/serve.bun.ts",
      "default": "./src/serve.node.ts"
    }
  },
  "exports": {
    ".": "./src/server.ts",
    "./dev": "./src/dev.ts",
    "./ai-api": "./src/ai-api.ts",
    "./data": "./src/data-api.ts",
    "./import-api": "./src/import-api.ts",
    "./catalog": "./src/extension-catalog.ts",
    "./packages": "./src/packages.ts",
    "./project-server": "./src/project-server.ts",
    "./oauth-loopback": "./src/oauth-loopback.ts",
    "./net-guard": "./src/net-guard.ts",
    "./live-preview": "./src/live-preview.ts",
    "./site-preview": "./src/site-preview.ts",
    "./refactor": "./src/refactor/index.ts",
    "./resolve": "./src/resolve.ts",
    "./types": "./src/types.ts",
    "./jx-mounts": "./src/jx-mounts.ts",
    "./dev-vars": "./src/dev-vars.ts",
    "./fs-glob": "./src/fs-glob.ts",
    "./serve": {
      "bun": "./src/serve.bun.ts",
      "default": "./src/serve.node.ts"
    },
    "./file-response": "./src/file-response.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "lint:errors": "bun run scripts/check-error-shapes.ts",
    "test": "bun run lint:errors && bun test --isolate",
    "test:coverage": "bun run lint:errors && bun test --isolate --coverage",
    "upgrade": "bun update --latest && bun install"
  },
  "dependencies": {
    "@jxsuite/ai": "workspace:^",
    "@jxsuite/catalog": "workspace:^",
    "@jxsuite/collab": "workspace:^",
    "@jxsuite/compiler": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/import": "workspace:^",
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/runtime": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/site": "workspace:^",
    "@jxsuite/starters": "workspace:^",
    "@npmcli/arborist": "^10.0.4",
    "chokidar": "^6.0.0",
    "kysely": "^0.29.7",
    "npm-package-arg": "^14.0.0",
    "oxfmt": "^0.74.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jxsuite/auth": "workspace:^",
    "@jxsuite/connector": "workspace:^",
    "@jxsuite/parser": "workspace:^",
    "@types/npm-package-arg": "^6.1.4",
    "@types/npmcli__arborist": "^6.3.3",
    "@types/ws": "^8.18.1"
  }
}
