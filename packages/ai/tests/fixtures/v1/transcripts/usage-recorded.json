{
  "name": "usage-recorded",
  "description": "recordUsage across two turns. Usage never touches the messages or the wire. The last valid frame wins: reasoning the provider billed but never streamed is subtracted from contextTokens, `type` is stripped, and a frame with a negative count is ignored.",
  "shapes": ["usage-recorded", "reasoning-replayed"],
  "script": [
    ["sendMessage", "Summarize the page"],
    ["appendReasoning", "Short page."],
    ["appendDelta", "It is a landing page with a hero and a footer."],
    [
      "recordUsage",
      {
        "type": "usage",
        "inputTokens": 1200,
        "outputTokens": 80,
        "cachedInputTokens": 1024,
        "reasoningTokens": 40
      },
      { "systemTokens": 900 }
    ],
    ["finishStream", "stop"],
    ["sendMessage", "And the footer?"],
    ["appendDelta", "It has two links."],
    [
      "recordUsage",
      { "type": "usage", "inputTokens": 1350, "outputTokens": 30, "reasoningTokens": 64 }
    ],
    ["recordUsage", { "type": "usage", "inputTokens": -1, "outputTokens": 5 }],
    ["finishStream", "stop"]
  ],
