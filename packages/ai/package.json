{
  "name": "@jxsuite/ai",
  "version": "0.41.0",
  "description": "AI infrastructure for Jx Suite — streaming LLM client abstraction, tool registry, and reactive chat state",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/ai"
  },
  "files": [
    "src/",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./streaming-client": "./src/streaming-client.ts",
    "./tools": "./src/tools.ts",
    "./chat-state": "./src/chat-state.ts",
    "./gateway": "./src/gateway/index.ts",
    "./harness": "./src/harness/index.ts",
    "./messages": "./src/messages/index.ts",
    "./jx-tools": "./src/jx-tools/index.ts",
    "./catalog": "./src/catalog/index.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target browser --sourcemap=linked",
    "test": "bun test",
    "upgrade": "bun update --latest && bun install"
  },
  "dependencies": {
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@vue/reactivity": "3.5.44"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@happy-dom/global-registrator": "^21.0.4"
  }
}
