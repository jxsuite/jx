{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StylebookTextfield",
  "tagName": "main",
  "$elements": [
    {
      "$ref": "../components/jx-field.json"
    },
    {
      "$ref": "../components/jx-textfield.json"
    }
  ],
  "state": {
    "name": "Draft"
  },
  "style": {
    "fontFamily": "var(--jx-font-sans)",
    "fontSize": "var(--jx-text-md)",
    "color": "var(--jx-fg)",
    "background": "var(--jx-bg)",
    "padding": "var(--jx-space-6)",
    "minHeight": "100vh",
    "& > h1": {
      "fontSize": "var(--jx-text-lg)",
      "fontWeight": "600",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& > h2": {
      "fontSize": "var(--jx-text-md)",
      "fontWeight": "600",
      "margin": "var(--jx-space-6) 0 var(--jx-space-3)"
    },
    "& > p": {
      "color": "var(--jx-fg-dim)",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& [role=\"group\"]": {
      "display": "flex",
      "alignItems": "flex-start",
      "flexWrap": "wrap",
      "gap": "var(--jx-space-3)",
      "margin": "0 0 var(--jx-space-4)"
    },
    "& [role=\"group\"] > span": {
      "width": "80px",
      "color": "var(--jx-fg-muted)",
      "fontSize": "var(--jx-text-sm)"
    }
  },
  "children": [
    {
      "tagName": "h1",
      "textContent": "jx-textfield"
    },
    {
      "tagName": "p",
      "textContent": "A native input or textarea with its name, its states and its messages. The first field's value is bound to the page's state both ways."
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "Bound value"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Layout name",
            "placeholder": "Untitled",
            "value": {
              "$ref": "#/state/name"
            }
          },
          "oninput": {
            "$prototype": "Function",
            "body": [
              {
                "operator": "=",
                "target": {
                  "$ref": "#/state/name"
                },
                "value": {
                  "$ref": "event#/target/value"
                }
              }
            ]
          }
        },
        {
          "tagName": "span",
          "textContent": "${state.name}"
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "Sizes"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Small",
            "size": "sm",
            "value": "sm"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Medium",
            "value": "md"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Large",
            "size": "lg",
            "value": "lg"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "States"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Refused",
            "value": "about",
            "invalid": true,
            "error": "about.md already exists."
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "With help",
            "help": "Letters, digits and dashes."
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Disabled",
            "value": "Cannot edit",
            "disabled": true
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Read only",
            "value": "Can select",
            "readonly": true
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "Kinds"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Selector",
            "mono": true,
            "value": ".card > h2"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Search",
            "type": "search",
            "placeholder": "Search…"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Notes",
            "multiline": true,
            "value": "A textarea,\nwith the same contract."
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "Clearable at every size"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Filter, small",
            "type": "search",
            "size": "sm",
            "clearable": true,
            "placeholder": "Search…",
            "value": "about"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Filter",
            "type": "search",
            "clearable": true,
            "placeholder": "Search…",
            "value": "about"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Filter, large",
            "type": "search",
            "size": "lg",
            "clearable": true,
            "placeholder": "Search…",
            "value": "about"
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Filter, disabled",
            "type": "search",
            "clearable": true,
            "disabled": true,
            "value": "about"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "role": "group",
        "aria-label": "Growing"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Description",
            "multiline": true,
            "grows": true,
            "rows": "2",
            "value": "A textarea that takes the height of its text."
          }
        },
        {
          "tagName": "jx-textfield",
          "$props": {
            "label": "Summary",
            "multiline": true,
            "grows": true,
            "clearable": true,
            "value": "No rows asked for, so an engine without field-sizing keeps the three-row box a fixed field gets."
          }
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "In a field row"
    },
    {
      "tagName": "p",
      "textContent": "The row is jx-field: one element where the label, the row and the help sentence used to be three classes and four hand-written ids. It mints its own ids and hands them to the field as labelledby and describedby."
    },
    {
      "tagName": "jx-field",
      "$props": {
        "label": "Title",
        "description": "Shown in the Library and in the browser tab."
      },
      "attributes": {
        "data-prop": "title"
      },
      "children": [
        {
          "tagName": "jx-textfield",
          "$props": {
            "placeholder": "Untitled"
          }
        }
      ]
    }
  ]
}
