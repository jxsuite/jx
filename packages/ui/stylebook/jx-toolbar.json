{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StylebookToolbar",
  "tagName": "main",
  "$elements": [
    {
      "$ref": "../components/jx-icon.json"
    },
    {
      "$ref": "../components/jx-spinner.json"
    },
    {
      "$ref": "../components/jx-button.json"
    },
    {
      "$ref": "../components/jx-action-button.json"
    },
    {
      "$ref": "../components/jx-action-group.json"
    },
    {
      "$ref": "../components/jx-divider.json"
    },
    {
      "$ref": "../components/jx-textfield.json"
    },
    {
      "$ref": "../components/jx-color-field.json"
    },
    {
      "$ref": "../components/jx-tab.json"
    },
    {
      "$ref": "../components/jx-tabs.json"
    },
    {
      "$ref": "../components/jx-swatch.json"
    },
    {
      "$ref": "../components/jx-swatch-group.json"
    },
    {
      "$ref": "../components/jx-toolbar.json"
    }
  ],
  "state": {
    "filter": "",
    "setFilter": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/filter"
          },
          "value": {
            "$ref": "event#/target/value"
          }
        }
      ]
    },
    "fill": "#3b82f6",
    "setFill": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/fill"
          },
          "value": {
            "$ref": "event#/target/value"
          }
        }
      ]
    },
    "last": "nothing yet",
    "did": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/last"
          },
          "value": {
            "$ref": "event#/currentTarget/dataset/verb"
          }
        }
      ]
    },
    "align": "left",
    "chooseAlign": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/align"
          },
          "value": {
            "$ref": "event#/currentTarget/dataset/value"
          }
        }
      ]
    },
    "view": "table",
    "setView": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/view"
          },
          "value": {
            "$ref": "event#/detail"
          }
        }
      ]
    }
  },
  "style": {
    "fontFamily": "var(--jx-font-sans)",
    "fontSize": "var(--jx-text-md)",
    "color": "var(--jx-fg)",
    "background": "var(--jx-bg)",
    "padding": "var(--jx-space-6)",
    "minHeight": "100vh",
    "& > h1": {
      "fontSize": "var(--jx-text-lg)",
      "fontWeight": "600",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& > h2": {
      "fontSize": "var(--jx-text-md)",
      "fontWeight": "600",
      "color": "var(--jx-fg-dim)",
      "margin": "var(--jx-space-5) 0 var(--jx-space-2)"
    },
    "& > p": {
      "color": "var(--jx-fg-dim)",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& > div": {
      "margin": "0 0 var(--jx-space-4)",
      "border": "1px solid var(--jx-border)",
      "borderRadius": "var(--jx-radius-sm)",
      "background": "var(--jx-bg-panel)"
    },
    "& jx-toolbar": {
      "padding": "var(--jx-space-2) var(--jx-space-3)"
    },
    "& [part=\"filter\"]": {
      "width": "180px",
      "flex": "0 0 auto"
    },
    "& [part=\"spacer\"]": {
      "flex": "1"
    },
    "& [part=\"count\"]": {
      "fontSize": "var(--jx-text-sm)",
      "color": "var(--jx-fg-dim)",
      "whiteSpace": "nowrap"
    },
    "& > div[data-vertical]": {
      "width": "max-content"
    },
    "& [part=\"views\"]": {
      "borderBlockEnd": "0"
    }
  },
  "children": [
    {
      "tagName": "h1",
      "textContent": "jx-toolbar"
    },
    {
      "tagName": "p",
      "textContent": "A container of ARBITRARY controls with one tab stop. jx-action-group is a row of action buttons that may be joined into a segmented control; this is the element for a row that also holds a text field, a divider and a plain button, which is what every real toolbar turns out to be. Arrows move between the controls, Home and End reach the ends — and the filter field below keeps those keys for itself while its caret still has text to walk, so you arrow in, type, and arrow out again with the same key. Last verb pressed: ${state.last}."
    },
    {
      "tagName": "h2",
      "textContent": "A mixed row — the shape Studio's grid toolbar has"
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "jx-toolbar",
          "$props": {
            "label": "Grid actions"
          },
          "children": [
            {
              "tagName": "jx-button",
              "$props": {
                "variant": "accent",
                "size": "sm",
                "label": "Save"
              },
              "attributes": {
                "data-verb": "save"
              },
              "onclick": {
                "$ref": "#/state/did"
              },
              "children": [
                {
                  "tagName": "span",
                  "textContent": "Save"
                }
              ]
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Refresh",
                "hint": "Reload from source",
                "icon": "arrows-clockwise"
              },
              "attributes": {
                "data-verb": "refresh"
              },
              "onclick": {
                "$ref": "#/state/did"
              }
            },
            {
              "tagName": "jx-divider",
              "$props": {
                "orientation": "vertical"
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Add row",
                "hint": "Add a row",
                "icon": "plus"
              },
              "attributes": {
                "data-verb": "add"
              },
              "onclick": {
                "$ref": "#/state/did"
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Delete rows",
                "hint": "Nothing is selected",
                "icon": "trash",
                "disabled": true
              }
            },
            {
              "tagName": "jx-textfield",
              "attributes": {
                "part": "filter"
              },
              "$props": {
                "size": "sm",
                "type": "search",
                "clearable": true,
                "label": "Filter rows",
                "placeholder": "Filter rows",
                "value": {
                  "$ref": "#/state/filter"
                }
              },
              "oninput": {
                "$ref": "#/state/setFilter"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "spacer"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "count"
              },
              "textContent": "filter: ${state.filter || '—'}"
            }
          ]
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "A colour well in the row"
    },
    {
      "tagName": "p",
      "textContent": "A jx-color-field is four controls of its own — the swatch, a text field, the eyedropper and the system's colour well — and in a toolbar it is ONE stop: the swatch. Arrow onto it and Enter opens the picker; the three controls beside it leave the tab order while the field is roved, and take their own stops back anywhere else. Fill: ${state.fill}."
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "jx-toolbar",
          "$props": {
            "label": "Text style"
          },
          "children": [
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Bold",
                "hint": "Bold",
                "icon": "text-b",
                "toggles": true
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Italic",
                "hint": "Italic",
                "icon": "text-italic",
                "toggles": true
              }
            },
            {
              "tagName": "jx-divider",
              "$props": {
                "orientation": "vertical"
              }
            },
            {
              "tagName": "jx-color-field",
              "$props": {
                "size": "sm",
                "label": "Fill",
                "value": {
                  "$ref": "#/state/fill"
                }
              },
              "onchange": {
                "$ref": "#/state/setFill"
              }
            },
            {
              "tagName": "jx-divider",
              "$props": {
                "orientation": "vertical"
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Align left",
                "hint": "Align left",
                "icon": "text-align-left"
              }
            }
          ]
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "orientation=\"vertical\""
    },
    {
      "tagName": "div",
      "attributes": {
        "data-vertical": ""
      },
      "children": [
        {
          "tagName": "jx-toolbar",
          "$props": {
            "label": "Node actions",
            "orientation": "vertical"
          },
          "children": [
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "stacked": true,
                "label": "Move up",
                "icon": "arrow-up"
              },
              "attributes": {
                "data-verb": "up"
              },
              "onclick": {
                "$ref": "#/state/did"
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "stacked": true,
                "label": "Move down",
                "icon": "arrow-down"
              },
              "attributes": {
                "data-verb": "down"
              },
              "onclick": {
                "$ref": "#/state/did"
              }
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "stacked": true,
                "label": "Duplicate",
                "icon": "copy"
              },
              "attributes": {
                "data-verb": "duplicate"
              },
              "onclick": {
                "$ref": "#/state/did"
              }
            }
          ]
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "A composite in the row"
    },
    {
      "tagName": "p",
      "textContent": "A jx-action-group or a jx-tabs runs a roving caret of its own, and inside a toolbar it is still ONE item: the toolbar writes the composite's own tabindex prop and the composite forwards it to the child holding its caret, so Tab reaches the row once. The arrows walk every control in the row, the composite's children included. Inside the composite they move without choosing, so a reader can pass the alignment below without changing it, and Space or Enter chooses; at the composite's last child the same arrow moves on to the next control."
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "jx-toolbar",
          "$props": {
            "label": "Paragraph"
          },
          "children": [
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Bold",
                "hint": "Bold",
                "icon": "text-b",
                "toggles": true
              }
            },
            {
              "tagName": "jx-divider",
              "$props": {
                "orientation": "vertical"
              }
            },
            {
              "tagName": "jx-action-group",
              "$props": {
                "label": "Alignment",
                "selects": "single"
              },
              "children": [
                {
                  "tagName": "jx-action-button",
                  "$props": {
                    "size": "sm",
                    "label": "Align left",
                    "hint": "Align left",
                    "icon": "text-align-left",
                    "checked": "${state.align === 'left' ? 'true' : 'false'}"
                  },
                  "attributes": {
                    "data-value": "left"
                  },
                  "onclick": {
                    "$ref": "#/state/chooseAlign"
                  }
                },
                {
                  "tagName": "jx-action-button",
                  "$props": {
                    "size": "sm",
                    "label": "Align centre",
                    "hint": "Align centre",
                    "icon": "text-align-center",
                    "checked": "${state.align === 'center' ? 'true' : 'false'}"
                  },
                  "attributes": {
                    "data-value": "center"
                  },
                  "onclick": {
                    "$ref": "#/state/chooseAlign"
                  }
                },
                {
                  "tagName": "jx-action-button",
                  "$props": {
                    "size": "sm",
                    "label": "Align right",
                    "hint": "Align right",
                    "icon": "text-align-right",
                    "checked": "${state.align === 'right' ? 'true' : 'false'}"
                  },
                  "attributes": {
                    "data-value": "right"
                  },
                  "onclick": {
                    "$ref": "#/state/chooseAlign"
                  }
                }
              ]
            },
            {
              "tagName": "jx-divider",
              "$props": {
                "orientation": "vertical"
              }
            },
            {
              "tagName": "jx-textfield",
              "attributes": {
                "part": "filter"
              },
              "$props": {
                "size": "sm",
                "type": "search",
                "label": "Find in paragraph",
                "placeholder": "Find"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "spacer"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "count"
              },
              "textContent": "align: ${state.align}"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "jx-toolbar",
          "$props": {
            "label": "Library"
          },
          "children": [
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Refresh",
                "hint": "Reload from source",
                "icon": "arrows-clockwise"
              }
            },
            {
              "tagName": "jx-tabs",
              "attributes": {
                "part": "views",
                "label": "Layout",
                "selected": "${state.view}"
              },
              "onchange": {
                "$ref": "#/state/setView"
              },
              "children": [
                {
                  "tagName": "jx-tab",
                  "attributes": {
                    "value": "table",
                    "label": "Table"
                  }
                },
                {
                  "tagName": "jx-tab",
                  "attributes": {
                    "value": "cards",
                    "label": "Cards"
                  }
                },
                {
                  "tagName": "jx-tab",
                  "attributes": {
                    "value": "media",
                    "label": "Media"
                  }
                }
              ]
            },
            {
              "tagName": "jx-action-button",
              "$props": {
                "size": "sm",
                "label": "Add file",
                "hint": "Add a file",
                "icon": "plus"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "spacer"
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "count"
              },
              "textContent": "view: ${state.view}"
            }
          ]
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "What a toolbar does NOT rove"
    },
    {
      "tagName": "p",
      "textContent": "A control whose own arrows are spoken for is not an item and keeps a tab stop of its own: a select, a range, a spin button and a combobox would have their value rewritten by a caret walking past. A jx-swatch-group answers both arrow pairs and chooses as it moves, so it stands BESIDE a toolbar rather than inside one, as the palette below does; in a row the colour control is jx-color-field."
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "jx-swatch-group",
          "$props": {
            "label": "Fill",
            "value": {
              "$ref": "#/state/fill"
            }
          },
          "children": [
            {
              "tagName": "jx-swatch",
              "$props": {
                "color": "#3b82f6",
                "label": "Blue"
              }
            },
            {
              "tagName": "jx-swatch",
              "$props": {
                "color": "#22c55e",
                "label": "Green"
              }
            },
            {
              "tagName": "jx-swatch",
              "$props": {
                "color": "#ef4444",
                "label": "Red"
              }
            }
          ]
        }
      ]
    }
  ]
}
