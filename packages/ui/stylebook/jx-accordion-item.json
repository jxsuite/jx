{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StylebookAccordionItem",
  "tagName": "main",
  "$elements": [
    {
      "$ref": "../components/jx-icon.json"
    },
    {
      "$ref": "../components/jx-spinner.json"
    },
    {
      "$ref": "../components/jx-action-button.json"
    },
    {
      "$ref": "../components/jx-accordion-item.json"
    }
  ],
  "state": {
    "last": "nothing yet",
    "note": {
      "$prototype": "Function",
      "body": [
        {
          "operator": "=",
          "target": {
            "$ref": "#/state/last"
          },
          "value": {
            "$ref": "event#/detail"
          }
        }
      ]
    }
  },
  "style": {
    "fontFamily": "var(--jx-font-sans)",
    "fontSize": "var(--jx-text-md)",
    "color": "var(--jx-fg)",
    "background": "var(--jx-bg)",
    "padding": "var(--jx-space-6)",
    "minHeight": "100vh",
    "& > h1": {
      "fontSize": "var(--jx-text-lg)",
      "fontWeight": "600",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& > h2": {
      "fontSize": "var(--jx-text-md)",
      "fontWeight": "600",
      "color": "var(--jx-fg-dim)",
      "margin": "var(--jx-space-5) 0 var(--jx-space-2)"
    },
    "& > p": {
      "color": "var(--jx-fg-dim)",
      "margin": "0 0 var(--jx-space-5)"
    },
    "& .jx-accordion": {
      "maxWidth": "420px",
      "border": "1px solid var(--jx-border)",
      "borderRadius": "var(--jx-radius-md)",
      "background": "var(--jx-bg-panel)"
    }
  },
  "children": [
    {
      "tagName": "h1",
      "textContent": "jx-accordion-item"
    },
    {
      "tagName": "p",
      "textContent": "A native details and summary pair made one addressable thing: the platform owns the toggle, Enter and Space, find-in-page reveal and print, and the element adds a label, a caret, an actions row that stays visible while the section is shut, and an open a host can both write and read back. The container is the div.jx-accordion RECIPE, not an element — it owns no state and no keyboard, so a class is the whole of it. Last toggle said: ${state.last}."
    },
    {
      "tagName": "h2",
      "textContent": "A panel of sections"
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "jx-accordion"
      },
      "children": [
        {
          "tagName": "jx-accordion-item",
          "$props": {
            "label": "Layout",
            "open": true
          },
          "ontoggle": {
            "$ref": "#/state/note"
          },
          "children": [
            {
              "tagName": "p",
              "textContent": "Display, position and the box model."
            }
          ]
        },
        {
          "tagName": "jx-accordion-item",
          "$props": {
            "label": "Typography"
          },
          "ontoggle": {
            "$ref": "#/state/note"
          },
          "children": [
            {
              "tagName": "span",
              "attributes": {
                "slot": "heading",
                "class": "jx-dot",
                "aria-hidden": "true"
              }
            },
            {
              "tagName": "jx-action-button",
              "attributes": {
                "slot": "actions"
              },
              "$props": {
                "label": "Clear typography overrides",
                "hint": "Clear typography overrides",
                "icon": "arrow-u-up-left",
                "size": "sm"
              }
            },
            {
              "tagName": "p",
              "textContent": "The interactive control in the actions row does not toggle the section, and it is still there while the section is closed."
            }
          ]
        },
        {
          "tagName": "jx-accordion-item",
          "$props": {
            "label": "Custom",
            "level": "3"
          },
          "ontoggle": {
            "$ref": "#/state/note"
          },
          "children": [
            {
              "tagName": "p",
              "textContent": "This one opts in to heading semantics with level=\"3\", so it is reachable by heading navigation."
            }
          ]
        }
      ]
    },
    {
      "tagName": "h2",
      "textContent": "One at a time"
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "jx-accordion"
      },
      "children": [
        {
          "tagName": "jx-accordion-item",
          "$props": {
            "label": "First",
            "name": "stylebook-exclusive",
            "open": true
          },
          "children": [
            {
              "tagName": "p",
              "textContent": "Every item here carries the same name, so the platform closes the others when one opens."
            }
          ]
        },
        {
          "tagName": "jx-accordion-item",
          "$props": {
            "label": "Second",
            "name": "stylebook-exclusive"
          },
          "children": [
            {
              "tagName": "p",
              "textContent": "No shipped Studio panel wants this — all six keep several sections open at once — but the platform gives it for one forwarded attribute."
            }
          ]
        }
      ]
    }
  ]
}
