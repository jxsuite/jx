{
  "name": "Jx UI Kit",
  "url": "https://jxsuite.com/ui",
  "defaults": {
    "lang": "en"
  },
  "$media": {
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 640px)"
  },
  "style": {
    "--jx-gray-50": "#f7f7f9",
    "--jx-gray-100": "#eeeef2",
    "--jx-gray-200": "#e1e1e7",
    "--jx-gray-300": "#c9c9d2",
    "--jx-gray-400": "#a2a2af",
    "--jx-gray-500": "#7c7c8b",
    "--jx-gray-600": "#5e5e6c",
    "--jx-gray-700": "#45454f",
    "--jx-gray-800": "#2f2f36",
    "--jx-gray-850": "#26262c",
    "--jx-gray-900": "#1d1d22",
    "--jx-gray-925": "#17171b",
    "--jx-gray-950": "#111114",
    "--jx-gray-975": "#0b0b0d",
    "--jx-blue-50": "#eef4ff",
    "--jx-blue-100": "#dbe7fe",
    "--jx-blue-200": "#bcd3fd",
    "--jx-blue-300": "#8fb5fb",
    "--jx-blue-400": "#5f95f7",
    "--jx-blue-500": "#3b82f6",
    "--jx-blue-600": "#2563eb",
    "--jx-blue-700": "#1d4ed8",
    "--jx-blue-800": "#1e40af",
    "--jx-blue-900": "#172554",
    "--jx-blue-950": "#0f172e",
    "--jx-red-50": "#fdeeee",
    "--jx-red-100": "#fbd9d9",
    "--jx-red-200": "#f5b3b3",
    "--jx-red-300": "#ee8a8a",
    "--jx-red-400": "#e86460",
    "--jx-red-500": "#dc3f3b",
    "--jx-red-600": "#c22e2b",
    "--jx-red-700": "#a12522",
    "--jx-red-800": "#7d1e1c",
    "--jx-red-900": "#5a1614",
    "--jx-red-950": "#3a0f0e",
    "--jx-green-50": "#e9f7ee",
    "--jx-green-100": "#cdeedb",
    "--jx-green-200": "#a6dfbd",
    "--jx-green-300": "#74c996",
    "--jx-green-400": "#4fb27a",
    "--jx-green-500": "#2f9a5f",
    "--jx-green-600": "#22804e",
    "--jx-green-700": "#1a6640",
    "--jx-green-800": "#144e32",
    "--jx-green-900": "#0f3a26",
    "--jx-green-950": "#0a2719",
    "--jx-amber-50": "#fdf3e1",
    "--jx-amber-100": "#fae4b5",
    "--jx-amber-200": "#f2cc7c",
    "--jx-amber-300": "#e5ae4a",
    "--jx-amber-400": "#d59429",
    "--jx-amber-500": "#b8791a",
    "--jx-amber-600": "#96600f",
    "--jx-amber-700": "#764b0b",
    "--jx-amber-800": "#5a3908",
    "--jx-amber-900": "#3f2806",
    "--jx-amber-950": "#2a1a04",
    "--jx-bg": "light-dark(var(--jx-gray-50), var(--jx-gray-950))",
    "--jx-bg-panel": "light-dark(#ffffff, var(--jx-gray-925))",
    "--jx-bg-input": "light-dark(#ffffff, var(--jx-gray-900))",
    "--jx-bg-overlay": "light-dark(#ffffff, var(--jx-gray-850))",
    "--jx-border": "light-dark(var(--jx-gray-200), var(--jx-gray-800))",
    "--jx-border-strong": "light-dark(var(--jx-gray-300), var(--jx-gray-700))",
    "--jx-fg": "light-dark(var(--jx-gray-900), var(--jx-gray-100))",
    "--jx-fg-dim": "light-dark(var(--jx-gray-600), var(--jx-gray-400))",
    "--jx-fg-muted": "var(--jx-gray-500)",
    "--jx-accent": "light-dark(var(--jx-blue-600), var(--jx-blue-500))",
    "--jx-accent-solid": "var(--jx-blue-600)",
    "--jx-accent-hover": "light-dark(var(--jx-blue-700), var(--jx-blue-400))",
    "--jx-accent-fg": "#ffffff",
    "--jx-accent-8": "color-mix(in oklab, var(--jx-accent) 8%, transparent)",
    "--jx-accent-10": "color-mix(in oklab, var(--jx-accent) 10%, transparent)",
    "--jx-accent-15": "color-mix(in oklab, var(--jx-accent) 15%, transparent)",
    "--jx-accent-20": "color-mix(in oklab, var(--jx-accent) 20%, transparent)",
    "--jx-accent-50": "color-mix(in oklab, var(--jx-accent) 50%, transparent)",
    "--jx-hover-bg": "color-mix(in oklab, var(--jx-fg) 6%, transparent)",
    "--jx-danger": "light-dark(var(--jx-red-600), var(--jx-red-400))",
    "--jx-success": "light-dark(var(--jx-green-600), var(--jx-green-400))",
    "--jx-warning": "light-dark(var(--jx-amber-600), var(--jx-amber-300))",
    "--jx-tag": "light-dark(var(--jx-blue-700), var(--jx-blue-300))",
    "--jx-signal": "light-dark(var(--jx-amber-700), var(--jx-amber-200))",
    "--jx-handler": "light-dark(#7c3aed, #c8a2e0)",
    "--jx-map": "light-dark(#4f46b5, #8b83e6)",
    "--jx-switch-c": "var(--jx-danger)",
    "--jx-switch-track": "var(--jx-gray-500)",
    "--jx-switch-thumb": "light-dark(#ffffff, var(--jx-gray-100))",
    "--jx-font-sans": "\"Inter Variable\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "--jx-font-mono": "\"JetBrains Mono\", \"SF Mono\", \"Fira Code\", monospace",
    "--jx-text-xs": "10px",
    "--jx-text-sm": "11px",
    "--jx-text-md": "12px",
    "--jx-text-lg": "14px",
    "--jx-leading-xs": "14px",
    "--jx-leading-sm": "16px",
    "--jx-leading-md": "18px",
    "--jx-leading-lg": "20px",
    "--jx-space-1": "2px",
    "--jx-space-2": "4px",
    "--jx-space-3": "8px",
    "--jx-space-4": "12px",
    "--jx-space-5": "16px",
    "--jx-space-6": "24px",
    "--jx-space-7": "32px",
    "--jx-control-h": "24px",
    "--jx-field-label-w": "80px",
    "--jx-icon-size": "16px",
    "--jx-radius-xs": "2px",
    "--jx-radius-sm": "4px",
    "--jx-radius-md": "6px",
    "--jx-radius-lg": "10px",
    "--jx-focus-ring": "2px solid var(--jx-accent)",
    "--jx-shadow-popover": "0 0 0 1px var(--jx-border-strong), 0 8px 24px -8px rgb(0 0 0 / 0.6), 0 2px 6px rgb(0 0 0 / 0.3)",
    "--jx-shadow-dialog": "0 0 0 1px var(--jx-border-strong), 0 24px 64px -16px rgb(0 0 0 / 0.7)",
    "--jx-dur-1": "150ms",
    "--jx-dur-2": "200ms",
    "--jx-ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "--jx-ease-in": "cubic-bezier(0.4, 0, 1, 1)",
    "colorScheme": "light dark",
    "&[data-theme=\"light\"]": {
      "colorScheme": "light",
      "--jx-shadow-popover": "0 0 0 1px var(--jx-border-strong), 0 8px 24px -8px rgb(0 0 0 / 0.18), 0 2px 6px rgb(0 0 0 / 0.1)",
      "--jx-shadow-dialog": "0 0 0 1px var(--jx-border-strong), 0 24px 64px -16px rgb(0 0 0 / 0.25)"
    },
    "&[data-theme=\"dark\"]": {
      "colorScheme": "dark"
    },
    "&[data-density=\"compact\"]": {
      "--jx-control-h": "20px",
      "--jx-text-md": "11px"
    },
    "&[data-density=\"comfortable\"]": {
      "--jx-control-h": "28px"
    },
    "@(prefers-reduced-motion: reduce)": {
      "--jx-dur-1": "0ms",
      "--jx-dur-2": "0ms"
    },
    "@(forced-colors: active)": {
      "--jx-focus-ring": "2px solid Highlight"
    },
    "@property --jx-accent": {
      "syntax": "\"<color>\"",
      "inherits": "true",
      "initialValue": "#3b82f6"
    },
    "@property --jx-dur-1": {
      "syntax": "\"<time>\"",
      "inherits": "true",
      "initialValue": "150ms"
    },
    "@property --jx-dur-2": {
      "syntax": "\"<time>\"",
      "inherits": "true",
      "initialValue": "200ms"
    },
    "& .jx-field-row": {
      "display": "grid",
      "gridTemplateColumns": "var(--jx-field-label-w) minmax(0, 1fr)",
      "columnGap": "var(--jx-space-3)",
      "rowGap": "var(--jx-space-1)",
      "alignItems": "center",
      "padding": "var(--jx-space-1) 0",
      "& > .jx-help-text": {
        "gridColumn": "1 / -1"
      },
      "&[data-span] > .jx-field-label": {
        "gridColumn": "1 / -1",
        "textAlign": "left",
        "width": "auto"
      },
      "&[data-span] > :not(.jx-field-label)": {
        "gridColumn": "1 / -1"
      },
      "&[data-invalid] > .jx-field-label": {
        "color": "var(--jx-danger)"
      },
      "&[data-warning] > .jx-field-label": {
        "color": "var(--jx-warning)"
      }
    },
    "& .jx-field-label": {
      "display": "block",
      "width": "var(--jx-field-label-w)",
      "minWidth": "0",
      "textAlign": "right",
      "color": "var(--jx-fg-dim)",
      "fontSize": "var(--jx-text-md)",
      "lineHeight": "var(--jx-leading-md)",
      "overflow": "hidden",
      "textOverflow": "ellipsis",
      "whiteSpace": "nowrap",
      "&[data-required]::after": {
        "content": "\"*\" / \"\"",
        "color": "var(--jx-danger)",
        "marginInlineStart": "var(--jx-space-1)"
      }
    },
    "& .jx-help-text": {
      "margin": "0",
      "color": "var(--jx-fg-dim)",
      "fontSize": "var(--jx-text-sm)",
      "lineHeight": "var(--jx-leading-sm)"
    },
    "& .jx-help-text--error": {
      "color": "var(--jx-danger)"
    },
    "& .jx-divider": {
      "flex": "none",
      "margin": "var(--jx-space-1) 0",
      "border": "0",
      "borderTop": "1px solid var(--jx-border)",
      "&[aria-orientation=\"vertical\"]": {
        "alignSelf": "stretch",
        "margin": "0 var(--jx-space-1)",
        "borderTop": "0",
        "borderLeft": "1px solid var(--jx-border)"
      }
    },
    "& .jx-table": {
      "width": "100%",
      "borderCollapse": "collapse",
      "fontSize": "var(--jx-text-md)",
      "fontVariantNumeric": "tabular-nums",
      "& th, & td": {
        "padding": "var(--jx-space-2) var(--jx-space-3)",
        "textAlign": "left",
        "borderBottom": "1px solid var(--jx-border)"
      },
      "& th": {
        "color": "var(--jx-fg-dim)",
        "fontWeight": "500"
      },
      "& tbody tr:last-child > *": {
        "borderBottom": "0"
      }
    },
    "& .jx-kbd": {
      "display": "inline-block",
      "padding": "0 var(--jx-space-2)",
      "border": "1px solid var(--jx-border)",
      "borderRadius": "var(--jx-radius-xs)",
      "background": "var(--jx-bg-panel)",
      "color": "var(--jx-fg-dim)",
      "fontFamily": "var(--jx-font-mono)",
      "fontSize": "var(--jx-text-xs)",
      "lineHeight": "var(--jx-leading-sm)"
    },
    "& .jx-badge": {
      "display": "inline-flex",
      "alignItems": "center",
      "justifyContent": "center",
      "minWidth": "16px",
      "padding": "0 var(--jx-space-2)",
      "borderRadius": "999px",
      "background": "var(--jx-accent-solid)",
      "color": "var(--jx-accent-fg)",
      "fontSize": "var(--jx-text-xs)",
      "lineHeight": "16px",
      "fontVariantNumeric": "tabular-nums"
    },
    "& .jx-dot": {
      "display": "inline-block",
      "width": "6px",
      "height": "6px",
      "borderRadius": "50%",
      "background": "var(--jx-fg-muted)",
      "&[data-tone=\"danger\"]": {
        "background": "var(--jx-danger)"
      },
      "&[data-tone=\"success\"]": {
        "background": "var(--jx-success)"
      },
      "&[data-tone=\"warning\"]": {
        "background": "var(--jx-warning)"
      }
    }
  },
  "$elements": [
    {
      "$ref": "./components/jx-icon.json"
    }
  ]
}
