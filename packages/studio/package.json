{
  "name": "@jxsuite/studio",
  "version": "5.0.0",
  "description": "Jx Studio — visual builder for Jx documents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/studio"
  },
  "files": [
    "src",
    "data",
    "dist/studio.js",
    "dist/studio.css",
    "dist/iframe-entry.js",
    "dist/codicon.ttf",
    "dist/manifest.json",
    "dist/chunks/*.js",
    "dist/chunks/*.css",
    "dist/workers",
    "index.html",
    "canvas.html",
    "favicon.ico",
    "styles",
    "fonts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/studio.ts",
    "./platform": "./src/platform.ts",
    "./types": "./src/types.ts",
    "./base64": "./src/utils/base64.ts",
    "./directory-picker": "./src/services/directory-picker.ts",
    "./import-client": "./src/services/import-client.ts",
    "./github-auth": "./src/github/github-auth.ts",
    "./hosting": "./src/hosting/stage.ts",
    "./hosting/layout": "./src/hosting/layout.ts",
    "./hosting/document": "./src/hosting/document.ts",
    "./package.json": "./package.json",
    "./platforms/cloud": "./src/platforms/cloud.ts",
    "./preview-navigate": "./src/canvas/preview-navigate.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:metafile": "bun build ./src/studio.ts --outdir dist-metafile --target browser --sourcemap=linked --metafile=metafile.json",
    "gen:webdata": "bun run scripts/gen-webdata.js",
    "eval": "bun run evals/cli.ts",
    "eval:headless": "bun run tests/harness/run-eval.ts",
    "lint:styles": "bun run scripts/check-styles.ts",
    "styles:check": "bun run scripts/build-styles.ts",
    "styles:sync": "bun run scripts/build-styles.ts --fix",
    "test": "bun run lint:styles && bun run styles:check && bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bun update --latest && bun install"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.2.0",
    "@jxsuite/ai": "workspace:^",
    "@jxsuite/collab": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/formulas": "workspace:^",
    "@jxsuite/markup": "workspace:^",
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/runtime": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/site": "workspace:^",
    "@jxsuite/ui": "workspace:^",
    "@vue/reactivity": "3.5.42",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lit-html": "^3.3.3",
    "monaco-editor": "^0.56.0",
    "tabulator-tables": "^6.5.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/mdast": "^4.0.4",
    "@webref/css": "^8.7.4",
    "@webref/elements": "^2.8.0",
    "@webref/idl": "^3.83.1"
  },
  "//vue-reactivity": "Exact pin required — must match @jxsuite/runtime to avoid cross-boundary proxy bugs"
}
