{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StudioFormulaPalette",
  "$description": "The formula palette (spec §19.9): a search field over the formula catalog, its results grouped by the catalog's own group order, and one pick that hands an entry back to whoever opened it. The same shape as `palette.json` — a scrim, a framed panel, a borderless field, a listbox — because it is the same gesture over a different corpus, and the two used to share a stylesheet by sharing its class names. `groups` is the filtered catalog already grouped; `selectedIndex` is the highlight, kept apart from the rows so a key moves it without the list reconciling, which is why every row carries the FLAT index it would otherwise have to be asked for. Panel position is the caller's: centred under the top edge by default, and pinned under an anchor control when one was named, which is the only thing about this surface a document cannot decide for itself.",
  "tagName": "div",
  "attributes": {
    "part": "palette"
  },
  "style": {
    "$description": "The `.quick-search-*` rules the palette used to borrow from `styles/overlays.css`, brought here and re-valued. Every colour in the originals was a `--spectrum-*` name with a hex fallback, and a mounted document is outside `<sp-theme>` — so each of those resolved to its fallback and the palette had stopped following the chrome theme at all. The names now read from the kit's own layer, which is where a surface's colours come from.",
    "display": "contents",
    "& [part=\"overlay\"]": {
      "position": "fixed",
      "inset": "0",
      "zIndex": "1000",
      "display": "flex",
      "justifyContent": "center",
      "paddingTop": "60px",
      "background": "rgba(0, 0, 0, 0.4)"
    },
    "& [part=\"panel\"]": {
      "width": "560px",
      "maxWidth": "calc(100vw - 32px)",
      "maxHeight": "420px",
      "display": "flex",
      "flexDirection": "column",
      "alignSelf": "flex-start",
      "background": "var(--jx-bg-overlay)",
      "border": "1px solid var(--jx-border)",
      "borderRadius": "var(--jx-radius-md)",
      "boxShadow": "var(--jx-shadow-dialog)",
      "color": "var(--jx-fg)",
      "fontFamily": "var(--jx-font-sans)",
      "overflow": "hidden"
    },
    "& [part=\"panel\"][data-anchored]": {
      "$description": "Opened from a control rather than from a chord: the panel hangs under that control instead of sitting under the top edge. The two custom properties are the only measured numbers in the surface — a rect belongs to the moment it was taken, so the adapter writes them and the rule that reads them stays here.",
      "position": "fixed",
      "left": "var(--formula-palette-left)",
      "top": "var(--formula-palette-top)",
      "margin": "0"
    },
    "& [part=\"input\"]": {
      "$description": "Borderless inside its own framed panel: the frame is the affordance and a second one around the field would only draw a box inside a box. The keyboard ring is given back explicitly, because the reader who arrives here by Tab has nothing else to go on.",
      "flex": "0 0 auto",
      "minWidth": "0",
      "padding": "var(--jx-space-4) var(--jx-space-5)",
      "font": "inherit",
      "fontSize": "var(--jx-text-lg)",
      "border": "none",
      "borderBottom": "1px solid var(--jx-border)",
      "outline": "none",
      "background": "var(--jx-bg-input)",
      "color": "var(--jx-fg)",
      "::placeholder": {
        "color": "var(--jx-fg-muted)"
      },
      ":focus-visible": {
        "outline": "var(--jx-focus-ring)",
        "outlineOffset": "-2px"
      }
    },
    "& [part=\"results\"]": {
      "overflowY": "auto",
      "flex": "1"
    },
    "& [part=\"empty-slot\"]": {
      "display": "contents"
    },
    "& [part=\"empty\"]": {
      "padding": "var(--jx-space-5)",
      "textAlign": "center",
      "color": "var(--jx-fg-muted)",
      "fontSize": "var(--jx-text-md)"
    },
    "& [part=\"section-label\"]": {
      "padding": "var(--jx-space-3) var(--jx-space-5) var(--jx-space-1)",
      "fontSize": "var(--jx-text-xs)",
      "textTransform": "uppercase",
      "letterSpacing": "0.5px",
      "color": "var(--jx-fg-muted)"
    },
    "& [part=\"item\"]": {
      "display": "flex",
      "alignItems": "center",
      "gap": "var(--jx-space-3)",
      "padding": "var(--jx-space-2) var(--jx-space-5)",
      "cursor": "pointer",
      "fontSize": "var(--jx-text-md)",
      "color": "var(--jx-fg-dim)",
      ":hover": {
        "background": "var(--jx-hover-bg)"
      }
    },
    "& [part=\"item\"][data-selected]": {
      "$description": "The highlight follows `selectedIndex`, not `:hover` — a pointer moving over the list writes that index, so the two can never disagree, and an arrow key moves the same mark the mouse does.",
      "background": "var(--jx-accent-solid)",
      "color": "var(--jx-accent-fg)"
    },
    "& [part=\"name\"]": {
      "$description": "Monospaced because these are identifiers the reader will type: `??`, `?:`, `Math.max`. The old rule asked for `--spectrum-code-font-family`, which resolved to nothing outside a Spectrum theme and left every entry in the UI face.",
      "fontFamily": "var(--jx-font-mono)",
      "fontWeight": "500",
      "whiteSpace": "nowrap"
    },
    "& [part=\"detail\"]": {
      "minWidth": "0",
      "opacity": "0.5",
      "fontSize": "var(--jx-text-sm)",
      "whiteSpace": "nowrap",
      "overflow": "hidden",
      "textOverflow": "ellipsis"
    },
    "& [part=\"badge\"]": {
      "marginLeft": "auto",
      "flexShrink": "0",
      "fontSize": "var(--jx-text-xs)",
      "padding": "1px var(--jx-space-2)",
      "borderRadius": "var(--jx-radius-sm)",
      "background": "var(--jx-border)",
      "color": "var(--jx-fg-dim)"
    },
    "& [part=\"item\"][data-selected] [part=\"badge\"]": {
      "background": "transparent",
      "border": "1px solid currentColor",
      "color": "inherit"
    }
  },
  "$switch": {
    "$ref": "#/state/open"
  },
  "cases": {
    "true": {
      "tagName": "div",
      "attributes": {
        "part": "overlay"
      },
      "onclick": {
        "$prototype": "Function",
        "body": [
          {
            "operator": "call",
            "target": {
              "$ref": "#/state/close"
            },
            "value": []
          }
        ]
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "part": "panel",
            "data-anchored": "${state.anchored ? '' : null}",
            "style": "${state.anchorVars}"
          },
          "onclick": {
            "$prototype": "Function",
            "body": [
              {
                "stopPropagation": true
              }
            ]
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "part": "input",
                "type": "text",
                "role": "combobox",
                "aria-controls": "formula-palette-listbox",
                "aria-expanded": "${state.expanded ? 'true' : 'false'}",
                "aria-activedescendant": "${state.expanded ? state.activeId : null}",
                "aria-autocomplete": "list",
                "aria-label": "Search formulas, operators and globals",
                "placeholder": "Search formulas, operators, globals…"
              },
              "value": {
                "$ref": "#/state/query"
              },
              "oninput": {
                "$prototype": "Function",
                "body": [
                  {
                    "operator": "call",
                    "target": {
                      "$ref": "#/state/input"
                    },
                    "value": [
                      {
                        "$ref": "event#/target/value"
                      }
                    ]
                  }
                ]
              },
              "onkeydown": {
                "$prototype": "Function",
                "body": [
                  {
                    "$switch": {
                      "$ref": "event#/key"
                    },
                    "cases": {
                      "ArrowDown": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/move"
                          },
                          "value": [1]
                        }
                      ],
                      "ArrowUp": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/move"
                          },
                          "value": [-1]
                        }
                      ],
                      "Enter": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/activate"
                          },
                          "value": []
                        }
                      ],
                      "Escape": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/close"
                          },
                          "value": []
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "tagName": "div",
              "attributes": {
                "part": "results",
                "role": "listbox",
                "id": "formula-palette-listbox",
                "aria-label": "Formulas"
              },
              "children": [
                {
                  "tagName": "div",
                  "attributes": {
                    "part": "empty-slot",
                    "role": "none"
                  },
                  "$switch": {
                    "$ref": "#/state/isEmpty"
                  },
                  "cases": {
                    "true": {
                      "tagName": "div",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "${state.emptyHint}"
                    }
                  }
                },
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/groups"
                  },
                  "key": {
                    "$ref": "$map/item/key"
                  },
                  "map": {
                    "tagName": "div",
                    "attributes": {
                      "part": "group",
                      "role": "group",
                      "aria-label": "${$map.item.label}"
                    },
                    "children": [
                      {
                        "tagName": "div",
                        "attributes": {
                          "part": "section-label",
                          "aria-hidden": "true"
                        },
                        "textContent": "${$map.item.label}"
                      },
                      {
                        "$prototype": "Array",
                        "items": {
                          "$ref": "$map/item/rows"
                        },
                        "key": {
                          "$ref": "$map/item/key"
                        },
                        "map": {
                          "tagName": "div",
                          "attributes": {
                            "part": "item",
                            "role": "option",
                            "id": "formula-palette-option-${$map.item.index}",
                            "aria-selected": "${$map.item.index === state.selectedIndex ? 'true' : 'false'}",
                            "data-selected": "${$map.item.index === state.selectedIndex ? '' : null}",
                            "data-kind": "${$map.item.kind}"
                          },
                          "onclick": {
                            "$prototype": "Function",
                            "body": [
                              {
                                "operator": "call",
                                "target": {
                                  "$ref": "#/state/activateRow"
                                },
                                "value": [
                                  {
                                    "$ref": "$map/item/index"
                                  }
                                ]
                              }
                            ]
                          },
                          "onmouseenter": {
                            "$prototype": "Function",
                            "body": [
                              {
                                "operator": "call",
                                "target": {
                                  "$ref": "#/state/hover"
                                },
                                "value": [
                                  {
                                    "$ref": "$map/item/index"
                                  }
                                ]
                              }
                            ]
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "part": "name"
                              },
                              "textContent": "${$map.item.label}"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "part": "detail",
                                "title": "${$map.item.description}"
                              },
                              "textContent": "${$map.item.description}"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "part": "badge"
                              },
                              "textContent": "${$map.item.kind}"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
