{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StudioWorkspaceHome",
  "$description": "A workspace's home: the tab a workspace opens on when none of its own tabs is open. It names the workspace and says what it is for, in the one empty-state voice (studio-ui-guidelines.md §11): a glyph, the workspace's title, one sentence of purpose and an optional second one. `workspace/workspace-home.ts` decides every word; nothing here asks a question. The Media and Publish workspaces are the two that open on this generic home, until each grows a surface of its own.",
  "tagName": "section",
  "attributes": {
    "part": "home",
    "aria-labelledby": "${state.headingId}",
    "data-jx-region": "${state.region}",
    "data-workspace": "${state.workspace}"
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "alignItems": "center",
    "justifyContent": "center",
    "gap": "var(--jx-space-3)",
    "$description": "Fills the pane's stage by its own geometry: the stage is `position: relative` (`pane-grid.json`), so the home takes the whole of it without the stage being restyled for it.",
    "position": "absolute",
    "inset": "0",
    "boxSizing": "border-box",
    "padding": "var(--jx-space-6)",
    "textAlign": "center",
    "fontFamily": "var(--jx-font-sans)",
    "color": "var(--fg-dim)",
    "background": "var(--bg)",
    "& [part=\"glyph\"]": {
      "--jx-icon-size": "40px",
      "color": "var(--fg-dim)"
    },
    "& [part=\"title\"]": {
      "margin": "0",
      "fontSize": "var(--jx-text-lg)",
      "fontWeight": "600",
      "color": "var(--fg)"
    },
    "& [part=\"purpose\"], & [part=\"detail\"]": {
      "margin": "0",
      "maxWidth": "42ch",
      "lineHeight": "1.5",
      "fontSize": "var(--jx-text-md)"
    },
    "& [part=\"detail\"]": {
      "fontSize": "var(--jx-text-sm)",
      "opacity": "0.8"
    }
  },
  "children": [
    {
      "tagName": "jx-icon",
      "attributes": {
        "part": "glyph",
        "aria-hidden": "true"
      },
      "$props": {
        "name": {
          "$ref": "#/state/icon"
        }
      }
    },
    {
      "tagName": "h2",
      "attributes": {
        "part": "title",
        "id": "${state.headingId}"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "attributes": {
        "part": "purpose"
      },
      "textContent": "${state.purpose}"
    },
    {
      "tagName": "div",
      "attributes": {
        "part": "detail-slot",
        "role": "none"
      },
      "style": {
        "display": "contents"
      },
      "$switch": {
        "$ref": "#/state/hasDetail"
      },
      "cases": {
        "true": {
          "tagName": "p",
          "attributes": {
            "part": "detail"
          },
          "textContent": "${state.detail}"
        }
      }
    }
  ]
}
