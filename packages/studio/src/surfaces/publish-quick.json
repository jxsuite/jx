{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StudioPublishQuick",
  "$description": "Quick publish (studio.md §22.8): the popover the chevron beside the Publish workspace tab opens, hanging from it. The count with Review all, a short list of what changed named as the site names it (NEW Pricing, EDIT Base template, affects 4 pages), the rest summed up by kind, the destination, the summary that becomes the commit message, the checks in one line, and Publish now, which takes every change to the destination. One `jx-popover` opened from the chevron, so the platform owns light dismissal, Escape and focus restoration. `publish/publish-quick.ts` keeps every decision, and the words of the changes, the destinations and the checks are the same ones Review changes draws, so the two cannot disagree about what a change is or what a button does.",
  "tagName": "jx-popover",
  "$props": {
    "label": "Publish",
    "placement": "block-end span-inline-start"
  },
  "attributes": {
    "part": "publish-quick",
    "data-destination": "${state.destination}"
  },
  "style": {
    "$description": "The panel is as wide as the board draws it, wider than a menu's default, so a change's name and what it touches sit on one line.",
    "width": "420px",
    "maxWidth": "calc(100vw - 16px)",
    "& [part=\"sheet\"]": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-3)",
      "width": "100%",
      "boxSizing": "border-box",
      "padding": "var(--jx-space-2)",
      "minWidth": "0"
    },
    "& [part=\"count\"]": {
      "margin": "0",
      "fontWeight": "600",
      "fontSize": "var(--jx-text-lg)"
    },
    "& [part=\"change-list\"]": {
      "margin": "0",
      "padding": "0",
      "listStyle": "none",
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-1)"
    },
    "& [part=\"change\"]": {
      "display": "flex",
      "alignItems": "baseline",
      "gap": "var(--jx-space-2)",
      "minWidth": "0"
    },
    "& [part=\"change-tag\"]": {
      "$description": "NEW, EDIT, DELETED, as the board draws them: a word rather than git's letter, because this dialog is read by someone who has never seen a status column.",
      "flex": "none",
      "minWidth": "52px",
      "fontSize": "var(--jx-text-xs)",
      "fontWeight": "700",
      "letterSpacing": "0.04em",
      "color": "var(--signal)"
    },
    "& [part=\"change-name\"]": {
      "minWidth": "0",
      "overflow": "hidden",
      "textOverflow": "ellipsis",
      "whiteSpace": "nowrap"
    },
    "& [part=\"more\"], & [part=\"blocker\"]": {
      "margin": "0"
    },
    "& [part=\"destinations\"]": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-2)"
    },
    "& [part=\"destination-card\"] > [part=\"control\"]": {
      "$description": "The same card Review changes draws for the same choice: a name and a sentence inside one radio.",
      "width": "100%",
      "height": "auto",
      "flexDirection": "column",
      "alignItems": "flex-start",
      "textAlign": "start",
      "padding": "var(--jx-space-2) var(--jx-space-3)",
      "gap": "2px",
      "whiteSpace": "normal"
    },
    "& [part=\"choice-name\"]": {
      "display": "block",
      "fontWeight": "600"
    },
    "& [part=\"choice-note\"]": {
      "display": "block"
    },
    "& [part=\"checks-line\"]": {
      "display": "flex",
      "alignItems": "center",
      "gap": "var(--jx-space-2)",
      "margin": "0",
      "fontSize": "var(--jx-text-sm)",
      "color": "var(--fg-dim)"
    },
    "& [part=\"checks-line\"][data-state=\"done\"] > [part=\"checks-icon\"]": {
      "color": "var(--success)"
    },
    "& [part=\"checks-line\"][data-state=\"open\"] > [part=\"checks-icon\"]": {
      "color": "var(--warning)"
    },
    "& [part=\"head\"]": {
      "display": "flex",
      "alignItems": "center",
      "gap": "var(--jx-space-2)"
    },
    "& [part=\"review-all\"]": {
      "marginLeft": "auto",
      "flex": "none"
    },
    "& [part=\"change-note\"]": {
      "marginLeft": "auto",
      "flex": "none",
      "fontSize": "var(--jx-text-xs)",
      "color": "var(--warning)"
    },
    "& [part=\"publish-now\"]": {
      "width": "100%"
    },
    "& [part=\"change\"][data-tag=\"new\"] > [part=\"change-tag\"]": {
      "color": "var(--success)"
    },
    "& [part=\"change\"][data-tag=\"delete\"] > [part=\"change-tag\"]": {
      "color": "var(--danger)"
    },
    "& [part=\"more\"], & [part=\"choice-note\"], & [part=\"blocker\"]": {
      "color": "var(--fg-dim)",
      "fontSize": "var(--jx-text-sm)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "attributes": {
        "part": "sheet"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "part": "head"
          },
          "children": [
            {
              "tagName": "strong",
              "attributes": {
                "part": "count"
              },
              "textContent": "${state.countLine}"
            },
            {
              "tagName": "jx-action-button",
              "attributes": {
                "part": "review-all"
              },
              "$props": {
                "size": "sm",
                "quiet": true,
                "hint": "Review each change in the Publish workspace first"
              },
              "onclick": {
                "$prototype": "Function",
                "body": [
                  {
                    "operator": "call",
                    "target": {
                      "$ref": "#/state/reviewAll"
                    },
                    "value": []
                  }
                ]
              },
              "children": [
                {
                  "tagName": "span",
                  "textContent": "Review all"
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "list-slot",
            "role": "none"
          },
          "style": {
            "display": "contents"
          },
          "$switch": {
            "$ref": "#/state/listState"
          },
          "cases": {
            "listed": {
              "tagName": "ul",
              "attributes": {
                "part": "change-list"
              },
              "children": [
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/rows"
                  },
                  "key": {
                    "$ref": "$map/item/key"
                  },
                  "map": {
                    "tagName": "li",
                    "attributes": {
                      "part": "change",
                      "data-tag": "${$map.item.tagKind}",
                      "title": "${$map.item.path}"
                    },
                    "children": [
                      {
                        "tagName": "span",
                        "attributes": {
                          "part": "change-tag"
                        },
                        "textContent": "${$map.item.tag}"
                      },
                      {
                        "tagName": "span",
                        "attributes": {
                          "part": "change-name"
                        },
                        "textContent": "${$map.item.label}"
                      },
                      {
                        "tagName": "span",
                        "attributes": {
                          "part": "change-note"
                        },
                        "textContent": "${$map.item.note}"
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "more-slot",
            "role": "none"
          },
          "style": {
            "display": "contents"
          },
          "$switch": {
            "$ref": "#/state/hasMore"
          },
          "cases": {
            "true": {
              "tagName": "p",
              "attributes": {
                "part": "more"
              },
              "textContent": "${state.more}"
            }
          }
        },
        {
          "tagName": "jx-action-group",
          "attributes": {
            "part": "destinations"
          },
          "$props": {
            "selects": "single",
            "label": "Destination",
            "compact": false,
            "orientation": "vertical"
          },
          "children": [
            {
              "$prototype": "Array",
              "items": {
                "$ref": "#/state/destinations"
              },
              "key": {
                "$ref": "$map/item/value"
              },
              "map": {
                "tagName": "jx-action-button",
                "attributes": {
                  "part": "destination-card",
                  "data-destination": "${$map.item.value}"
                },
                "$props": {
                  "label": {
                    "$ref": "$map/item/label"
                  },
                  "checked": {
                    "$ref": "$map/item/checked"
                  },
                  "disabled": {
                    "$ref": "$map/item/disabled"
                  },
                  "hint": {
                    "$ref": "$map/item/reason"
                  },
                  "quiet": false
                },
                "onclick": {
                  "$prototype": "Function",
                  "body": [
                    {
                      "operator": "call",
                      "target": {
                        "$ref": "#/state/pickDestination"
                      },
                      "value": [
                        {
                          "$ref": "$map/item/value"
                        }
                      ]
                    }
                  ]
                },
                "children": [
                  {
                    "tagName": "span",
                    "attributes": {
                      "part": "choice-name"
                    },
                    "textContent": "${$map.item.label}"
                  },
                  {
                    "tagName": "span",
                    "attributes": {
                      "part": "choice-note"
                    },
                    "textContent": "${$map.item.note}"
                  }
                ]
              }
            }
          ]
        },
        {
          "tagName": "jx-field",
          "attributes": {
            "part": "summary-field"
          },
          "$props": {
            "label": "Summary",
            "span": true
          },
          "children": [
            {
              "tagName": "jx-textfield",
              "attributes": {
                "part": "summary"
              },
              "$props": {
                "size": "sm",
                "placeholder": "Describe what changed",
                "value": {
                  "$ref": "#/state/summary"
                }
              },
              "oninput": {
                "$prototype": "Function",
                "body": [
                  {
                    "operator": "call",
                    "target": {
                      "$ref": "#/state/editSummary"
                    },
                    "value": [
                      {
                        "$ref": "event#/target/value"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "tagName": "p",
          "attributes": {
            "part": "checks-line",
            "data-state": "${state.checksState}"
          },
          "children": [
            {
              "tagName": "jx-icon",
              "attributes": {
                "part": "checks-icon"
              },
              "$props": {
                "name": {
                  "$ref": "#/state/checksIcon"
                }
              }
            },
            {
              "tagName": "span",
              "attributes": {
                "part": "checks-text"
              },
              "textContent": "${state.checksLine}"
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "blocker-slot",
            "role": "none"
          },
          "style": {
            "display": "contents"
          },
          "$switch": {
            "$ref": "#/state/hasBlocker"
          },
          "cases": {
            "true": {
              "tagName": "p",
              "attributes": {
                "part": "blocker"
              },
              "textContent": "${state.blocker}"
            }
          }
        },
        {
          "$description": "Publish now: every change, to the chosen destination. A button of its own rather than a dialog's confirm, because the panel is a popover and the verb is the thing it is for.",
          "tagName": "jx-button",
          "attributes": {
            "part": "publish-now"
          },
          "$props": {
            "variant": "accent",
            "disabled": {
              "$ref": "#/state/blocked"
            }
          },
          "onclick": {
            "$prototype": "Function",
            "body": [
              {
                "operator": "call",
                "target": {
                  "$ref": "#/state/confirm"
                },
                "value": []
              }
            ]
          },
          "children": [
            {
              "tagName": "span",
              "textContent": "Publish now"
            }
          ]
        }
      ]
    }
  ]
}
