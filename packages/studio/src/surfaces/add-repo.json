{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StudioAddRepo",
  "$description": "The repository picker: every repository the platform's account link can reach, narrowed by name and account, and — once one is chosen — the folders it holds a project.json in, so a project that lives in a subfolder opens as itself. Two flows share it — Add existing repository, and Open Project on a platform whose projects ARE repositories — so the headline and the primary answer are state rather than text. A `jx-dialog`, so the platform owns modality, Escape, focus restoration and the backdrop. Choosing is two steps now, a repository and then its folder, so the dialog has a confirming button again; a double-click on a row still opens it in one gesture when the folder is unambiguous. Nothing here knows what `not_jx_project` means, which permission counts as write, which folder to preselect or that a Jx-tagged repository sorts first — `new-project/add-repo-modal.ts` keeps the listing, the ordering, the scan and the adoption, and hands over rows that are already strings and booleans.",
  "tagName": "jx-dialog",
  "$props": {
    "headline": {
      "$ref": "#/state/title"
    },
    "confirmLabel": {
      "$ref": "#/state/confirmLabel"
    },
    "confirmDisabled": {
      "$ref": "#/state/confirmDisabled"
    },
    "cancelLabel": "Cancel",
    "size": "xl"
  },
  "attributes": {
    "part": "add-repo"
  },
  "onconfirm": {
    "$prototype": "Function",
    "body": [
      {
        "operator": "call",
        "target": {
          "$ref": "#/state/confirm"
        },
        "value": []
      }
    ]
  },
  "oncancel": {
    "$prototype": "Function",
    "body": [
      {
        "operator": "call",
        "target": {
          "$ref": "#/state/closed"
        },
        "value": []
      }
    ]
  },
  "onclose": {
    "$prototype": "Function",
    "body": [
      {
        "operator": "call",
        "target": {
          "$ref": "#/state/closed"
        },
        "value": []
      }
    ]
  },
  "style": {
    "$description": "The dialog is wide enough for two panes — the repositories on the left, the chosen repository's projects on the right — and the PANES scroll, never the dialog: `jx-dialog` pins its header and footer and scrolls its body, and this surface turns the body into a column the picker fills, so the filter above the lists, the summary under them and the access footer at the bottom all stay on screen however long a list is. That is what retired the two scrollbars the old picker drew side by side, its own 320px list inside a dialog that also scrolled. Below 40rem the panes stack.",
    "& > [part=\"dialog\"] > [part=\"body\"]": {
      "$description": "The kit's body scrolls by default; here the picker is the body's only child and does its own scrolling inside two panes, so the body becomes the column it fills.",
      "display": "flex",
      "flexDirection": "column",
      "overflow": "hidden"
    },
    "& [part=\"picker\"]": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-3)",
      "flex": "0 1 30rem",
      "minHeight": "0",
      "containerType": "inline-size",
      "containerName": "add-repo"
    },
    "& [part=\"toolbar\"]": {
      "display": "flex",
      "alignItems": "center",
      "gap": "var(--jx-space-2)",
      "flex": "none"
    },
    "& [part=\"filter\"]": {
      "flex": "1 1 auto",
      "minWidth": "0"
    },
    "& [part=\"owner\"]": {
      "flex": "0 0 12rem"
    },
    "& [part=\"owner-slot\"], & [part=\"list-slot\"], & [part=\"detail-slot\"], & [part=\"locations-slot\"], & [part=\"failure-slot\"], & [part=\"access-slot\"], & [part=\"tag-slot\"], & [part=\"private-slot\"]": {
      "display": "contents"
    },
    "& [part=\"panes\"]": {
      "display": "grid",
      "gridTemplateColumns": "minmax(0, 1fr) minmax(0, 1fr)",
      "gap": "var(--jx-space-3)",
      "flex": "1 1 auto",
      "minHeight": "0"
    },
    "& [part=\"repos\"], & [part=\"detail\"]": {
      "$description": "Each pane is a framed box of its own height that scrolls its own content, so choosing a repository far down the list never scrolls its projects out of view.",
      "display": "flex",
      "flexDirection": "column",
      "minHeight": "0",
      "border": "1px solid var(--border)",
      "borderRadius": "var(--radius)",
      "overflow": "hidden"
    },
    "& [part=\"repo-list\"]": {
      "flex": "1 1 auto",
      "minHeight": "0",
      "overflowY": "auto",
      "padding": "var(--jx-space-1)"
    },
    "& [part=\"location-list\"]": {
      "margin": "0 calc(-1 * var(--jx-space-2))"
    },
    "& [part=\"detail-body\"]": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-3)",
      "flex": "1 1 auto",
      "minHeight": "0",
      "overflowY": "auto",
      "padding": "var(--jx-space-3)"
    },
    "& [part=\"detail-head\"]": {
      "display": "flex",
      "flexDirection": "column",
      "gap": "var(--jx-space-1)",
      "flex": "none",
      "minWidth": "0"
    },
    "& [part=\"detail-name\"]": {
      "fontWeight": "600",
      "overflow": "hidden",
      "textOverflow": "ellipsis",
      "whiteSpace": "nowrap"
    },
    "& [part=\"detail-meta\"]": {
      "fontSize": "var(--jx-text-sm)",
      "color": "var(--fg-dim)"
    },
    "& [part=\"folder-row\"]": {
      "flex": "none"
    },
    "& [part=\"repo\"] [part=\"description\"], & [part=\"location\"] [part=\"description\"]": {
      "$description": "The note gives way before the name does: a repository is found by its name, and a branch or a path cut short is still recognisable where a name cut short is not.",
      "flexShrink": "4"
    },
    "& [part=\"badges\"]": {
      "display": "inline-flex",
      "gap": "var(--jx-space-1)"
    },
    "& [part=\"badge\"]": {
      "padding": "0 var(--jx-space-2)",
      "border": "1px solid currentColor",
      "borderRadius": "var(--jx-radius-lg)",
      "fontSize": "var(--jx-text-xs)",
      "opacity": "0.8"
    },
    "& [part=\"empty\"], & [part=\"note\"]": {
      "margin": "0",
      "padding": "var(--jx-space-4) var(--jx-space-3)",
      "fontSize": "var(--jx-text-md)",
      "color": "var(--fg-dim)"
    },
    "& [part=\"note\"]": {
      "padding": "0"
    },
    "& [part=\"summary\"]": {
      "$description": "What confirming will do, in words: which repository, which folder, which branch. Polite and live, because the arrows in both fields change it without moving focus, and this is how a reader who cannot see the panes hears where they are.",
      "margin": "0",
      "flex": "none",
      "minHeight": "var(--jx-leading-md)",
      "fontSize": "var(--jx-text-sm)",
      "color": "var(--fg-dim)"
    },
    "& [part=\"install\"], & [part=\"access-link\"]": {
      "color": "var(--accent)",
      "textDecoration": "underline"
    },
    "& [part=\"failure\"]": {
      "$description": "The refusal from the last adoption, said above the footer the reader is still looking at, because the panes survive it: a folder with no readable project.json is a fact about that folder, and the rest are still on offer. It is `failure` rather than `error` because `jx-textfield` draws a `[part=\"error\"]` of its own inside this same tree.",
      "margin": "0",
      "flex": "none",
      "fontSize": "var(--jx-text-md)",
      "color": "var(--danger)"
    },
    "& [part=\"access\"]": {
      "$description": "The listing is bounded by what the Jx Suite GitHub App was granted, so the dialog always offers a way out of that boundary rather than only saying the list is short. `center`, not `baseline`: a small kit button exports no baseline (surface-baseline-rows.test.ts).",
      "display": "flex",
      "flexWrap": "wrap",
      "alignItems": "center",
      "gap": "var(--jx-space-2)",
      "flex": "none",
      "paddingTop": "var(--jx-space-3)",
      "borderTop": "1px solid var(--border)",
      "fontSize": "var(--jx-text-sm)",
      "color": "var(--fg-dim)"
    },
    "& [part=\"access-note\"]": {
      "flex": "1 1 auto"
    },
    "& [part=\"access-links\"]": {
      "display": "flex",
      "flexWrap": "wrap",
      "gap": "var(--jx-space-3)"
    },
    "@container add-repo (max-width: 40rem)": {
      "& [part=\"panes\"]": {
        "gridTemplateColumns": "minmax(0, 1fr)",
        "gridTemplateRows": "minmax(0, 1fr) minmax(0, 1fr)"
      },
      "& [part=\"owner\"]": {
        "flexBasis": "9rem"
      }
    }
  },
  "children": [
    {
      "tagName": "div",
      "attributes": {
        "part": "picker"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "part": "toolbar"
          },
          "children": [
            {
              "tagName": "jx-textfield",
              "attributes": {
                "part": "filter"
              },
              "$props": {
                "label": "Filter repositories",
                "placeholder": "Filter repositories…",
                "type": "search",
                "size": "sm",
                "value": {
                  "$ref": "#/state/filter"
                }
              },
              "oninput": {
                "$prototype": "Function",
                "body": [
                  {
                    "operator": "call",
                    "target": {
                      "$ref": "#/state/setFilter"
                    },
                    "value": [
                      {
                        "$ref": "event#/target/value"
                      }
                    ]
                  }
                ]
              },
              "onkeydown": {
                "$prototype": "Function",
                "body": [
                  {
                    "$switch": {
                      "$ref": "event#/key"
                    },
                    "cases": {
                      "ArrowDown": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/move"
                          },
                          "value": [1]
                        }
                      ],
                      "ArrowUp": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/move"
                          },
                          "value": [-1]
                        }
                      ],
                      "Enter": [
                        {
                          "preventDefault": true
                        },
                        {
                          "operator": "call",
                          "target": {
                            "$ref": "#/state/confirm"
                          },
                          "value": []
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "tagName": "div",
              "attributes": {
                "part": "owner-slot",
                "role": "none"
              },
              "style": {
                "display": "contents"
              },
              "$switch": {
                "$ref": "#/state/hasOwners"
              },
              "cases": {
                "true": {
                  "tagName": "jx-select",
                  "attributes": {
                    "part": "owner"
                  },
                  "$props": {
                    "label": "Account",
                    "size": "sm",
                    "options": {
                      "$ref": "#/state/owners"
                    },
                    "value": {
                      "$ref": "#/state/owner"
                    }
                  },
                  "onchange": {
                    "$prototype": "Function",
                    "body": [
                      {
                        "operator": "call",
                        "target": {
                          "$ref": "#/state/setOwner"
                        },
                        "value": [
                          {
                            "$ref": "event#/target/value"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "panes"
          },
          "children": [
            {
              "tagName": "section",
              "attributes": {
                "part": "repos",
                "aria-label": "Repositories"
              },
              "children": [
                {
                  "tagName": "div",
                  "attributes": {
                    "part": "list-slot",
                    "role": "none"
                  },
                  "style": {
                    "display": "contents"
                  },
                  "$switch": {
                    "$ref": "#/state/listState"
                  },
                  "cases": {
                    "loading": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "Loading repositories…"
                    },
                    "empty-filter": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "No repositories match the filter."
                    },
                    "empty-write": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "Repositories you can write to are listed here. Widen the Jx Suite GitHub App's repository access below, or ask a repository admin for write access."
                    },
                    "empty-install": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "children": [
                        {
                          "tagName": "span",
                          "textContent": "Repositories the Jx Suite GitHub App can reach are listed here. "
                        },
                        {
                          "tagName": "a",
                          "attributes": {
                            "part": "install",
                            "href": "${state.installUrl}",
                            "target": "_blank",
                            "rel": "noreferrer"
                          },
                          "textContent": "Install the Jx Suite GitHub App"
                        },
                        {
                          "tagName": "span",
                          "textContent": " to grant repository access, then use Refresh below."
                        }
                      ]
                    },
                    "empty-none": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "Repositories the Jx Suite GitHub App can reach are listed here. Install the App, or widen its repository access, and try again."
                    },
                    "listed": {
                      "tagName": "jx-listbox",
                      "attributes": {
                        "part": "repo-list",
                        "id": "add-repo-repos"
                      },
                      "$props": {
                        "label": "Repositories",
                        "active": "${state.activeRepoId}"
                      },
                      "onselect": {
                        "$prototype": "Function",
                        "body": [
                          {
                            "operator": "call",
                            "target": {
                              "$ref": "#/state/select"
                            },
                            "value": [
                              {
                                "$ref": "event#/detail"
                              }
                            ]
                          }
                        ],
                        "description": "One handler for every row, because a row's `select` bubbles; its detail is the row's value, the repository's full name."
                      },
                      "children": [
                        {
                          "$prototype": "Array",
                          "items": {
                            "$ref": "#/state/rows"
                          },
                          "key": {
                            "$ref": "$map/item/fullName"
                          },
                          "map": {
                            "tagName": "jx-option",
                            "attributes": {
                              "part": "repo",
                              "id": "${$map.item.id}",
                              "data-repo": "${$map.item.fullName}",
                              "title": "${$map.item.fullName}"
                            },
                            "$props": {
                              "value": {
                                "$ref": "$map/item/fullName"
                              },
                              "label": {
                                "$ref": "$map/item/fullName"
                              },
                              "description": {
                                "$ref": "$map/item/meta"
                              }
                            },
                            "ondblclick": {
                              "$prototype": "Function",
                              "body": [
                                {
                                  "operator": "call",
                                  "target": {
                                    "$ref": "#/state/openRepo"
                                  },
                                  "value": [
                                    {
                                      "$ref": "$map/item/fullName"
                                    }
                                  ]
                                }
                              ]
                            },
                            "children": [
                              {
                                "tagName": "span",
                                "attributes": {
                                  "part": "badges",
                                  "slot": "end"
                                },
                                "children": [
                                  {
                                    "tagName": "span",
                                    "attributes": {
                                      "part": "tag-slot",
                                      "role": "none"
                                    },
                                    "style": {
                                      "display": "contents"
                                    },
                                    "$switch": {
                                      "$ref": "$map/item/isJx"
                                    },
                                    "cases": {
                                      "true": {
                                        "tagName": "span",
                                        "attributes": {
                                          "part": "badge"
                                        },
                                        "textContent": "Jx"
                                      }
                                    }
                                  },
                                  {
                                    "tagName": "span",
                                    "attributes": {
                                      "part": "private-slot",
                                      "role": "none"
                                    },
                                    "style": {
                                      "display": "contents"
                                    },
                                    "$switch": {
                                      "$ref": "$map/item/isPrivate"
                                    },
                                    "cases": {
                                      "true": {
                                        "tagName": "span",
                                        "attributes": {
                                          "part": "badge"
                                        },
                                        "textContent": "private"
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "tagName": "section",
              "attributes": {
                "part": "detail",
                "aria-label": "Project"
              },
              "children": [
                {
                  "tagName": "div",
                  "attributes": {
                    "part": "detail-slot",
                    "role": "none"
                  },
                  "style": {
                    "display": "contents"
                  },
                  "$switch": {
                    "$ref": "#/state/hasDetail"
                  },
                  "cases": {
                    "false": {
                      "tagName": "p",
                      "attributes": {
                        "part": "empty"
                      },
                      "textContent": "Choose a repository to see the Jx projects it holds and pick the one to open."
                    },
                    "true": {
                      "tagName": "div",
                      "attributes": {
                        "part": "detail-body"
                      },
                      "children": [
                        {
                          "tagName": "div",
                          "attributes": {
                            "part": "detail-head"
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "part": "detail-name"
                              },
                              "textContent": "${state.detailName}"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "part": "detail-meta"
                              },
                              "textContent": "${state.detailMeta}"
                            }
                          ]
                        },
                        {
                          "tagName": "jx-field",
                          "attributes": {
                            "part": "folder-row"
                          },
                          "$props": {
                            "span": true,
                            "label": "Project Folder",
                            "description": {
                              "$ref": "#/state/folderHelp"
                            },
                            "invalid": {
                              "$ref": "#/state/folderInvalid"
                            }
                          },
                          "children": [
                            {
                              "tagName": "jx-textfield",
                              "attributes": {
                                "part": "folder"
                              },
                              "$props": {
                                "placeholder": "Repository root",
                                "size": "sm",
                                "mono": true,
                                "value": {
                                  "$ref": "#/state/folder"
                                },
                                "invalid": {
                                  "$ref": "#/state/folderInvalid"
                                },
                                "error": {
                                  "$ref": "#/state/folderError"
                                }
                              },
                              "oninput": {
                                "$prototype": "Function",
                                "body": [
                                  {
                                    "operator": "call",
                                    "target": {
                                      "$ref": "#/state/setFolder"
                                    },
                                    "value": [
                                      {
                                        "$ref": "event#/target/value"
                                      }
                                    ]
                                  }
                                ]
                              },
                              "onkeydown": {
                                "$prototype": "Function",
                                "body": [
                                  {
                                    "$switch": {
                                      "$ref": "event#/key"
                                    },
                                    "cases": {
                                      "ArrowDown": [
                                        {
                                          "preventDefault": true
                                        },
                                        {
                                          "operator": "call",
                                          "target": {
                                            "$ref": "#/state/moveLocation"
                                          },
                                          "value": [1]
                                        }
                                      ],
                                      "ArrowUp": [
                                        {
                                          "preventDefault": true
                                        },
                                        {
                                          "operator": "call",
                                          "target": {
                                            "$ref": "#/state/moveLocation"
                                          },
                                          "value": [-1]
                                        }
                                      ],
                                      "Enter": [
                                        {
                                          "preventDefault": true
                                        },
                                        {
                                          "operator": "call",
                                          "target": {
                                            "$ref": "#/state/confirm"
                                          },
                                          "value": []
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "tagName": "div",
                          "attributes": {
                            "part": "locations-slot",
                            "role": "none"
                          },
                          "style": {
                            "display": "contents"
                          },
                          "$switch": {
                            "$ref": "#/state/detailState"
                          },
                          "cases": {
                            "loading": {
                              "tagName": "p",
                              "attributes": {
                                "part": "note"
                              },
                              "textContent": "Looking for project.json files…"
                            },
                            "listed": {
                              "tagName": "jx-listbox",
                              "attributes": {
                                "part": "location-list",
                                "id": "add-repo-locations"
                              },
                              "$props": {
                                "label": "Projects in this repository",
                                "active": "${state.activeLocationId}"
                              },
                              "onselect": {
                                "$prototype": "Function",
                                "body": [
                                  {
                                    "operator": "call",
                                    "target": {
                                      "$ref": "#/state/pickLocation"
                                    },
                                    "value": [
                                      {
                                        "$ref": "event#/detail"
                                      }
                                    ]
                                  }
                                ]
                              },
                              "children": [
                                {
                                  "$prototype": "Array",
                                  "items": {
                                    "$ref": "#/state/locations"
                                  },
                                  "key": {
                                    "$ref": "$map/item/dir"
                                  },
                                  "map": {
                                    "tagName": "jx-option",
                                    "attributes": {
                                      "part": "location",
                                      "id": "${$map.item.id}",
                                      "data-dir": "${$map.item.dir}",
                                      "title": "${$map.item.path}"
                                    },
                                    "$props": {
                                      "value": {
                                        "$ref": "$map/item/dir"
                                      },
                                      "label": {
                                        "$ref": "$map/item/label"
                                      },
                                      "description": {
                                        "$ref": "$map/item/path"
                                      }
                                    },
                                    "ondblclick": {
                                      "$prototype": "Function",
                                      "body": [
                                        {
                                          "operator": "call",
                                          "target": {
                                            "$ref": "#/state/confirm"
                                          },
                                          "value": []
                                        }
                                      ]
                                    },
                                    "children": [
                                      {
                                        "tagName": "jx-icon",
                                        "attributes": {
                                          "slot": "icon"
                                        },
                                        "$props": {
                                          "name": "folder"
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            },
                            "empty": {
                              "tagName": "p",
                              "attributes": {
                                "part": "note"
                              },
                              "textContent": "No folder in this repository holds a project.json yet. Name one above if it does, or create a new project instead."
                            },
                            "unlisted": {
                              "tagName": "p",
                              "attributes": {
                                "part": "note"
                              },
                              "textContent": "Name the folder that holds the project's project.json, or leave the field empty to open the repository root."
                            },
                            "failed": {
                              "tagName": "p",
                              "attributes": {
                                "part": "note"
                              },
                              "textContent": "Studio couldn't list this repository's projects. Name the folder that holds the project.json instead."
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "p",
          "attributes": {
            "part": "summary",
            "aria-live": "polite"
          },
          "textContent": "${state.summary}"
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "failure-slot",
            "role": "none"
          },
          "style": {
            "display": "contents"
          },
          "$switch": {
            "$ref": "#/state/hasFailure"
          },
          "cases": {
            "true": {
              "tagName": "p",
              "attributes": {
                "part": "failure"
              },
              "textContent": "${state.failure}"
            }
          }
        },
        {
          "tagName": "div",
          "attributes": {
            "part": "access-slot",
            "role": "none"
          },
          "style": {
            "display": "contents"
          },
          "$switch": {
            "$ref": "#/state/hasAccess"
          },
          "cases": {
            "true": {
              "tagName": "div",
              "attributes": {
                "part": "access"
              },
              "children": [
                {
                  "tagName": "span",
                  "attributes": {
                    "part": "access-note"
                  },
                  "textContent": "Missing a repository? Grant the Jx Suite GitHub App access to more of them:"
                },
                {
                  "tagName": "span",
                  "attributes": {
                    "part": "access-links"
                  },
                  "children": [
                    {
                      "$prototype": "Array",
                      "items": {
                        "$ref": "#/state/access"
                      },
                      "key": {
                        "$ref": "$map/item/url"
                      },
                      "map": {
                        "tagName": "a",
                        "attributes": {
                          "part": "access-link",
                          "href": "${$map.item.url}",
                          "target": "_blank",
                          "rel": "noreferrer",
                          "title": "${$map.item.title}"
                        },
                        "textContent": "${$map.item.label}"
                      }
                    }
                  ]
                },
                {
                  "tagName": "jx-button",
                  "attributes": {
                    "part": "refresh"
                  },
                  "$props": {
                    "size": "sm",
                    "disabled": {
                      "$ref": "#/state/refreshDisabled"
                    }
                  },
                  "onclick": {
                    "$prototype": "Function",
                    "body": [
                      {
                        "operator": "call",
                        "target": {
                          "$ref": "#/state/refresh"
                        },
                        "value": []
                      }
                    ]
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "textContent": "Refresh"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
