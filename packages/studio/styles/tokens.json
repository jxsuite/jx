{
  "$schema": "https://jxsuite.com/schema/v1",
  "$id": "StudioTokens",
  "$description": "Studio's global base and its semantic token layer, as a Jx style block. `styles/tokens.css` is GENERATED from this by `scripts/build-tokens.ts`; edit this file and run `bun run tokens:sync`. It stays a linked stylesheet because every declaration in it is pre-paint: the kit's own theme is adopted from JavaScript, so these hex fallbacks are what paints the shell before that lands.",
  "tagName": "html",
  "style": {
    "box-sizing": "border-box",
    "margin": "0",
    "height": "100%",
    "overflow": "hidden",
    "background": "var(--jx-bg, #111114)",
    "--panel-w-left": "240px",
    "--panel-w-right": "280px",
    "--bg": "var(--jx-bg, #111114)",
    "--bg-panel": "var(--jx-bg-panel, #17171b)",
    "--bg-input": "var(--jx-bg-input, #1d1d22)",
    "--border": "var(--jx-border, #2f2f36)",
    "--fg": "var(--jx-fg, #eeeef2)",
    "--fg-dim": "var(--jx-fg-dim, #a2a2af)",
    "--accent": "var(--jx-accent, #3b82f6)",
    "--accent-fg": "var(--jx-accent-fg, #ffffff)",
    "--danger": "var(--jx-danger, #e86460)",
    "--success": "var(--jx-success, #4fb27a)",
    "--tag": "var(--jx-tag, #8fb5fb)",
    "--signal": "var(--jx-signal, #f2cc7c)",
    "--handler": "var(--jx-handler, #c8a2e0)",
    "--warning": "var(--jx-warning, #e5ae4a)",
    "--map": "var(--jx-map, #8b83e6)",
    "--switch-c": "var(--danger)",
    "--radius": "var(--jx-radius-sm, 4px)",
    "--font-mono": "var(--jx-font-mono, \"JetBrains Mono\", \"SF Mono\", \"Fira Code\", monospace)",
    "--hover-bg": "var(--jx-hover-bg, color-mix(in oklab, var(--fg) 6%, transparent))",
    "--accent-8": "var(--jx-accent-8, color-mix(in oklab, var(--accent) 8%, transparent))",
    "--accent-10": "var(--jx-accent-10, color-mix(in oklab, var(--accent) 10%, transparent))",
    "--accent-15": "var(--jx-accent-15, color-mix(in oklab, var(--accent) 15%, transparent))",
    "--accent-20": "var(--jx-accent-20, color-mix(in oklab, var(--accent) 20%, transparent))",
    "--accent-50": "var(--jx-accent-50, color-mix(in oklab, var(--accent) 50%, transparent))",
    "@font-face": [
      {
        "font-family": "\"JetBrains Mono\"",
        "font-style": "normal",
        "font-weight": "400",
        "font-display": "swap",
        "src": "url(\"../fonts/jetbrains-mono-400.woff2\") format(\"woff2\")"
      },
      {
        "font-family": "\"JetBrains Mono\"",
        "font-style": "normal",
        "font-weight": "500",
        "font-display": "swap",
        "src": "url(\"../fonts/jetbrains-mono-500.woff2\") format(\"woff2\")"
      },
      {
        "font-family": "\"JetBrains Mono\"",
        "font-style": "normal",
        "font-weight": "700",
        "font-display": "swap",
        "src": "url(\"../fonts/jetbrains-mono-700.woff2\") format(\"woff2\")"
      }
    ],
    "*, *::before, *::after": {
      "box-sizing": "border-box",
      "margin": "0"
    },
    "& body": {
      "height": "100%",
      "overflow": "hidden",
      "background": "var(--jx-bg, #111114)"
    },
    "&[data-theme=\"light\"], &[data-theme=\"light\"] body": {
      "background": "var(--jx-bg, #f7f7f9)"
    }
  }
}
